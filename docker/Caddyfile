# Caddy serves the built site and, when given a real domain, obtains and renews
# its own TLS certificate. There is no certbot step and no cron job.
#
# SITE_ADDRESS controls the mode:
#   unset            -> listens on :80, plain HTTP  (local testing)
#   example.com      -> automatic HTTPS via Let's Encrypt  (production)

{
	# The admin API is not needed and should not be listening.
	admin off
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS::80} {
	root * /srv

	encode zstd gzip

	# Astro is configured with build.format: 'file', so /projects/foo lives on
	# disk as /projects/foo.html. This makes the extensionless URL resolve, and
	# mirrors the try_files rule in deploy/nginx.conf.
	try_files {path} {path}.html {path}/index.html

	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Caddy adds its own Server header; drop it.
		-Server
	}

	# --- Caching ----------------------------------------------------------
	# The three matchers below are deliberately non-overlapping, so no rule has
	# to override another and the order here does not matter.

	# Astro fingerprints these filenames, so they can never go stale.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	# Your GeoJSON and images keep stable names — cache them, but not forever,
	# or you will not see your own corrections.
	@media path /data/* /images/*
	header @media Cache-Control "public, max-age=604800"

	# Pages. This short lifetime is what makes the link prefetching pay off:
	# without it the browser still spends a round trip revalidating a page it
	# has already fetched, and the click is merely fast rather than instant.
	# Five minutes is longer than a visitor's session and shorter than you will
	# notice when publishing — a deploy changes the hashed asset names anyway,
	# so a briefly stale page still references assets that exist.
	@pages not path /_astro/* /data/* /images/*
	header @pages Cache-Control "public, max-age=300"

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
