# Line endings are decided here rather than by each machine's core.autocrlf,
# so a clone on the Linux VPS gets what Linux needs no matter who cloned it or
# how their Git happens to be configured.

# Normalise text files to LF inside the repository.
* text=auto

# These run on Linux and must be LF. A shell script committed with CRLF fails
# on the server with "bad interpreter: /bin/bash^M" — an unusually confusing
# way to lose an afternoon.
*.sh       text eol=lf
Dockerfile text eol=lf
Caddyfile  text eol=lf
*.conf     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# These run on Windows. cmd.exe is happiest with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never convert these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.pdf  binary
