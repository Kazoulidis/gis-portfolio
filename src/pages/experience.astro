---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
import { roles, conferences } from '../cv';
---

<BaseLayout
  title="Experience"
  description={`Work experience of ${site.name}, ${site.role}.`}
>
  <h1>Experience</h1>
  <p class="muted">A summary of my professional roles. The full CV is available as a PDF.</p>

  {
    site.cv && (
      <p>
        <a class="button button--ghost" href={site.cv} data-umami-event="cv-download" data-umami-event-from="experience">
          Download CV (PDF)
        </a>
      </p>
    )
  }

  <hr />

  <div>
    {
      roles.map((role) => (
        <article class="entry">
          <div class="entry__date">{role.date}</div>
          <div class="entry__body">
            <h2 class="entry__title">{role.title}</h2>
            <p class="entry__org">{role.org}</p>
            <ul>
              {role.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>

  <h2 class="section">Conferences &amp; presentations</h2>
  {
    conferences.map((talk) => (
      <article class="entry">
        <div class="entry__date">{talk.date}</div>
        <div class="entry__body">
          <h3 class="entry__title">{talk.org}</h3>
          <p class="entry__org">{talk.title}</p>
          <p>{talk.body}</p>
        </div>
      </article>
    ))
  }
</BaseLayout>

<style>
  .entry__title {
    margin-top: 0;
  }

  .section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
</style>
