---
/**
 * Every year of a by-year category: /projects/30-day-map-challenge/2025, /2026.
 * The newest year also shows on the category's own page ([category].astro),
 * but it gets its year page too, so a link to this year's challenge keeps
 * working once next year's takes over the category page.
 */
import { getCollection } from 'astro:content';
import CategoryPage from '../../../components/CategoryPage.astro';
import { projectCategories } from '../../../site';
import { isListed, projectYear, sortForCategory, yearsOf } from '../../../projects';

export async function getStaticPaths() {
  const all = await getCollection('projects', isListed);
  return projectCategories
    .filter((category) => category.byYear)
    .flatMap((category) => {
      const inCategory = all.filter((project) => project.data.category === category.slug);
      const years = yearsOf(inCategory);
      return years.map((year) => ({
        params: { category: category.slug, year: String(year) },
        props: {
          category,
          projects: sortForCategory(inCategory.filter((p) => projectYear(p) === year), category),
          years,
          year,
        },
      }));
    });
}

const { category, projects, years, year } = Astro.props;
---

<CategoryPage category={category} projects={projects} years={years} year={year} />
