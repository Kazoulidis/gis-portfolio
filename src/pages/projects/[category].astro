---
/**
 * One page per project category: /projects/30-day-map-challenge, etc.
 *
 * This sits alongside [...slug].astro, which renders the individual projects.
 * Both are dynamic routes over the same segment, and they coexist because each
 * only generates the paths its getStaticPaths returns, and those sets are
 * disjoint. If a project slug ever collides with a category slug, the build
 * fails on a duplicate route - noisily, which is what you want.
 *
 * A by-year category (the challenge) shows its newest year here; earlier
 * years are built by [category]/[year].astro.
 */
import { getCollection } from 'astro:content';
import CategoryPage from '../../components/CategoryPage.astro';
import { projectCategories } from '../../site';
import { isInList, isListed, projectYear, sortForCategory, yearsOf } from '../../projects';

export async function getStaticPaths() {
  const all = await getCollection('projects', isInList);

  // A category with nothing published gets no page, and CategoryTabs drops its
  // tab to match - an empty "Nothing here yet" page is a placeholder by another
  // name. It comes back on its own once a project lands in it.
  const populated = projectCategories.filter((category) =>
    all.some((project) => isListed(project) && project.data.category === category.slug),
  );

  return populated.map((category) => {
    const inCategory = all.filter((project) => project.data.category === category.slug);
    if (!category.byYear) {
      return { params: { category: category.slug }, props: { category, projects: sortForCategory(inCategory, category) } };
    }
    const years = yearsOf(inCategory.filter(isListed));
    const newest = inCategory.filter((project) => projectYear(project) === years[0]);
    return {
      params: { category: category.slug },
      props: { category, projects: sortForCategory(newest, category), years, year: years[0] },
    };
  });
}

const { category, projects, years, year } = Astro.props;
---

<CategoryPage category={category} projects={projects} years={years} year={year} />
