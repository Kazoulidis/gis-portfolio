---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMap from '../../components/ProjectMap.astro';
import ZoomableImage from '../../components/ZoomableImage.astro';
import HexbinPointMap from '../../components/HexbinPointMap.astro';
import RailwayMap from '../../components/RailwayMap.astro';
import ProtectedAreasMap from '../../components/ProtectedAreasMap.astro';
import PhotoTripMap from '../../components/PhotoTripMap.astro';
import ReliefSettlementsMap from '../../components/ReliefSettlementsMap.astro';
import FireTimelineMap from '../../components/FireTimelineMap.astro';
import UnescoMap from '../../components/UnescoMap.astro';
import PopulationHex3DMap from '../../components/PopulationHex3DMap.astro';
import FatalitiesMaps from '../../components/FatalitiesMaps.astro';
import WindResourceMap from '../../components/WindResourceMap.astro';
import MunicipalityShapes from '../../components/MunicipalityShapes.astro';
import QuakeTimelineMap from '../../components/QuakeTimelineMap.astro';
import SightlineMap from '../../components/SightlineMap.astro';
import CoastRulerMap from '../../components/CoastRulerMap.astro';
import ChartSwipe from '../../components/ChartSwipe.astro';
import CountdownReveal from '../../components/CountdownReveal.astro';
import RuleMap from '../../components/RuleMap.astro';
import VeinRoute from '../../components/VeinRoute.astro';
import { projectCategories } from '../../site';
import { isPublic } from '../../projects';
import { plainTitle } from '../../cv';
import { cardSource } from '../../og';

// Bespoke map components a project can select via `mapComponent:` in
// frontmatter. Add a component here and reference its key. Both `map:` (one
// file) and `layers:` (several) are handed to the component, which takes
// whichever it needs - a hexbin map wants one file, a network map wants two.
const CUSTOM_MAPS: Record<string, typeof ProjectMap> = {
  'refugee-hexbin': HexbinPointMap,
  'railway-network': RailwayMap,
  'protected-areas': ProtectedAreasMap,
  'photo-trip': PhotoTripMap,
  'relief-settlements': ReliefSettlementsMap,
  'fire-timeline': FireTimelineMap,
  'unesco-sites': UnescoMap,
  'population-hex-3d': PopulationHex3DMap,
  'hellenic-fatalities': FatalitiesMaps,
  'wind-resource': WindResourceMap,
  'municipality-shapes': MunicipalityShapes,
  'quake-timeline': QuakeTimelineMap,
  'olympus-sightline': SightlineMap,
  'coast-rulers': CoastRulerMap,
  'chart-swipe': ChartSwipe,
  'countdown-reveal': CountdownReveal,
  'plato-rules': RuleMap,
  'vein-route': VeinRoute,
};

// Every project gets its page, drafts included: a draft is unlisted, reachable
// by its link but kept off every list (see isListed in src/projects.ts).
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  summary,
  date,
  context,
  tags,
  map,
  mapComponent,
  layers,
  mapCaption,
  image,
  imageAlt,
  downloads,
  dataSource,
  links,
} = project.data;

// A bespoke map wins when the project asks for one and it exists; it reads its
// data from `map:`. Otherwise fall through to the generic layer map.
const CustomMap = mapComponent ? CUSTOM_MAPS[mapComponent] : undefined;

// The generic component always takes a list of layers. `map` (one file) is just
// the one-layer case, so fold it in here. The schema guarantees at most one of
// map/layers is set, so this is unambiguous. Its lone layer is unnamed - with a
// single layer the legend is suppressed anyway, so the name is never shown.
const mapLayers = layers ?? (map ? [{ name: '', src: map }] : undefined);

// Send the reader back to the tab this project lives under, not to a generic
// index - landing on "School" after reading a school project is what they
// expect. The category is schema-validated, so this always resolves.
const category = projectCategories.find((c) => c.slug === project.data.category)!;

// UTC for the same reason as fullDate on the About page: the frontmatter date
// is UTC midnight, and a 1 November date would read as October when built west
// of Greenwich.
const formattedDate = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={plainTitle(title)}
  description={summary}
  image={cardSource(project.data) ? `/og/${project.id}.jpg` : undefined}
  imageAlt={imageAlt ?? project.data.thumbnailAlt}
  type="article"
  noindex={!isPublic(project)}
>
  <article>
    <p class="eyebrow">
      {formattedDate}
      {context && <> &middot; {context}</>}
      {/* Marked on the dev server only; on the live site a draft reads as a
          finished page to anyone given its link. */}
      {import.meta.env.DEV && !isPublic(project) && (
        <span class="draft-flag">Draft - unlisted on the live site</span>
      )}
    </p>
    <h1>{title}</h1>
    <p class="lede">{summary}</p>

    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }

    {/* The swipe already shows the printed map, so it would only repeat here. */}
    {
      image && mapComponent !== 'chart-swipe' && (
        <ZoomableImage src={image} full={project.data.imageFull} alt={imageAlt ?? ''} />
      )
    }

    {
      CustomMap && (map || layers) ? (
        <CustomMap src={map} layers={layers} caption={mapCaption} />
      ) : (
        mapLayers && <ProjectMap layers={mapLayers} caption={mapCaption} />
      )
    }

    {
      downloads.length > 0 && (
        <section class="downloads">
          <h2 class="downloads__heading">Downloads</h2>
          <ul class="downloads__list">
            {downloads.map((file) => (
              <li>
                {/* `download` so a click saves the file rather than navigating
                    to it - otherwise a browser just renders the PNG or the
                    GeoJSON in a tab, which is not what a download button
                    promises. Same-origin only, which these are. */}
                <a
                  class="button button--ghost"
                  href={file.href}
                  download
                  data-umami-event="download"
                  data-umami-event-project={project.id}
                  data-umami-event-file={file.label}
                >
                  {file.label}
                </a>
                {file.note && <span class="downloads__note">{file.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      dataSource && (
        <div class="data-source">
          <span class="data-source__label">{dataSource.length > 1 ? 'Data sources' : 'Data source'}</span>
          <ul class="data-source__list">
            {dataSource.map((source) => (
              <li>{source.href ? <a href={source.href}>{source.label}</a> : source.label}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      links.length > 0 && (
        <>
          <hr />
          <h2 class="links-heading">Related</h2>
          <ul class="links">
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <hr />
    <p><a href={`/projects/${category.slug}`}>&larr; {category.label}</a></p>
  </article>
</BaseLayout>

<style>
  .lede {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .links-heading {
    margin-top: 0;
    font-size: 0.75rem;
    font-family: var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .links {
    list-style: none;
    padding: 0;
  }

  .links li {
    margin-bottom: 0.3rem;
  }

  .downloads {
    margin: 2rem 0;
  }

  .downloads__heading {
    margin-top: 0;
    font-size: 0.75rem;
    font-family: var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .downloads__list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
  }

  .downloads__list li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.6rem;
  }

  .downloads__note {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .data-source {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 1.5rem 0 0;
  }

  .data-source__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .data-source__list li + li {
    margin-top: 0.15rem;
  }

  .data-source__label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.15rem;
  }
</style>
