---
/**
 * Day 14: Borges's map, counted. At 1:1, Greek land and the EEZ would fill 15.4 trillion sheets of 20 cm. This chart stacks them, with the Earth and the Moon, all to one scale.
 * The stack runs from the land up through the sea, so that its place in the stack says where a sheet is from. The globes were rendered in ArcGIS Pro.
 * Imagery is loaded by the visitor's browser as it is needed; nothing is stored or passes through this site.
 */
interface Props {
  src?: string;
  caption?: string;
}
const { caption } = Astro.props;
// name, lat, lon, how finely a bundle frames it: an even number of cuts of the 46, each two halving its width (34 is 4,096 sheets, 13 m)
const PLACES: [string, number, number, number][] = [
  ['Parthenon', 37.97153, 23.72662, 28],
  ['Panathenaic Stadium', 37.96842, 23.7411, 26],
  ['Corinth Canal', 37.931, 22.9889, 24],
  ['Delphi', 38.4824, 22.501, 28],
  ['Epidaurus', 37.5962, 23.0793, 26],
  ['Knossos', 35.298, 25.1631, 26],
  ['White Tower', 40.6264, 22.9484, 30],
  ['Rio-Antirrio Bridge', 38.3213, 21.77255, 24],
  ['Oia, Santorini', 36.4615, 25.3757, 26],
  ['Navagio shipwreck', 37.8595, 20.6248, 26],
  ['Balos Lagoon', 35.5817, 23.5893, 22],
  ['Spinalonga', 35.2975, 25.7386, 24],
  ['Lindos', 36.0917, 28.0885, 26],
  ['Summit of Olympus', 40.0857, 22.3586, 28],
  ['Simonopetra, Mount Athos', 40.1904, 24.2472, 28],
  ['Calypso Deep', 36.57, 21.13, 28],
];
---

<figure class="map-figure">
  <div class="exact" data-exact>
    <canvas data-exact-canvas role="img" aria-label="Chart to scale: the Earth and the Moon as tiny dots, and a stack of paper from Greece. Greek land alone reaches 330,074 km, short of the Moon. With the sea it reaches 1,536,787 km, almost four times the distance to the Moon."></canvas>
    <div class="exact__hud" aria-live="off">
      <div><span>Height of the stack</span><strong data-exact-height></strong></div>
      <div><span>Sheets in it</span><strong data-exact-count></strong></div>
    </div>
    <p class="exact__credit">Earth and Moon: NASA</p>
  </div>
  <div class="exact__toggle" role="group" aria-label="What the stack holds">
    <button type="button" data-exact-mode="sea" aria-pressed="true">Land and sea</button>
    <button type="button" data-exact-mode="land" aria-pressed="false">Land only</button>
    <p data-exact-status aria-live="polite"></p>
  </div>
  <div class="exact__picker">
    <p class="exact__lead">Open a bundle of sheets from somewhere worth seeing:</p>
    <div class="exact__places">
      {PLACES.map(([name, lat, lon, level]) => <button type="button" data-exact-place data-name={name} data-lat={lat} data-lon={lon} data-level={level} data-sea={name === 'Calypso Deep' ? '' : undefined}>{name}</button>)}
    </div>
    <div class="exact__pull">
      <button type="button" data-exact-any>Any bundle at all</button>
      <button type="button" data-exact-greek>Any bundle of land</button>
    </div>
    <div class="exact__result" data-exact-result hidden>
      <div class="exact__wrap" data-exact-wrap>
        <div class="exact__view" data-exact-view role="application" aria-label="Satellite view of the bundle you opened"></div>
      </div>
      <div class="exact__facts">
        <h3 data-exact-number></h3>
        <button type="button" class="exact__up" data-exact-up hidden>Back up a level</button>
        <dl data-exact-facts></dl>
        <p class="exact__note" data-exact-note></p>
        <p><a data-exact-google target="_blank" rel="noopener noreferrer">Open this spot in Google Maps</a></p>
      </div>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .exact { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #080c16; border-radius: 4px; }
  .exact canvas { display: block; width: 100%; height: 100%; }
  .exact canvas.is-over { cursor: pointer; }
  .exact__hud { position: absolute; top: 0; left: 0; display: flex; gap: 1.4rem; padding: 0.7rem 0.9rem; color: #e8ecf4; pointer-events: none; font-family: 'Times New Roman', Times, serif; font-size: clamp(0.72rem, 1.5vw, 0.95rem); line-height: 1.25; }
  .exact__hud span { display: block; opacity: 0.72; font-style: italic; }
  .exact__hud strong { font-variant-numeric: tabular-nums; font-size: 1.2em; font-weight: 400; }
  .exact__credit { position: absolute; left: 0.5rem; bottom: 0.25rem; margin: 0; color: #e8ecf4; opacity: 0.6; font-size: 0.68rem; pointer-events: none; }
  .exact__toggle { display: flex; flex-wrap: wrap; align-items: center; gap: 0; margin-top: 0.6rem; }
  .exact__toggle button { padding: 0.35rem 0.9rem; font: inherit; font-size: 0.92rem; font-weight: 600; color: inherit; background: none; border: 1px solid currentColor; cursor: pointer; transition: background 0.15s, color 0.15s; }
  .exact__toggle button:first-of-type { border-radius: 3px 0 0 3px; }
  .exact__toggle button:nth-of-type(2) { border-left: 0; border-radius: 0 3px 3px 0; }
  .exact__toggle button[aria-pressed='true'] { color: #111; background: #ecb04e; border-color: #ecb04e; }
  .exact__toggle p { flex: 1 1 16rem; margin: 0 0 0 0.9rem; font-size: 0.92rem; }
  .exact__picker { margin-top: 0.9rem; }
  .exact__lead { margin: 0 0 0.4rem; font-weight: 600; }
  .exact__places { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.6rem; }
  .exact__places button { padding: 0.25rem 0.6rem; font: inherit; font-size: 0.88rem; color: inherit; background: none; border: 1px solid currentColor; border-radius: 999px; cursor: pointer; transition: background 0.15s, color 0.15s; }
  .exact__places button:hover, .exact__places button:focus-visible, .exact__places button[aria-pressed='true'] { color: #111; background: #ecb04e; border-color: #ecb04e; }
  .exact__places button[hidden] { display: none; }
  .exact__pull { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .exact__pull button { padding: 0.4rem 0.8rem; font: inherit; font-size: 0.95rem; font-weight: 600; color: inherit; background: none; border: 1px solid currentColor; border-radius: 3px; cursor: pointer; }
  .exact__result { display: grid; grid-template-columns: 3fr 2fr; gap: 0.8rem; margin-top: 0.7rem; }
  .exact__result[hidden] { display: none; }
  .exact__wrap { position: relative; z-index: 5; width: 100%; box-shadow: 0 4px 12px rgb(0 0 0 / 0.25); aspect-ratio: 1; align-self: start; transform-origin: center; background: #f6f3ea; border-radius: 3px; }
  .exact__view { position: absolute; inset: 0; background: #10131a; border-radius: 3px; }
  .exact__deal { position: absolute; inset: 0; z-index: 1000; display: grid; grid-template-columns: repeat(5, 1fr); grid-template-rows: repeat(5, 1fr); pointer-events: none; }
  .exact__deal i { display: block; background: #f6f3ea; outline: 0.5px solid rgb(60 60 70 / 0.35); will-change: transform, opacity; }
  .exact__facts h3 { margin: 0 0 0.5rem; font-size: 1.05rem; font-variant-numeric: tabular-nums; }
  .exact__facts dl { display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 0.7rem; margin: 0 0 0.6rem; font-size: 0.92rem; }
  .exact__facts dt { opacity: 0.7; }
  .exact__facts dd { margin: 0; }
  .exact__note { font-size: 0.88rem; opacity: 0.85; }
  .exact__up { margin: 0 0 0.6rem; padding: 0.3rem 0.7rem; font: inherit; font-size: 0.9rem; font-weight: 600; color: inherit; background: none; border: 1px solid currentColor; border-radius: 3px; cursor: pointer; }
  .exact__up[hidden] { display: none; }
  @media (max-width: 720px) {
    .exact__result { grid-template-columns: 1fr; }
    .exact__toggle p { flex-basis: 100%; margin: 0.4rem 0 0; }
  }
</style>

<script>
  import * as L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const root = document.querySelector<HTMLElement>('[data-exact]');
  if (root) start(root);

  function start(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-exact-canvas]')!;
    const screen = canvas.getContext('2d')!;
    let ctx = screen;                                                // the words and shapes below draw on whichever is current
    const layer = document.createElement('canvas'), layerCtx = layer.getContext('2d')!;
    let layerKey = '';
    const $ = <T extends HTMLElement>(n: string) => document.querySelector<T>(`[data-exact-${n}]`)!;
    const elHeight = $('height'), elCount = $('count'), elStatus = $('status');
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- the numbers: measured in eez_measure.py ----
    const SHEETS = 15367874013300, LAND_SHEETS = 3300744308678;
    const TOP_KM = 1536787, LAND_KM = 330074, MOON_KM = 384400, AXIS_KM = 4 * MOON_KM;
    const LANDF = LAND_KM / TOP_KM, ZOOM_KM = MOON_KM * 1.14;           // with the land alone, the view closes in on the Moon's ring
    const EARTH_KM = 12742, MOON_D_KM = 3474;

    // ---- the grid behind the stack: Web Mercator metres; K turns true metres at 38 N into them ----
    const R0 = 20037508.34;
    const mx = (lon: number) => (lon / 180) * R0;
    const my = (lat: number) => (Math.log(Math.tan(Math.PI / 4 + (lat * Math.PI) / 360)) / Math.PI) * R0;
    const K = 1 / Math.cos((38 * Math.PI) / 180);
    const SIDE = 2 ** 23 * 0.2 * K, CX = mx(24.2), CY = my(37.2);
    const S = { x0: CX - SIDE / 2, x1: CX + SIDE / 2, y0: CY - SIDE / 2, y1: CY + SIDE / 2 };
    const LEVELS = 46;                                               // cuts of that square down to one sheet
    const fmtN = (n: number) => Math.round(n).toLocaleString('en-GB');
    const ease = (f: number) => { f = Math.min(1, Math.max(0, f)); return f * f * (3 - 2 * f); };
    const rnd = (i: number) => { const v = Math.sin(i * 127.1 + 311.7) * 43758.5453; return v - Math.floor(v); };

    // ---- imagery, fetched as it is seen ----
    const GOOGLE = { url: (z: number, x: number, y: number) => `https://mt${(x + y) % 4}.google.com/vt/lyrs=s&x=${x}&y=${y}&z=${z}`, maxZ: 22, credit: 'Imagery © Google' };
    let dirty = true;
    type Tile = { img: HTMLImageElement; ok: boolean };
    const tiles = new Map<string, Tile>();
    function tile(z: number, x: number, y: number): Tile {
      const key = `${z}/${x}/${y}`;
      let t = tiles.get(key);
      if (!t) {
        const made: Tile = { img: new Image(), ok: false };
        made.img.onload = () => { made.ok = true; dirty = true; };
        made.img.src = GOOGLE.url(z, x, y);
        tiles.set(key, made);
        if (tiles.size > 300) tiles.delete(tiles.keys().next().value as string);
        t = made;
      }
      return t;
    }
    const earthImg = new Image(), moonImg = new Image();
    earthImg.onload = moonImg.onload = () => { dirty = true; };
    earthImg.src = '/images/30dmc-2026-day-14-earth.webp';
    moonImg.src = '/images/30dmc-2026-day-14-moon.webp';

    // ---- the chart ----
    let W = 1, H = 1, DPR = 1;
    const FS = () => Math.max(10.5, W / 74);
    const SERIF = '"Times New Roman", Times, serif';
    const SKY = '#080c16', INK = 'rgba(232,236,244,', LAND = '#ecb04e', SEA = '#70b0ea', RING = 'rgba(150,165,195,.55)';
    function geom() {
      const ex = Math.max(26, W * 0.055), ey = H - Math.max(26, H * 0.11), tx = W - Math.max(16, W * 0.04), ty = Math.max(30, H * 0.13);
      const len = Math.hypot(tx - ex, ty - ey), ux = (tx - ex) / len, uy = (ty - ey) / len, zoomed = ease((1 - keep) / (1 - LANDF)), pp = len / (AXIS_KM * (ZOOM_KM / AXIS_KM) ** zoomed);
      const rE = (EARTH_KM / 2) * pp, rM = (MOON_D_KM / 2) * pp;
      const gx = ex + 0.9063 * rE * ux, gy = ey + 0.9063 * rE * uy;
      const px = uy, py = -ux;                                       // towards the upper left of the stack
      const at = (km: number, off = 0) => [gx + km * pp * ux + off * px, gy + km * pp * uy + off * py];
      const ang = Math.atan2(uy, ux), ma = ang + (24 * Math.PI) / 180;
      const mox = gx + MOON_KM * pp * Math.cos(ma), moy = gy + MOON_KM * pp * Math.sin(ma);
      return { ex, ey, ux, uy, px, py, pp, rE, rM, gx, gy, at, ang, mox, moy };
    }
    type Geom = ReturnType<typeof geom>;
    function words(s: string, x: number, y: number, size: number, align: CanvasTextAlign, col: string, o: { italic?: boolean; bold?: boolean; plate?: boolean } = {}) {
      ctx.font = `${o.italic ? 'italic ' : ''}${o.bold ? '700 ' : ''}${size}px ${SERIF}`;
      ctx.textAlign = align;
      if (o.plate !== false) {
        const w = ctx.measureText(s).width + 4, x0 = align === 'left' ? x - 2 : align === 'right' ? x - w + 2 : x - w / 2;
        ctx.fillStyle = SKY; ctx.fillRect(x0, y - size * 0.86, w, size * 1.12);
      }
      ctx.fillStyle = col; ctx.fillText(s, x, y);
    }

    let keep = 1, noSea = false;                                     // how much of the stack is there: 1 with the sea, LANDF without
    let hoverKm = -1, shownKm = -1, hoverAmt = 0, lastSwap = 0, hoverKind: '' | 'earth' | 'moon' = '', lensKind: '' | 'earth' | 'moon' = '', lensAmt = 0;
    let pickedKm = -1;

    function drawStack(G: Geom, bulge: boolean) {
      const topKm = keep * TOP_KM, wiggle = performance.now() / 110;
      const half = (km: number) => {
        let w = 1.05;
        if (bulge && hoverAmt > 0.01 && shownKm >= 0) {
          const d_ = (km - shownKm) / (TOP_KM * 0.022);
          w += hoverAmt * 6.5 * Math.exp(-d_ * d_) * (1 + 0.12 * Math.sin(km / 9000 + wiggle));
        }
        return w;
      };
      const seg = (a: number, b: number, col: string) => {
        if (b <= a) return;
        const n = Math.max(2, Math.ceil(((b - a) / TOP_KM) * 260)), L_: number[][] = [], R_: number[][] = [];
        for (let i = 0; i <= n; i++) {
          const km = a + ((b - a) * i) / n, w = half(km);
          L_.push(G.at(km, w)); R_.push(G.at(km, -w));
        }
        ctx.fillStyle = col; ctx.beginPath(); ctx.moveTo(L_[0][0], L_[0][1]);
        for (const q of L_) ctx.lineTo(q[0], q[1]);
        for (const q of R_.reverse()) ctx.lineTo(q[0], q[1]);
        ctx.closePath(); ctx.fill();
      };
      seg(0, Math.min(LAND_KM, topKm), LAND);
      seg(LAND_KM, topKm, SEA);
      // the sea's sheets leaving, while the toggle runs
      if (keep > LANDF + 0.003 && keep < 0.997) {
        const [ox, oy] = G.at(topKm);
        for (let i = 0; i < 34; i++) {
          const life = (keep * 7 + rnd(i + 40)) % 1, a_ = rnd(i + 50) * 2.2 + G.ang - 1.4, dist = life * W * 0.16, c = FS() * 0.62;
          ctx.save(); ctx.translate(ox + Math.cos(a_) * dist, oy + Math.sin(a_) * dist); ctx.rotate(life * (rnd(i + 70) * 6 - 3)); ctx.globalAlpha = (1 - life) * 0.9;
          ctx.fillStyle = `rgb(${50 + rnd(i) * 60},${120 + rnd(i + 1) * 50},${190 + rnd(i + 2) * 50})`; ctx.fillRect(-c / 2, -c / 2, c, c);
          ctx.restore();
        }
        ctx.globalAlpha = 1;
      }
    }
    function drawChart() {
      const G = geom(), f = FS(), small = Math.max(10.5, f * 0.86), roomy = MOON_KM * G.pp > small * 7.5;
      ctx.fillStyle = SKY; ctx.fillRect(0, 0, W, H);
      ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = keep === 1 || keep === LANDF ? 'high' : 'medium';
      // range rings around Greece, every Moon's distance
      ctx.strokeStyle = RING; ctx.lineWidth = 0.8;
      for (let n = 1; n <= 4; n++) { ctx.beginPath(); ctx.arc(G.gx, G.gy, n * MOON_KM * G.pp, 0, 2 * Math.PI); ctx.stroke(); }
      // the bodies, at their true size, turned as the stack is
      ctx.save(); ctx.translate(G.ex, G.ey); ctx.rotate(G.ang);
      if (earthImg.complete && earthImg.naturalWidth) { const s_ = G.rE / 0.8; ctx.drawImage(earthImg, -s_, -s_, s_ * 2, s_ * 2); }
      ctx.restore();
      if (moonImg.complete && moonImg.naturalWidth) { const s_ = G.rM / 0.96; ctx.drawImage(moonImg, G.mox - s_, G.moy - s_, s_ * 2, s_ * 2); }
      // the graduation
      ctx.strokeStyle = `${INK}.7)`; ctx.lineWidth = 0.8;
      const topKm = keep * TOP_KM;
      for (let i = 1; i * 1e5 <= topKm; i++) { const a = G.at(i * 1e5, -2.2), b = G.at(i * 1e5, -6); ctx.beginPath(); ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]); ctx.stroke(); }
      for (let n = 1; n <= 4; n++) {
        const km = n * MOON_KM, a = G.at(km, 2), b = G.at(km, 9), c = G.at(km, 12);
        ctx.strokeStyle = `${INK}.9)`; ctx.beginPath(); ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]); ctx.stroke();
        if (roomy) {
          words(`${fmtN(km)} km`, c[0] + 2, c[1] - 1, small, 'right', `${INK}1)`);
          words(n === 1 ? "The Moon's distance" : `${n} times`, c[0] + 2, c[1] - 1 - small * 1.15, small, 'right', `${INK}.75)`, { italic: true });
        } else words(`${n}×`, c[0] + 2, c[1] - 1, small, 'right', `${INK}1)`);
      }
      drawStack(G, false);
      if (pickedKm >= 0 && pickedKm <= topKm) {
        const a = G.at(pickedKm, 7), b = G.at(pickedKm, -7);
        ctx.strokeStyle = '#fff'; ctx.lineWidth = 2.5; ctx.beginPath(); ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]); ctx.stroke();
      }
      // locators and names: at this scale the Moon is a speck
      ctx.strokeStyle = `${INK}.9)`; ctx.lineWidth = 0.9;
      const ringE = Math.max(G.rE + 4, 8), ringM = Math.max(G.rM + 4, 6);
      ctx.beginPath(); ctx.arc(G.ex, G.ey, ringE, 0, 7); ctx.stroke();
      ctx.beginPath(); ctx.arc(G.mox, G.moy, ringM, 0, 7); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(G.ex + ringE * 0.7, G.ey + ringE * 0.7); ctx.lineTo(G.ex + ringE * 0.7 + 7, G.ey + ringE * 0.7 + 7); ctx.stroke();
      if (G.mox + ringM + 12 + f * 10.5 > W) {
        ctx.beginPath(); ctx.moveTo(G.mox - ringM, G.moy); ctx.lineTo(G.mox - ringM - 9, G.moy); ctx.stroke();
        words(roomy ? `Moon, ${fmtN(MOON_D_KM)} km across` : 'Moon', G.mox - ringM - 12, G.moy + f * 0.34, f * 0.95, 'right', `${INK}1)`);
      } else {
        ctx.beginPath(); ctx.moveTo(G.mox + ringM, G.moy); ctx.lineTo(G.mox + ringM + 9, G.moy); ctx.stroke();
        words(roomy ? `Moon, ${fmtN(MOON_D_KM)} km across` : 'Moon', G.mox + ringM + 12, G.moy + f * 0.34, f * 0.95, 'left', `${INK}1)`);
      }
      words(roomy ? `Earth, ${fmtN(EARTH_KM)} km across` : 'Earth', G.ex + ringE * 0.7 + 9, Math.min(H - 5, G.ey + ringE * 0.7 + 7 + f * 0.5), f * 0.95, 'left', `${INK}1)`);
      // what the stack comes to
      const lBase = G.at(LAND_KM, -3), lTo = [lBase[0] + 12, lBase[1] + 13];
      ctx.strokeStyle = LAND; ctx.lineWidth = 0.9; ctx.beginPath(); ctx.moveTo(lBase[0], lBase[1]); ctx.lineTo(lTo[0], lTo[1]); ctx.stroke();
      words(`Land alone: ${fmtN(LAND_KM)} km`, lTo[0] + 3, lTo[1] + f * 0.4, f, 'left', LAND, { bold: true });
      words('54,326 km short of the Moon', lTo[0] + 3, lTo[1] + f * 1.55, f * 0.92, 'left', `${INK}1)`);
      const seaShown = (keep - LANDF) / (1 - LANDF);
      if (seaShown > 0.01) {
        ctx.globalAlpha = ease(seaShown);
        const e = G.at(TOP_KM), tx = Math.min(W - 10, e[0] + W * 0.01), ty = e[1] + H * 0.17;
        ctx.strokeStyle = SEA; ctx.lineWidth = 0.9; ctx.beginPath(); ctx.moveTo(e[0], e[1] + 2); ctx.lineTo(tx, ty - f * 0.9); ctx.stroke();
        words(`With the sea: ${fmtN(TOP_KM)} km`, tx, ty, f, 'right', SEA, { bold: true });
        words('813 km short of four Moon distances', tx, ty + f * 1.15, f * 0.92, 'right', `${INK}1)`);
        ctx.globalAlpha = 1;
      }
      // the scale bar, and the note
      const span = 5e5 * G.pp > W * 0.5 ? 1e5 : 5e5, divs = span === 1e5 ? 4 : 5, bw = span * G.pp, per = bw / divs, bx = W - W * 0.035 - bw, by = H - f * (W > 620 ? 3.6 : 1.4);
      for (let i = 0; i < divs; i++) { ctx.fillStyle = i % 2 ? SKY : `${INK}.95)`; ctx.fillRect(bx + i * per, by, per, 3.5); }
      ctx.strokeStyle = `${INK}.95)`; ctx.lineWidth = 0.7; ctx.strokeRect(bx, by, bw, 3.5);
      words('0', bx, by - 3.5, small, 'center', `${INK}1)`);
      words(`${fmtN(span / 1000)},000 km`, bx + bw, by - 3.5, small, 'right', `${INK}1)`);
      if (W > 620) {
        words('The Earth, the Moon and all distances are true to this bar;', W - W * 0.035, by + 3.5 + small * 1.1, small, 'right', `${INK}.75)`, { italic: true });
        words("only the stack's thickness is enlarged.", W - W * 0.035, by + 3.5 + small * 2.2, small, 'right', `${INK}.75)`, { italic: true });
      }
    }
    function paint() {
      const key = `${canvas.width}|${canvas.height}|${keep}|${pickedKm}|${earthImg.complete && earthImg.naturalWidth}|${moonImg.complete && moonImg.naturalWidth}`;
      if (key !== layerKey) {
        layerKey = key;
        layer.width = canvas.width; layer.height = canvas.height;
        ctx = layerCtx; ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        drawChart();
        ctx = screen;
      }
      screen.setTransform(1, 0, 0, 1, 0, 0); screen.globalAlpha = 1;
      screen.drawImage(layer, 0, 0);
      screen.setTransform(DPR, 0, 0, DPR, 0, 0);
      const moving = hoverAmt > 0.01 && shownKm >= 0;
      if (moving || lensAmt > 0.01) {
        const G = geom();
        if (moving) drawStack(G, true);
