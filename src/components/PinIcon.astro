---
/**
 * The pushpin that marks a featured project (`featured: true`) in the About
 * page's recent projects. Drawn in the text colour it sits on; the caller
 * positions it. The shape is Lucide's "pin" (ISC licence).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['pin', className]} role="img" aria-label="Pinned project" title="Pinned project">
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 17v5" />
    <path
      d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"
    />
  </svg>
</span>

<style>
  .pin {
    display: inline-flex;
    color: var(--text-muted);
  }

  .pin svg {
    width: 1rem;
    height: 1rem;
  }
</style>
