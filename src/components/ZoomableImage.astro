---
/**
 * The finished map at the top of a project page, with a full-screen viewer
 * for reading it closely: scroll or pinch to zoom, drag to pan, double-click
 * to zoom in on a spot, keyboard + / - / 0 / arrows. A print layout is made to
 * be read at A4, and at screen width its legend and labels are too small.
 *
 * `full` is a larger copy of the image, fetched only when the viewer opens, so
 * the page itself stays light. The light image shows straight away and is
 * swapped for the full one once it arrives; both have the same aspect, so the
 * swap does not move anything.
 *
 * The figure sits in an open <details>, so a reader who has seen the print
 * can fold it away and reach the interactive map and the text sooner.
 *
 *   <ZoomableImage src="/images/map-wide.webp" full="/images/map-full.webp" alt="..." />
 */
interface Props {
  src: string;
  full?: string;
  alt: string;
}

const { src, full, alt } = Astro.props;
---

<details class="project-image" open>
<summary class="project-image__toggle">Printed map</summary>
<figure class="project-image__figure" data-zoomable data-full={full ?? src}>
  <button type="button" class="zoomable__open" aria-label="Open the map full screen to zoom in">
    <img src={src} alt={alt} loading="eager" decoding="async" />
  </button>

  <dialog class="zoomable__dialog" aria-label="Map viewer">
    <div class="zoomable__viewport" tabindex="0">
      <img class="zoomable__img" src={src} alt={alt} draggable="false" />
    </div>
    <div class="zoomable__toolbar">
      <button type="button" data-action="in" aria-label="Zoom in" title="Zoom in (+)">+</button>
      <button type="button" data-action="out" aria-label="Zoom out" title="Zoom out (-)">&minus;</button>
      <button type="button" data-action="fit" aria-label="Fit to screen" title="Fit to screen (0)">Fit</button>
      <button type="button" data-action="close" aria-label="Close" title="Close (Esc)">&times;</button>
    </div>
    <p class="zoomable__status" aria-live="polite"></p>
  </dialog>
</figure>
</details>

<script>
  const MAX_SCALE = 10;
  const STEP = 1.5;

  for (const figure of document.querySelectorAll<HTMLElement>('[data-zoomable]')) {
    const dialog = figure.querySelector('dialog')!;
    const viewport = figure.querySelector<HTMLElement>('.zoomable__viewport')!;
    const img = figure.querySelector<HTMLImageElement>('.zoomable__img')!;
    const status = figure.querySelector<HTMLElement>('.zoomable__status')!;
    const fullSrc = figure.dataset.full!;

    // The image is laid out at its "fit" size (base width/height) and scaled
    // with a transform about its top-left corner; x/y is that corner's offset
    // in the viewport.
    let scale = 1;
    let x = 0;
    let y = 0;
    let baseW = 0;
    let baseH = 0;

    const layout = () => {
      const ratio = img.naturalWidth / img.naturalHeight || 1.4;
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      baseW = Math.min(vw, vh * ratio);
      baseH = baseW / ratio;
      img.style.width = `${baseW}px`;
      img.style.height = `${baseH}px`;
    };

    // Smaller than the viewport: centred. Larger: no gap at either edge.
    const clamp = () => {
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      const w = baseW * scale;
      const h = baseH * scale;
      x = w <= vw ? (vw - w) / 2 : Math.min(0, Math.max(vw - w, x));
      y = h <= vh ? (vh - h) / 2 : Math.min(0, Math.max(vh - h, y));
    };

    const apply = () => {
      clamp();
      img.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
      viewport.classList.toggle('is-zoomed', scale > 1.001);
    };

    // Zoom to `next`, keeping the point (px, py) of the viewport still.
    const zoomAt = (next: number, px: number, py: number) => {
      next = Math.min(MAX_SCALE, Math.max(1, next));
      x = px - ((px - x) * next) / scale;
      y = py - ((py - y) * next) / scale;
      scale = next;
      apply();
    };
    const zoomCentre = (factor: number) =>
      zoomAt(scale * factor, viewport.clientWidth / 2, viewport.clientHeight / 2);
    const fit = () => {
      scale = 1;
      apply();
    };

    const point = (e: { clientX: number; clientY: number }) => {
      const r = viewport.getBoundingClientRect();
      return [e.clientX - r.left, e.clientY - r.top] as const;
    };

    let loaded = fullSrc === img.getAttribute('src');
    const open = () => {
      dialog.showModal();
      layout();
      fit();
      viewport.focus();
      if (!loaded) {
        loaded = true;
        status.textContent = 'Loading full resolution…';
        const hi = new Image();
        hi.onload = () => {
          img.src = fullSrc;
          status.textContent = '';
        };
        hi.onerror = () => (status.textContent = '');
        hi.src = fullSrc;
      }
    };

    figure.querySelector('.zoomable__open')!.addEventListener('click', open);
    window.addEventListener('resize', () => {
      if (dialog.open) {
        layout();
        apply();
      }
    });

    figure.querySelector('.zoomable__toolbar')!.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest<HTMLElement>('[data-action]')?.dataset.action;
      if (action === 'in') zoomCentre(STEP);
      else if (action === 'out') zoomCentre(1 / STEP);
      else if (action === 'fit') fit();
      else if (action === 'close') dialog.close();
    });

    viewport.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        // Trackpads send many small deltas, mouse wheels a few large ones;
        // the exponential keeps both proportional.
        const [px, py] = point(e);
        zoomAt(scale * Math.exp(-e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.002)), px, py);
      },
      { passive: false },
    );

    viewport.addEventListener('dblclick', (e) => {
      const [px, py] = point(e);
      if (scale >= MAX_SCALE / 1.01) fit();
      else zoomAt(scale * 2.5, px, py);
    });

    // Drag with one pointer, pinch with two. Each move works from the change
    // since the previous event, so a finger joining or leaving mid-gesture
    // does not make the image jump.
    const pointers = new Map<number, readonly [number, number]>();
    let last: { cx: number; cy: number; dist: number } | null = null;
    const gesture = () => {
      const pts = [...pointers.values()];
      const cx = pts.reduce((s, p) => s + p[0], 0) / pts.length;
      const cy = pts.reduce((s, p) => s + p[1], 0) / pts.length;
      const dist = pts.length > 1 ? Math.hypot(pts[0][0] - pts[1][0], pts[0][1] - pts[1][1]) : 0;
      return { cx, cy, dist };
    };

    viewport.addEventListener('pointerdown', (e) => {
      try {
        viewport.setPointerCapture(e.pointerId);
      } catch {
        // A pointer that is already gone cannot be captured; track it anyway.
      }
      pointers.set(e.pointerId, point(e));
      last = gesture();
      viewport.classList.add('is-dragging');
    });
    viewport.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId) || !last) return;
      pointers.set(e.pointerId, point(e));
      const now = gesture();
      x += now.cx - last.cx;
      y += now.cy - last.cy;
      if (now.dist && last.dist) zoomAt(scale * (now.dist / last.dist), now.cx, now.cy);
      else apply();
      last = now;
    });
    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      last = pointers.size ? gesture() : null;
      if (!pointers.size) viewport.classList.remove('is-dragging');
    };
    viewport.addEventListener('pointerup', release);
    viewport.addEventListener('pointercancel', release);

    viewport.addEventListener('keydown', (e) => {
      const pan = 80;
      const keys: Record<string, () => void> = {
        '+': () => zoomCentre(STEP),
        '=': () => zoomCentre(STEP),
        '-': () => zoomCentre(1 / STEP),
        '0': fit,
        ArrowLeft: () => ((x += pan), apply()),
        ArrowRight: () => ((x -= pan), apply()),
        ArrowUp: () => ((y += pan), apply()),
        ArrowDown: () => ((y -= pan), apply()),
      };
      const run = keys[e.key];
      if (run) {
        e.preventDefault();
        run();
      }
    });
  }
</script>

<style>
  /* The finished map leads the page, so it gets the full frame width rather
     than the text measure. */
  .project-image {
    margin: 2rem 0;
    max-width: none;
  }

  .project-image__figure {
    margin: 0.5rem 0 0;
    max-width: none;
  }

  .project-image__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .project-image__toggle::-webkit-details-marker {
    display: none;
  }

  .project-image__toggle::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s;
  }

  .project-image[open] > .project-image__toggle::before {
    transform: rotate(45deg) translate(-0.1rem, -0.1rem);
  }

  .project-image__toggle:hover {
    color: var(--accent);
  }

  .zoomable__open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .zoomable__open img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .zoomable__dialog {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #15181b;
    color: #fff;
  }

  .zoomable__dialog::backdrop {
    background: #15181b;
  }

  .zoomable__viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: none;
    cursor: zoom-in;
    outline: none;
  }

  .zoomable__viewport.is-zoomed {
    cursor: grab;
  }

  .zoomable__viewport.is-dragging {
    cursor: grabbing;
  }

  .zoomable__img {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    transform-origin: 0 0;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zoomable__toolbar {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.35rem;
  }

  .zoomable__toolbar button {
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.6rem;
    font: 600 1.1rem var(--font-sans);
    color: #fff;
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .zoomable__toolbar button[data-action='fit'] {
    font-size: 0.85rem;
  }

  .zoomable__toolbar button:hover,
  .zoomable__toolbar button:focus-visible {
    background: rgb(255 255 255 / 0.26);
  }

  .zoomable__status {
    position: absolute;
    left: 0.75rem;
    bottom: 0.5rem;
    margin: 0;
    font: 0.8rem var(--font-sans);
    color: rgb(255 255 255 / 0.75);
  }

  /* No page scrolling behind the open viewer. Keyed to the dialog's own state,
     so it cannot be left on however the dialog closes. */
  :global(html:has(.zoomable__dialog[open])) {
    overflow: hidden;
  }
</style>
