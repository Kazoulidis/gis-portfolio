---
/**
 * Day 11: click a prefecture and turn the knob along its FM dial, from 87.5 to 108 MHz. Between stations you hear static, generated in
 * the browser. On a station with an online stream you hear that station's own live stream, for at most 15 seconds a station on each
 * visit. Nothing is recorded or passes through this site: the browser plays the station's public address. Turning the knob near a
 * station snaps to it, so it is easy to find. The map is Leaflet, on the same basemap as the other maps.
 *
 * Files (`src`, under public/):
 *   *-dial.json   { geo, data, names, start, presets }
 *   *-prefectures.geojson  name, n (stations on air), p (per 100,000)
 *   *-dials.json  [{ name, n, r, p, s: [[mhz, station, stream?, site?], ...] }], in the order of `names`
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  src: string;
  caption?: string;
}
interface Meta { geo: string; data: string; names: string[]; start: string; presets: string[] }

const { src, caption } = Astro.props;
const meta: Meta = JSON.parse(readFileSync(join(process.cwd(), 'public', src), 'utf-8'));
const GRIP = Array.from({ length: 28 }, (_, i) => (i * 360) / 28);
---

<figure class="map-figure">
  <div class="dial" data-dial data-geo={meta.geo} data-src={meta.data} data-start={meta.start}>
    <div class="map map--tall" data-dial-map role="application" aria-label="Map of Greece by prefecture: click one to load its dial"></div>
    <div class="dial__places">
      {meta.presets.map((name) => <button type="button" data-name={name}>{name}</button>)}
      <label>
        <span class="dial__hidden">Choose a prefecture</span>
        <select data-dial-select>
          <option value="">All 51 prefectures</option>
          {meta.names.map((name) => <option value={name}>{name}</option>)}
        </select>
      </label>
    </div>
    <div class="dial__radio">
      <div class="dial__display">
        <span class="dial__mhz"><span data-dial-mhz>87.5</span> MHz</span>
        <span class="dial__station" data-dial-station></span>
        <span class="dial__status" aria-live="polite" data-dial-status>Turn the knob to tune in</span>
      </div>
      <svg class="dial__band" viewBox="0 0 1000 70" aria-hidden="true" data-dial-band>
        <rect width="1000" height="70" fill="#1b1d22" />
        <g data-dial-ticks></g>
        <line data-dial-needle x1="0" x2="0" y1="0" y2="70" stroke="#fff" stroke-width="3" />
      </svg>
      <div class="dial__scale" aria-hidden="true">
        {[88, 92, 96, 100, 104, 108].map((f) => <span style={`left: ${((f - 87.5) / 20.5) * 100}%`}>{f}</span>)}
      </div>
      <div class="dial__lower">
        <div class="dial__knob" role="slider" tabindex="0" aria-label="Tuning knob" aria-valuemin="87.5" aria-valuemax="108" aria-valuenow="87.5" aria-valuetext="87.5 MHz" data-dial-knob>
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="58" fill="#e4dfd5" />
            <circle cx="60" cy="60" r="50" fill="#2a2c32" />
            <g data-dial-rotor>
              {GRIP.map((a) => <line x1="60" y1="11" x2="60" y2="18" stroke="#6d7078" stroke-width="2" transform={`rotate(${a} 60 60)`} />)}
              <circle cx="60" cy="60" r="38" fill="#3b3e45" />
              <line x1="60" y1="27" x2="60" y2="46" stroke="#ffb648" stroke-width="5" stroke-linecap="round" />
            </g>
          </svg>
        </div>
        <div class="dial__notes">
          <p data-dial-head></p>
          <p class="dial__key"><span class="dial__on"></span>Can be heard online <span class="dial__off"></span>Listed, no stream found</p>
          <p class="dial__links">
            <a data-dial-site target="_blank" rel="noopener noreferrer" hidden>The station's site</a>
            <button type="button" data-dial-power disabled>Turn off</button>
          </p>
        </div>
      </div>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import * as L from 'leaflet';
  import { whenNear } from '../lazy';
  import 'leaflet/dist/leaflet.css';

  const BASEMAP = 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}';
  const ATTRIBUTION =
    'Tiles &copy; <a href="https://www.esri.com/">Esri</a> - Esri, HERE, Garmin, ' +
    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';
  // The printed map's classes and colours, stations on air per 100,000 residents.
  const CLASSES = [
    { to: 5, label: 'Under 5', colour: '#f4efe4' },
    { to: 10, label: '5 to 10', colour: '#e9d9b8' },
    { to: 15, label: '10 to 15', colour: '#d9a86c' },
    { to: 20, label: '15 to 20', colour: '#b96a3c' },
    { to: Infinity, label: '20 and over', colour: '#7d3320' },
  ];
  const colourOf = (p: number) => CLASSES.find((c) => p < c.to)!.colour;

  type Station = [number, string, string?, string?];
  interface Prefecture { name: string; n: number; r: number; p: number; s: Station[] }
  const LOW = 87.5;
  const HIGH = 108;
  const TURN = 270;              // degrees of the knob for the whole band
  const SNAP = 0.3;              // MHz either side of a station at which the dial snaps to it
  const LIMIT = 15000;           // ms of each station on one visit
  const WAIT = 9000;             // ms to wait for a stream to answer
  const fmt = (v: number) => v.toLocaleString('en-GB');

  for (const box of document.querySelectorAll<HTMLElement>('[data-dial]')) {
    const q = <T extends Element>(s: string) => box.querySelector<T>(s)!;
    const mapEl = q<HTMLElement>('[data-dial-map]');
    const ticks = q<SVGGElement>('[data-dial-ticks]');
    const needle = q<SVGLineElement>('[data-dial-needle]');
    const band = q<SVGSVGElement>('[data-dial-band]');
    const knob = q<HTMLElement>('[data-dial-knob]');
    const rotor = q<SVGGElement>('[data-dial-rotor]');
    const mhz = q<HTMLElement>('[data-dial-mhz]');
    const stationName = q<HTMLElement>('[data-dial-station]');
    const status = q<HTMLElement>('[data-dial-status]');
    const head = q<HTMLElement>('[data-dial-head]');
    const site = q<HTMLAnchorElement>('[data-dial-site]');
    const power = q<HTMLButtonElement>('[data-dial-power]');
    const select = q<HTMLSelectElement>('[data-dial-select]');

    let all: Prefecture[] = [];
    let map: L.Map | null = null;
    const shapes = new Map<string, L.Path>();
    let now: Prefecture | null = null;
    let value = LOW;
    let tuned: Station | null = null;
    let live: Station | null = null;           // the station whose stream is loaded
    let dwell = 0;
    let giveUp = 0;
    let lastTick = 0;
    const heard = new Map<string, number>();   // ms of each stream on this visit, however often it is tuned in

    const player = new Audio();
    player.preload = 'none';

    // Static: looped noise. The station itself is a plain audio element: browsers will play another site's stream in one.
    let ctx: AudioContext | null = null;
    let hiss: GainNode | null = null;
    const setHiss = (level: number) => {
      if (ctx && hiss) hiss.gain.setTargetAtTime(level, ctx.currentTime, 0.04);
    };
    const switchOn = () => {
      power.disabled = false;
      if (!ctx) {
        ctx = new AudioContext();
        const buffer = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
        const noise = ctx.createBufferSource();
        noise.buffer = buffer;
        noise.loop = true;
        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.value = 2600;
        filter.Q.value = 0.5;
        hiss = ctx.createGain();
        hiss.gain.value = 0;
        noise.connect(filter).connect(hiss).connect(ctx.destination);
        noise.start();
      }
      void ctx.resume();
    };

    const left = (s: Station) => Math.max(0, LIMIT - (heard.get(s[1]) ?? 0));
    const setStatus = (text: string, state: string) => {
      status.textContent = text;
      box.dataset.state = state;
    };

    const stopStream = () => {
      clearTimeout(dwell);
      clearTimeout(giveUp);
      live = null;
      lastTick = 0;
      if (player.getAttribute('src')) {
        player.pause();
        player.removeAttribute('src');
        player.load();
      }
    };

    const startStream = (s: Station) => {
      clearTimeout(dwell);
      if (live === s) return;
      stopStream();
      live = s;
      setStatus('Connecting...', 'connecting');
      setHiss(0.05);
      player.src = s[2]!;
      player.play().catch((error) => {
        if (live !== s) return;
        if (error?.name === 'NotAllowedError') {
          live = null;
          setStatus('Press the knob to listen', 'blocked');
        } else {
          failed(s);
        }
      });
      giveUp = window.setTimeout(() => failed(s), WAIT);
    };

    const failed = (s: Station) => {
      if (live !== s) return;
      stopStream();
      setHiss(0.08);
      setStatus('The stream is not answering', 'failed');
    };

    player.addEventListener('playing', () => {
      clearTimeout(giveUp);
      lastTick = performance.now();
      setHiss(0);
    });
    player.addEventListener('error', () => { if (live) failed(live); });

    // The count only runs while sound is really coming out, and the stream ends at the limit.
    window.setInterval(() => {
      if (!live || !lastTick) return;
      const t = performance.now();
      if (!player.paused && !player.seeking && player.readyState >= 3) {
        heard.set(live[1], (heard.get(live[1]) ?? 0) + (t - lastTick));
      }
      lastTick = t;
      const remaining = left(live);
      if (remaining <= 0) {
        stopStream();
        setHiss(0.08);
        setStatus('Your 15 seconds are up. Try another station', 'finished');
      } else {
        setStatus(`Live, ${Math.ceil(remaining / 1000)} s left`, 'live');
      }
    }, 200);

    /** The station the dial snaps to at f: within reach, one that can be heard before one that cannot. `free` takes the nearest of any. */
    const nearest = (f: number, list: Station[], free = false) => {
      let best: Station | null = null;
      let gap = Infinity;
      for (const s of list) {
        const d = Math.abs(s[0] - f);
        if (d > SNAP) continue;
        const better = free ? d < gap : (Boolean(s[2]) && !best?.[2]) || (Boolean(s[2]) === Boolean(best?.[2]) && d < gap);
        if (better) { gap = d; best = s; }
      }
      return best;
    };

    const draw = () => {
      const x = String(((value - LOW) / (HIGH - LOW)) * 1000);
      needle.setAttribute('x1', x);
      needle.setAttribute('x2', x);
      rotor.setAttribute('transform', `rotate(${((value - LOW) / (HIGH - LOW)) * TURN - TURN / 2} 60 60)`);
      mhz.textContent = value.toFixed(1);
      knob.setAttribute('aria-valuenow', value.toFixed(1));
      knob.setAttribute('aria-valuetext', `${value.toFixed(1)} MHz${tuned ? `, ${tuned[1]}` : ''}`);
    };

    /** Tune to f. `settled` is true at the end of a gesture, when a stream may start at once. */
    const tune = (f: number, settled: boolean, free = false) => {
      if (!now) return;
      switchOn();
      const wanted = Math.round(Math.min(HIGH, Math.max(LOW, f)) * 10) / 10;
      const s = nearest(wanted, now.s, free);
      value = s ? s[0] : wanted;
      if (s !== tuned) {
        tuned = s;
        stopStream();
      }
      draw();
      stationName.textContent = s ? s[1] : '';
      box.dataset.tuned = s ? String(s[0]) : '';
      const home = s?.[3];
      site.hidden = !home;
      if (home) site.href = home;
      if (!s) {
        setHiss(0.08);
        setStatus('Static', 'static');
        return;
      }
      if (!s[2]) {
        setHiss(0.08);
        setStatus('No online stream found', 'nostream');
        return;
      }
      if (left(s) <= 0) {
        setHiss(0.08);
        setStatus('Your 15 seconds are up. Try another station', 'finished');
        return;
      }
      if (live === s) return;
      clearTimeout(dwell);
      setHiss(0.08);
      setStatus('Hold here to listen...', 'waiting');
      if (settled) startStream(s);
      else dwell = window.setTimeout(() => { if (tuned === s) startStream(s); }, 350);
    };

    const turnOff = () => {
      stopStream();
      setHiss(0);
      void ctx?.suspend();
      power.disabled = true;
      setStatus('Off. Turn the knob to tune in', 'off');
    };
    power.addEventListener('click', turnOff);

    const show = (p: Prefecture) => {
      stopStream();
      setHiss(0);
      void ctx?.suspend();
      power.disabled = true;
      now = p;
      tuned = null;
      value = LOW;
      select.value = p.name;
      ticks.replaceChildren();
      for (const s of p.s) {
        const l = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        const x = String(((s[0] - LOW) / (HIGH - LOW)) * 1000);
        l.setAttribute('x1', x);
        l.setAttribute('x2', x);
        l.setAttribute('y1', '8');
        l.setAttribute('y2', '62');
        l.setAttribute('stroke', s[2] ? '#ffb648' : '#6e6450');
        l.setAttribute('stroke-width', s[2] ? '4' : '3');
        ticks.append(l);
      }
      const online = p.s.filter((s) => s[2]).length;
      head.textContent = `${p.name}: ${p.n === 1 ? '1 station' : `${p.n} stations`} on air, ${p.p.toFixed(1)} for every 100,000 of its ${fmt(p.r)} residents. ${online ? `${online} can be heard online.` : 'None found online.'}`;
      shapes.forEach((shape, name) => {
        shape.setStyle(name === p.name ? { color: '#111', weight: 2.5 } : { color: '#5a5a5a', weight: 0.7 });
        if (name === p.name) shape.bringToFront();
      });
      stationName.textContent = '';
      site.hidden = true;
      box.dataset.tuned = '';
      draw();
      setStatus('Turn the knob to tune in', 'off');
    };

    // The knob follows the pointer round its centre: only the change in angle counts, so grabbing it never makes it jump.
    let grabbed = false;
    let lastAngle = 0;
    let moved = false;
    const angle = (event: PointerEvent) => {
      const r = knob.getBoundingClientRect();
      return (Math.atan2(event.clientY - (r.top + r.height / 2), event.clientX - (r.left + r.width / 2)) * 180) / Math.PI;
    };
    let exact = LOW;
    knob.addEventListener('pointerdown', (event) => {
      grabbed = true;
      moved = false;
      lastAngle = angle(event);
      exact = value;
      knob.setPointerCapture(event.pointerId);
      switchOn();
      event.preventDefault();
    });
    knob.addEventListener('pointermove', (event) => {
      if (!grabbed) return;
      const a = angle(event);
      let d = a - lastAngle;
      if (d > 180) d -= 360;
      if (d < -180) d += 360;
      lastAngle = a;
      exact = Math.min(HIGH, Math.max(LOW, exact + (d / TURN) * (HIGH - LOW)));
      moved = true;
      tune(exact, false);
    });
    const release = () => {
      if (!grabbed) return;
      grabbed = false;
      tune(moved ? exact : value, true);   // the end of a press is what browsers accept as permission to play
    };
    knob.addEventListener('pointerup', release);
    knob.addEventListener('pointercancel', release);
    knob.addEventListener('keydown', (event) => {
      const list = (now?.s ?? []).map((s) => s[0]);
      let f: number | undefined;
      if (['ArrowRight', 'ArrowUp', 'PageUp'].includes(event.key)) f = list.find((m) => m > value + 0.05) ?? value;
      else if (['ArrowLeft', 'ArrowDown', 'PageDown'].includes(event.key)) f = [...list].reverse().find((m) => m < value - 0.05) ?? value;
      else if (event.key === 'Home') f = LOW;
      else if (event.key === 'End') f = HIGH;
      if (f === undefined) return;
      event.preventDefault();
      tune(f, true, true);
    });

    // The band can also be pressed directly.
    band.addEventListener('click', (event) => {
      const r = band.getBoundingClientRect();
      tune(LOW + ((event.clientX - r.left) / r.width) * (HIGH - LOW), true);
    });

    const focus = (p: Prefecture) => {
      const shape = shapes.get(p.name) as unknown as L.Polyline | undefined;
      if (map && shape) map.flyToBounds(shape.getBounds(), { maxZoom: 9, padding: [30, 30], duration: 0.6 });
    };

    box.querySelectorAll<HTMLButtonElement>('.dial__places button').forEach((button) => {
      button.addEventListener('click', () => {
        const p = all.find((c) => c.name === button.dataset.name);
        if (p) { show(p); focus(p); }
      });
    });
    select.addEventListener('change', () => {
      const p = all.find((c) => c.name === select.value);
      if (p) { show(p); focus(p); }
    });

    const load = async () => {
      map = L.map(mapEl, { scrollWheelZoom: true });
      L.tileLayer(BASEMAP, { attribution: ATTRIBUTION, maxZoom: 19, maxNativeZoom: 16 }).addTo(map);
      L.control.scale({ imperial: false }).addTo(map);
      try {
        const [geo, data] = await Promise.all([box.dataset.geo!, box.dataset.src!].map((url) => fetch(url).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })));
        all = data;
        const layer = L.geoJSON(geo, {
          style: (f) => ({ color: '#5a5a5a', weight: 0.7, fillColor: colourOf(f?.properties.p), fillOpacity: 0.85 }),
          onEachFeature: (f, shape) => {
            const { name, n, p } = f.properties;
            shapes.set(name, shape as L.Path);
            shape.bindTooltip(`<strong>${name}</strong><br>${n === 1 ? '1 station' : `${n} stations`} on air, ${p.toFixed(1)} per 100,000`, { sticky: true });
            shape.on('click', () => {
              const prefecture = all.find((c) => c.name === name);
              if (prefecture) show(prefecture);
            });
          },
        }).addTo(map);
        map.fitBounds(layer.getBounds(), { padding: [10, 10] });

        const legend = new L.Control({ position: 'bottomright' });
        legend.onAdd = () => {
          const div = L.DomUtil.create('div', 'dial-legend');
          div.innerHTML = '<strong>Stations on air per 100,000 residents</strong>' + CLASSES.map((c) => `<span><i style="background:${c.colour}"></i>${c.label}</span>`).join('');
          return div;
        };
        legend.addTo(map);

        const first = all.find((c) => c.name === box.dataset.start);
        if (first) show(first);
      } catch {
        mapEl.insertAdjacentHTML('beforeend', '<p class="map-error">This map’s data could not be loaded.</p>');
        head.textContent = 'The dials could not be loaded.';
      }
    };
    whenNear(box, () => { void load(); });
  }
</script>

<style>
  /* the selected prefecture has its own outline; the browser's box round a clicked path is not wanted */
  .dial :global(path.leaflet-interactive:focus) { outline: none; }
  .dial :global(.dial-legend) {
    padding: 0.35rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: #222;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 3px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }
  .dial :global(.dial-legend strong) { display: block; max-width: 9rem; margin-bottom: 0.15rem; font-weight: 600; }
  .dial :global(.dial-legend span) { display: block; }
  .dial :global(.dial-legend i) { display: inline-block; width: 0.8rem; height: 0.6rem; margin-right: 0.35rem; border: 1px solid #777; }
  .dial__places {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .dial button,
  .dial select {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.2rem 0.6rem;
    color: var(--text, inherit);
    background: var(--bg-subtle);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .dial button { cursor: pointer; }
  .dial button:disabled { cursor: default; opacity: 0.55; }
  .dial button:hover:not(:disabled) { border-color: var(--accent); }
  .dial button:focus-visible,
  .dial select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dial__hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .dial__radio { margin-top: 0.8rem; }
  .dial__display {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.8rem;
    min-height: 2.3rem;
    padding: 0.4rem 0.7rem;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    color: #ffb648;
    background: #1b1d22;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .dial__station { color: #fff; }
  .dial__status { margin-left: auto; color: #b9b2a3; font-size: 0.85rem; }
  .dial__band { display: block; width: 100%; height: auto; cursor: pointer; }
  .dial__scale {
    position: relative;
    height: 1.3rem;
    font-size: 0.78rem;
  }
  .dial__scale span { position: absolute; transform: translateX(-50%); }
  .dial__scale span:last-child { transform: translateX(-100%); }
  .dial__lower {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.2rem;
    margin-top: 0.4rem;
  }
  .dial__knob {
    flex: none;
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .dial__knob:active { cursor: grabbing; }
  .dial__knob:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .dial__knob svg { display: block; width: 100%; height: 100%; }
  .dial__notes { flex: 1 1 16rem; min-width: 0; }
  .dial__notes p { margin: 0 0 0.4rem; font-size: 0.95rem; }
  .dial__notes .dial__key { font-size: 0.82rem; }
  .dial__on,
  .dial__off {
    display: inline-block;
    width: 0.25rem;
    height: 0.8rem;
    margin-right: 0.35rem;
    vertical-align: -0.05rem;
    background: #d68f1f;
  }
  .dial__off { margin-left: 0.8rem; background: #6e6450; }
  .dial__links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; }
</style>
