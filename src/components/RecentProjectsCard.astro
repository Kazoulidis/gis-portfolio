---
/**
 * A small card at the top of the About page's sidebar that cycles through
 * projects, one at a time. Each slide links to its project page. Two buttons
 * under it switch between the featured projects and the most recent ones.
 *
 * Cycles every few seconds, pauses while the pointer or keyboard focus is on
 * it or the tab is hidden, and never moves on its own for readers who ask for
 * reduced motion; the dots switch slides by hand either way. Without
 * JavaScript the first featured project shows and still links.
 */
import type { CollectionEntry } from 'astro:content';
import { plainTitle } from '../cv';
import { untilPublic } from '../projects';

interface Props {
  featured: CollectionEntry<'projects'>[];
  recent: CollectionEntry<'projects'>[];
  heading?: string;
  /** How many slides each set keeps once projects to come are accounted for. */
  shown?: number;
}

const { featured, recent, heading = 'Check out my projects', shown = 10 } = Astro.props;
const sets = [
  { key: 'featured', label: 'Featured', projects: featured },
  { key: 'recent', label: 'Recent', projects: recent },
].filter((set) => set.projects.length > 0);
---

{
  sets.length > 0 && (
    <section class="recent-card" data-recent-card data-shown={shown} aria-roledescription="carousel" aria-label="Projects">
      <h3 class="recent-card__heading">{heading}</h3>
      <div class="recent-card__sets">
        {sets.map((set, s) => (
          <div class="recent-card__set" data-set={set.key} aria-hidden={s === 0 ? undefined : 'true'}>
            <div class="recent-card__slides">
              {set.projects.map((project, i) => (
                <a
                  class="recent-card__slide"
                  href={`/projects/${project.id}`}
                  aria-hidden={i === 0 ? undefined : 'true'}
                  tabindex={i === 0 && s === 0 ? undefined : -1}
                  data-umami-event="recent-card"
                  data-umami-event-project={project.id}
                  data-umami-event-set={set.key}
                  {...untilPublic(project)}
                >
                  <img
                    src={project.data.thumbnail}
                    alt=""
                    width="900"
                    height="900"
                    loading={i === 0 && s === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <span class="recent-card__title">{plainTitle(project.data.title)}</span>
                  {project.data.context && <span class="recent-card__context">{project.data.context}</span>}
                </a>
              ))}
            </div>
            {set.projects.length > 1 && (
              <div class="recent-card__dots">
                <button type="button" class="recent-card__arrow" aria-label="Previous project" data-step="-1">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
                </button>
                {set.projects.map((project, i) => (
                  <button
                    type="button"
                    class="recent-card__dot"
                    aria-label={`Show ${plainTitle(project.data.title)}`}
                    aria-current={i === 0 ? 'true' : undefined}
                    {...untilPublic(project)}
                  />
                ))}
                <button type="button" class="recent-card__arrow" aria-label="Next project" data-step="1">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
                </button>
              </div>
            )}
          </div>
        ))}
      </div>
      {sets.length > 1 && (
        <div class="recent-card__modes" role="group" aria-label="Which projects to show">
          {sets.map((set, s) => (
            <button
              type="button"
              class="recent-card__mode"
              data-mode={set.key}
              aria-pressed={s === 0 ? 'true' : 'false'}
              data-umami-event="recent-card-mode"
              data-umami-event-set={set.key}
            >
              {set.label}
            </button>
          ))}
        </div>
      )}
    </section>
  )
}

<script>
  const INTERVAL = 3000;

  type Set = {
    root: HTMLElement;
    key: string | undefined;
    current: number;
    on: boolean;
    moves: boolean;
    show: (index: number) => void;
  };

  for (const card of document.querySelectorAll<HTMLElement>('[data-recent-card]')) {
    const SHOWN = Number(card.dataset.shown) || 10;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    let paused = false;
    let active: Set;

    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (active?.moves && !reduced && !paused && !document.hidden)
        timer = window.setInterval(() => active.show(active.current + 1), INTERVAL);
    };

    // One carousel per set; only the one on screen moves.
    const sets: Set[] = [];
    for (const root of card.querySelectorAll<HTMLElement>('.recent-card__set')) {
      const slides = [...root.querySelectorAll<HTMLElement>('.recent-card__slide')];
      const dots = [...root.querySelectorAll<HTMLButtonElement>('.recent-card__dot')];
      // More than SHOWN only when projects to come are in the markup.
      for (const extra of [...slides.splice(SHOWN), ...dots.splice(SHOWN)]) extra.remove();
      if (slides.length === 0) {
        root.remove();
        continue;
      }
      if (slides.length < 2) root.querySelector('.recent-card__dots')?.remove();

      const set: Set = {
        root,
        key: root.dataset.set,
        current: 0,
        on: false,
        moves: slides.length > 1,
        show(index) {
          set.current = (index + slides.length) % slides.length;
          slides.forEach((slide, i) => {
            const shown = i === set.current;
            slide.classList.toggle('is-active', shown);
            if (shown && set.on) {
              slide.removeAttribute('aria-hidden');
              slide.removeAttribute('tabindex');
            } else {
              slide.setAttribute('aria-hidden', 'true');
              slide.setAttribute('tabindex', '-1');
            }
          });
          dots.forEach((dot, i) => (i === set.current ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current')));
        },
      };
      dots.forEach((dot, i) =>
        dot.addEventListener('click', () => {
          set.show(i);
          start();
        }),
      );
      root.querySelectorAll<HTMLButtonElement>('.recent-card__arrow').forEach((arrow) =>
        arrow.addEventListener('click', () => {
          set.show(set.current + Number(arrow.dataset.step));
          start();
        }),
      );
      sets.push(set);
    }
    if (sets.length === 0) continue;

    // A set that lost all its projects takes its button with it.
    const modes = [...card.querySelectorAll<HTMLButtonElement>('.recent-card__mode')].filter((mode) => {
      if (sets.some((set) => set.key === mode.dataset.mode)) return true;
      mode.remove();
      return false;
    });
    if (modes.length < 2) card.querySelector('.recent-card__modes')?.remove();

    const choose = (key: string | undefined) => {
      active = sets.find((set) => set.key === key) ?? sets[0];
      for (const set of sets) {
        set.on = set === active;
        set.root.classList.toggle('is-on', set.on);
        if (set.on) set.root.removeAttribute('aria-hidden');
        else set.root.setAttribute('aria-hidden', 'true');
        set.show(set.on ? 0 : set.current);
      }
      modes.forEach((mode) => mode.setAttribute('aria-pressed', String(mode.dataset.mode === active.key)));
    };
    for (const mode of modes)
      mode.addEventListener('click', () => {
        choose(mode.dataset.mode);
        start();
      });

    for (const [on, off] of [['mouseenter', 'mouseleave'], ['focusin', 'focusout']] as const) {
      card.addEventListener(on, () => ((paused = true), stop()));
      card.addEventListener(off, () => ((paused = false), start()));
    }
    document.addEventListener('visibilitychange', start);

    card.classList.add('is-enhanced');
    choose(sets[0].key);
    start();
  }
</script>

<style>
  .recent-card {
    margin-bottom: 1.75rem;
    padding: 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-surface);
  }

  .recent-card .recent-card__heading {
    margin: 0 0 0.6rem;
  }

  /* Both sets, and all slides within a set, share one grid cell, so the card
     keeps the height of the tallest and nothing below it jumps as they change. */
  .recent-card__sets,
  .recent-card__slides {
    display: grid;
    /* minmax(0, 1fr), not auto: an auto column grows to fit the 900 px
       thumbnails and pushes the picture out past the card. */
    grid-template-columns: minmax(0, 1fr);
  }

  /* The dots sit at the foot of the set, so they stay put above the buttons
     whichever set, and however long a title, is showing. */
  .recent-card__set {
    grid-area: 1 / 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .recent-card__set .recent-card__dots {
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .recent-card.is-enhanced .recent-card__set:not(.is-on) {
    visibility: hidden;
  }

  /* Without JavaScript only the first set shows. */
  .recent-card:not(.is-enhanced) .recent-card__set ~ .recent-card__set {
    display: none;
  }

  .recent-card__slide {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: inherit;
    text-decoration: none;
  }

  .recent-card.is-enhanced .recent-card__slide {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s;
  }

  .recent-card.is-enhanced .recent-card__set.is-on .recent-card__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Without JavaScript only the first project shows. */
  .recent-card:not(.is-enhanced) .recent-card__slide:not([hidden]) ~ .recent-card__slide {
    display: none;
  }

  .recent-card__slide img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .recent-card__title {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--accent);
  }

  .recent-card__slide:hover .recent-card__title,
  .recent-card__slide:focus-visible .recent-card__title {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .recent-card__context {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .recent-card__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .recent-card__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 1px solid var(--text-muted);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .recent-card__dot[aria-current='true'] {
    background: var(--accent);
    border-color: var(--accent);
  }

  /* Previous / next, either side of the dots. They only work with JavaScript,
     so they appear once the card is enhanced. */
  .recent-card__arrow {
    display: none;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .recent-card.is-enhanced .recent-card__arrow {
    display: grid;
  }

  .recent-card__arrow:first-child {
    margin-right: 0.3rem;
  }

  .recent-card__arrow:last-child {
    margin-left: 0.3rem;
  }

  .recent-card__arrow:hover,
  .recent-card__arrow:focus-visible {
    color: var(--accent);
  }

  .recent-card__arrow svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Featured / Recent, under the dots. They only work with JavaScript. */
  .recent-card__modes {
    display: none;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .recent-card.is-enhanced .recent-card__modes {
    display: flex;
  }

  .recent-card__mode {
    padding: 0.2rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .recent-card__mode:hover,
  .recent-card__mode:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  .recent-card__mode[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg-surface);
  }

  @media (prefers-reduced-motion: reduce) {
    .recent-card.is-enhanced .recent-card__slide {
      transition: none;
    }
  }
</style>
