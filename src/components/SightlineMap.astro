---
/**
 * "Stand anywhere": drag a viewer around the map and see Olympus from there.
 *
 * Everything is computed in the browser from a coarse elevation grid (300 m,
 * 260 km around the summit), so it updates while the viewer is dragged:
 *   - the sightline to Mytikas, with the curve of the Earth and refraction:
 *     whether the summit is seen, how much of the mountain sits below the
 *     horizon, how much higher you would need to stand, and what is in the way
 *   - a skyline panorama centred on Olympus, ridges shaded lighter with distance
 * The map underneath is the printed map's visibility layer, from the 30 m
 * viewshed, so the coarse live answer can be read against the detailed one.
 *
 * Files (see Day_05/prep/web_data.py), named after `src`, the meta file:
 *   *-meta.json        grid size and extent, the overlay's bounds, places
 *   *-terrain.png      heights packed as R * 256 + G metres, on a summit-centred
 *                      azimuthal equidistant grid of a sphere
 *   *-visibility.png   the overlay, in Web Mercator
 */
interface Props {
  src: string;
  caption?: string;
}

const { src, caption } = Astro.props;
---

<figure class="map-figure">
  <div class="sight">
    <div class="map map--tall" data-sightmap data-src={src} role="application" aria-label={caption ?? 'Map: drag the viewer to see Olympus from anywhere'}></div>

    <div class="sight-ui" data-sight-ui hidden>
      <div class="sight-ui__row">
        <p class="sight-ui__verdict" data-sight-verdict aria-live="polite">&nbsp;</p>
        <div class="sight-ui__controls">
          <label>From
            <select data-sight-place aria-label="Jump to a place"></select>
          </label>
          <label>Eye
            <select data-sight-eye aria-label="Eye height">
              <option value="1.7" selected>standing, 1.7 m</option>
              <option value="10">a balcony, 10 m</option>
              <option value="30">a tower, 30 m</option>
              <option value="100">a drone, 100 m</option>
            </select>
          </label>
        </div>
      </div>
      <p class="sight-ui__facts" data-sight-facts>&nbsp;</p>

      <div class="sight-ui__panel">
        <div class="sight-ui__label">The view toward Olympus <span data-sight-vex></span></div>
        <canvas class="sight-ui__pano" data-sight-pano></canvas>
      </div>
      <div class="sight-ui__panel">
        <div class="sight-ui__label">The sightline, with the curve of the Earth</div>
        <canvas class="sight-ui__profile" data-sight-profile></canvas>
      </div>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import * as L from 'leaflet';
  import { whenNear } from '../lazy';
  import 'leaflet/dist/leaflet.css';

  const BASEMAP = 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}';
  const ATTRIBUTION =
    'Tiles &copy; <a href="https://www.esri.com/">Esri</a> - Esri, HERE, Garmin, ' +
    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';

  // Light bends a little around the Earth, which stretches its radius for a
  // sightline; k = 1/7 is the usual value, as on the printed map.
  const R_EFF = 6371000 / (1 - 1 / 7);
  const FOV = 60;                       // degrees across the panorama
  const START = 'Thessaloniki';         // where the viewer starts: the White Tower
  const CLASSES = [
    { label: 'Seen', rgb: '205,85,30' },
    { label: 'Up to 25 m', rgb: '238,150,75' },
    { label: '25-100 m', rgb: '248,196,135' },
    { label: '100-300 m', rgb: '252,228,196' },
  ];

  interface Place { name: string; kind: string; lat: number; lon: number; elev: number }
  interface Meta {
    summit: { lat: number; lon: number; elev: number };
    grid: { size: number; half: number; cell: number; radius: number };
    overlay: [[number, number], [number, number]];
    places: Place[];
  }

  const rad = Math.PI / 180;
  const fmt = (n: number) => Math.round(n).toLocaleString('en-GB');

  function loadImage(url: string): Promise<HTMLImageElement> {
    return new Promise((ok, fail) => {
      const img = new Image();
      img.onload = () => ok(img);
      img.onerror = () => fail(new Error(`Could not load ${url}`));
      img.src = url;
    });
  }

  async function initMap(el: HTMLElement) {
    const src = el.dataset.src;
    if (!src) return;
    const root = el.closest('.sight') as HTMLElement;
    const ui = root.querySelector('[data-sight-ui]') as HTMLElement;

    const map = L.map(el, { scrollWheelZoom: true, zoomControl: true });
    L.tileLayer(BASEMAP, { attribution: ATTRIBUTION, maxZoom: 19, maxNativeZoom: 16 }).addTo(map);
    L.control.scale({ imperial: false }).addTo(map);

    let meta: Meta;
    let terrain: HTMLImageElement;
    try {
      const res = await fetch(src);
      if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
      meta = await res.json();
      terrain = await loadImage(src.replace('-meta.json', '-terrain.png'));
    } catch (err) {
      console.error(err);
      el.insertAdjacentHTML('beforeend', '<p class="map-error">This map’s data could not be loaded.</p>');
      return;
    }

    // --- The grid: heights from the packed PNG ------------------------------
    const { size: N, half: HALF, cell: CELL, radius: RS } = meta.grid;
    const H = new Float32Array(N * N);
    {
      const c = document.createElement('canvas');
      c.width = c.height = N;
      const ctx = c.getContext('2d', { willReadFrequently: true })!;
      ctx.drawImage(terrain, 0, 0);
      const px = ctx.getImageData(0, 0, N, N).data;
      for (let i = 0; i < N * N; i++) H[i] = px[i * 4] * 256 + px[i * 4 + 1];
    }

    // Bilinear height at grid coordinates (metres from the summit, y north).
    function height(x: number, y: number): number {
      const c = (x + HALF) / CELL - 0.5;
      const r = (HALF - y) / CELL - 0.5;
      if (c < 0 || r < 0 || c >= N - 1 || r >= N - 1) return 0;
      const c0 = c | 0, r0 = r | 0, fc = c - c0, fr = r - r0, i = r0 * N + c0;
      return (H[i] * (1 - fc) + H[i + 1] * fc) * (1 - fr) + (H[i + N] * (1 - fc) + H[i + N + 1] * fc) * fr;
    }

    // Azimuthal equidistant on a sphere, centred on the summit, as the grid is.
    const p0 = meta.summit.lat * rad, l0 = meta.summit.lon * rad;
    function toGrid(lat: number, lon: number): [number, number] {
      const p = lat * rad, dl = lon * rad - l0;
      const cc = Math.sin(p0) * Math.sin(p) + Math.cos(p0) * Math.cos(p) * Math.cos(dl);
      const c = Math.acos(Math.min(1, Math.max(-1, cc)));
      const k = c < 1e-9 ? 1 : c / Math.sin(c);
      return [RS * k * Math.cos(p) * Math.sin(dl), RS * k * (Math.cos(p0) * Math.sin(p) - Math.sin(p0) * Math.cos(p) * Math.cos(dl))];
    }
    function toLatLng(x: number, y: number): L.LatLng {
      const rho = Math.hypot(x, y);
      if (rho < 1e-6) return L.latLng(meta.summit.lat, meta.summit.lon);
      const c = rho / RS;
      const p = Math.asin(Math.cos(c) * Math.sin(p0) + (y * Math.sin(c) * Math.cos(p0)) / rho);
      const l = l0 + Math.atan2(x * Math.sin(c), rho * Math.cos(p0) * Math.cos(c) - y * Math.sin(p0) * Math.sin(c));
      return L.latLng(p / rad, l / rad);
    }

    // --- Map layers ----------------------------------------------------------
    L.imageOverlay(src.replace('-meta.json', '-visibility.png'), meta.overlay, { opacity: 0.6, interactive: false }).addTo(map);
    // Fitting the overlay rounds down to a zoom that shows half the Balkans; open
    // on the stretch between Olympus and Thessaloniki instead.
    map.setView([40.4, 22.7], 8);
    const summitIcon = L.divIcon({ className: 'sight-summit', html: '<span></span>', iconSize: [14, 12], iconAnchor: [7, 10] });
    L.marker([meta.summit.lat, meta.summit.lon], { icon: summitIcon, interactive: false, keyboard: false })
      .bindTooltip('Mytikas, 2,918 m', { permanent: true, direction: 'right', className: 'sight-tip', offset: [6, -4] })
      .addTo(map);
    const line = L.polyline([], { weight: 2, interactive: false }).addTo(map);
    const obstacle = L.circleMarker([0, 0], { radius: 5, color: '#222', weight: 1.5, fillColor: '#fff', fillOpacity: 1, interactive: false });
    const viewerIcon = L.divIcon({ className: 'sight-viewer', html: '<span></span>', iconSize: [20, 20], iconAnchor: [10, 10] });
    const start = meta.places.find((p) => p.name === START) ?? meta.places[0];
    const viewer = L.marker([start.lat, start.lon], { icon: viewerIcon, draggable: true, autoPan: true, keyboard: true, title: 'Drag me' }).addTo(map);
    map.on('click', (e: L.LeafletMouseEvent) => { viewer.setLatLng(e.latlng); update(true); });
    viewer.on('drag', () => update(false));
    viewer.on('dragend', () => update(true));

    // Legend: the printed map's classes
    const legend = new L.Control({ position: 'topright' });
    legend.onAdd = () => {
      const box = L.DomUtil.create('div', 'sight-legend');
      L.DomEvent.disableClickPropagation(box);
      box.innerHTML =
        '<div class="sight-legend__title">How much higher you would need to stand</div>' +
        CLASSES.map((c) => `<div class="sight-legend__row"><span style="background:rgb(${c.rgb})"></span>${c.label}</div>`).join('') +
        '<div class="sight-legend__note">From the 30 m model of the printed map. Drag the figure, or click the map.</div>';
      return box;
    };
    legend.addTo(map);

    // --- UI --------------------------------------------------------------------
    const verdictEl = root.querySelector('[data-sight-verdict]') as HTMLElement;
    const factsEl = root.querySelector('[data-sight-facts]') as HTMLElement;
    const vexEl = root.querySelector('[data-sight-vex]') as HTMLElement;
    const placeSel = root.querySelector('[data-sight-place]') as HTMLSelectElement;
    const eyeSel = root.querySelector('[data-sight-eye]') as HTMLSelectElement;
    const pano = root.querySelector('[data-sight-pano]') as HTMLCanvasElement;
    const prof = root.querySelector('[data-sight-profile]') as HTMLCanvasElement;
    ui.hidden = false;

    const sorted = [...meta.places].filter((p) => p.kind !== 'summit').sort((a, b) => a.name.localeCompare(b.name));
    placeSel.innerHTML = '<option value="">a place...</option>' +
      sorted.map((p, i) => `<option value="${i}">${p.name}${p.kind === 'peak' ? ' (summit)' : ''}</option>`).join('');
    placeSel.addEventListener('change', () => {
      const p = sorted[Number(placeSel.value)];
      if (!p) return;
      viewer.setLatLng([p.lat, p.lon]);
      if (!map.getBounds().contains([p.lat, p.lon])) map.panTo([p.lat, p.lon]);
      update(true);
    });
    eyeSel.addEventListener('change', () => update(true));

    // Places near a point, for naming what is in the way.
    function nearest(x: number, y: number, within: number): Place | null {
      let best: Place | null = null, bd = within;
      for (const p of meta.places) {
        const [px, py] = toGrid(p.lat, p.lon);
        const d = Math.hypot(px - x, py - y);
        if (d < bd) { bd = d; best = p; }
      }
      return best;
    }

    // --- The sightline ----------------------------------------------------------
    interface Sight {
      vx: number; vy: number; D: number; ground: number; h0: number;
      seen: boolean; hidden: number; needed: number;
      ox: number; oy: number; od: number; oh: number;     // the obstacle
      d: Float32Array; h: Float32Array;
    }
    function sightline(lat: number, lon: number, eye: number): Sight {
      const [vx, vy] = toGrid(lat, lon);
      const D = Math.hypot(vx, vy);
      const ground = height(vx, vy);
      const h0 = ground + eye;
      const S = meta.summit.elev - (D * D) / (2 * R_EFF);    // the summit, lowered by the curve
      const n = Math.max(50, Math.min(1200, Math.round(D / 100)));
      const d = new Float32Array(n), h = new Float32Array(n);
      // Two maxima: everything short of the summit's own top decides whether it is
      // seen and what blocks it; only the ground short of the massif (15 km out)
      // decides how much of the mountain is below the horizon, or its own slopes
      // would count as hiding it.
      let best = -Infinity, bi = -1, fore = -Infinity, need = -Infinity;
      for (let i = 0; i < n; i++) {
        const t = (i + 1) / (n + 1);
        d[i] = t * D;
        h[i] = height(vx * (1 - t), vy * (1 - t));
        // the last 1.5 km is the summit's own slope, not an obstacle
        if (d[i] > D - 1500) continue;
        const a = h[i] - (d[i] * d[i]) / (2 * R_EFF);
        const ang = (a - h0) / d[i];
        if (ang > best) { best = ang; bi = i; }
        if (d[i] < D - 15_000 && ang > fore) fore = ang;
        // the eye height at which this point stops blocking the summit
        const H = (a / d[i] - S / D) / (1 / d[i] - 1 / D);
        if (H > need) need = H;
      }
      const sumAng = (S - h0) / D;
      const seen = sumAng >= best;
      const hidden = fore === -Infinity ? 0 : Math.max(0, h0 + fore * D + (D * D) / (2 * R_EFF));
      const t = bi >= 0 ? d[bi] / D : 0;
      return {
        vx, vy, D, ground, h0, seen, hidden: Math.min(hidden, meta.summit.elev),
        needed: Math.max(0, need - ground),
        ox: vx * (1 - t), oy: vy * (1 - t), od: bi >= 0 ? d[bi] : 0, oh: bi >= 0 ? h[bi] : 0, d, h,
      };
    }

    // --- Panorama -------------------------------------------------------------
    function drawPano(s: Sight, eye: number, fine: boolean) {
      const dpr = window.devicePixelRatio || 1;
      const cssW = pano.clientWidth, cssH = pano.clientHeight;
      const scale = fine ? dpr : Math.min(dpr, 1) * 0.5;
      const W = Math.max(100, Math.round(cssW * scale)), Hh = Math.max(60, Math.round(cssH * scale));
      pano.width = W; pano.height = Hh;
      const ctx = pano.getContext('2d')!;
      const az0 = Math.atan2(-s.vx, -s.vy);                 // toward the summit, in the grid's plane
      const angles = new Float32Array(W);
      // Sample the skyline: distance steps grow with distance, as detail shrinks.
      const steps: number[] = [];
      for (let dd = 120; dd < 300_000; dd += Math.max(CELL / 2, dd * 0.004)) steps.push(dd);
      // First pass: the skyline top, to fit the vertical scale.
      const sumAng = Math.atan((meta.summit.elev - (s.D * s.D) / (2 * R_EFF) - s.h0) / s.D) / rad;
      // Vertical range: from just below the horizon to above the higher of Olympus and the skyline.
      const cols: { a: Float32Array; sea: Uint8Array; far: Float32Array }[] = [];
      let top = Math.max(sumAng, 0.2);
      for (let j = 0; j < W; j++) {
        const az = az0 + ((j / (W - 1)) - 0.5) * FOV * rad;
        const sx = Math.sin(az), sy = Math.cos(az);
        const a = new Float32Array(steps.length), sea = new Uint8Array(steps.length);
        for (let k = 0; k < steps.length; k++) {
          const dd = steps[k];
          const hh = height(s.vx + sx * dd, s.vy + sy * dd);
          a[k] = Math.atan((hh - (dd * dd) / (2 * R_EFF) - s.h0) / dd) / rad;
          sea[k] = hh <= 0 ? 1 : 0;
          if (a[k] > top) top = a[k];
        }
        cols.push({ a, sea, far: new Float32Array(0) });
        angles[j] = 0;
      }
      const lo = -Math.max(0.25, Math.atan(Math.sqrt(2 * Math.max(s.h0, 1) / R_EFF)) / rad * 1.6);
      const hi = top + (top - lo) * 0.18;
      const img = ctx.createImageData(W, Hh);
      const px = img.data;
      const row = (a: number) => Math.max(0, Math.min(Hh, Math.round(((hi - a) / (hi - lo)) * Hh)));
      for (let j = 0; j < W; j++) {
        const { a, sea } = cols[j];
        let amax = lo - 1;
        for (let k = 0; k < steps.length; k++) {
          if (a[k] <= amax) continue;
          const r0 = row(a[k]), r1 = row(amax);
          const t = Math.min(1, steps[k] / 150_000) ** 0.7;
          let r = 77 + (204 - 77) * t, g = 84 + (214 - 84) * t, b = 92 + (230 - 92) * t;
          if (sea[k]) { r = 158; g = 199; b = 230; }
          for (let y = r0; y < r1; y++) {
            const o = (y * W + j) * 4;
            px[o] = r; px[o + 1] = g; px[o + 2] = b; px[o + 3] = 255;
          }
          amax = a[k];
        }
      }
      ctx.putImageData(img, 0, 0);
      // Olympus: a red mark where the summit is, solid if seen, open if hidden.
      const jc = (W - 1) / 2, ys = row(sumAng);
      ctx.save();
      ctx.lineWidth = Math.max(1, scale);
      ctx.strokeStyle = '#c81e2d'; ctx.fillStyle = '#c81e2d';
      ctx.beginPath(); ctx.moveTo(jc, ys); ctx.lineTo(jc - 5 * scale, ys - 8 * scale); ctx.lineTo(jc + 5 * scale, ys - 8 * scale); ctx.closePath();
      if (s.seen) ctx.fill(); else { ctx.setLineDash([2 * scale, 2 * scale]); ctx.stroke(); }
      ctx.setLineDash([]);
      ctx.font = `${11 * scale}px Georgia, serif`; ctx.textAlign = 'center'; ctx.fillStyle = '#222';
      ctx.fillText(s.seen ? 'Olympus' : 'Olympus (hidden)', jc, ys - 11 * scale);
      ctx.restore();
      // How much taller the angles are drawn than they are.
      const vex = (Hh / (hi - lo)) / (W / FOV);
      vexEl.textContent = `(${FOV}° across; heights drawn ${vex < 1.5 ? 'true to scale' : `${Math.round(vex)} times taller`})`;
    }

    // --- Profile ----------------------------------------------------------------
    function drawProfile(s: Sight, fine: boolean) {
      const dpr = fine ? window.devicePixelRatio || 1 : 1;
      const cssW = prof.clientWidth, cssH = prof.clientHeight;
      const W = Math.round(cssW * dpr), Hh = Math.round(cssH * dpr);
      prof.width = W; prof.height = Hh;
      const ctx = prof.getContext('2d')!;
      ctx.scale(dpr, dpr);
      const m = { l: 44, r: 10, t: 10, b: 24 };
      const w = cssW - m.l - m.r, hgt = cssH - m.t - m.b;
      const drop = (x: number) => (x * x) / (2 * R_EFF);
      // Heights relative to the eye's level plane; the range shows the low part well.
      const yMax = Math.max(meta.summit.elev - drop(s.D) - s.h0, 200) * 1.05;
      const yMin = Math.min(-drop(s.D) - s.h0, -50) * 1.1;
      const X = (d: number) => m.l + (d / s.D) * w;
      const Y = (v: number) => m.t + ((yMax - v) / (yMax - yMin)) * hgt;
      ctx.clearRect(0, 0, cssW, cssH);
      // sea, bent by the curve
      ctx.fillStyle = '#c4def0';
      ctx.beginPath(); ctx.moveTo(X(0), Y(yMin));
      for (let i = 0; i <= 100; i++) { const d = (i / 100) * s.D; ctx.lineTo(X(d), Y(-drop(d) - s.h0)); }
      ctx.lineTo(X(s.D), Y(yMin)); ctx.closePath(); ctx.fill();
      // ground
      ctx.fillStyle = '#8c8c8c';
      ctx.beginPath(); ctx.moveTo(X(0), Y(-s.h0));
      ctx.lineTo(X(0), Y(s.ground - s.h0));
      for (let i = 0; i < s.d.length; i++) ctx.lineTo(X(s.d[i]), Y(s.h[i] - drop(s.d[i]) - s.h0));
      ctx.lineTo(X(s.D), Y(meta.summit.elev - drop(s.D) - s.h0));
      for (let i = s.d.length - 1; i >= 0; i--) ctx.lineTo(X(s.d[i]), Y(-drop(s.d[i]) - s.h0));
      ctx.closePath(); ctx.fill();
      // the sightline: to the summit if seen, else over the obstacle
      const target = s.seen ? meta.summit.elev - drop(s.D) - s.h0 : s.hidden - drop(s.D) - s.h0;
      ctx.strokeStyle = s.seen ? '#1d7a3a' : '#c81e2d'; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(X(0), Y(0)); ctx.lineTo(X(s.D), Y(target)); ctx.stroke();
      if (!s.seen && s.od > 0) {
        ctx.fillStyle = '#fff'; ctx.strokeStyle = '#222'; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.arc(X(s.od), Y(s.oh - drop(s.od) - s.h0), 3.5, 0, 2 * Math.PI); ctx.fill(); ctx.stroke();
      }
      // axes
      ctx.strokeStyle = '#555'; ctx.lineWidth = 0.6; ctx.fillStyle = '#555';
      ctx.font = '11px system-ui, sans-serif'; ctx.textAlign = 'center';
      ctx.beginPath(); ctx.moveTo(m.l, m.t + hgt); ctx.lineTo(m.l + w, m.t + hgt); ctx.stroke();
      const km = s.D / 1000, stepKm = km > 120 ? 50 : km > 50 ? 20 : km > 20 ? 10 : 5;
      for (let k = 0; k <= km; k += stepKm) {
        ctx.beginPath(); ctx.moveTo(X(k * 1000), m.t + hgt); ctx.lineTo(X(k * 1000), m.t + hgt + 3); ctx.stroke();
        ctx.fillText(String(k), X(k * 1000), m.t + hgt + 14);
      }
      ctx.textAlign = 'right';
      ctx.fillText(`${fmt(km)} km`, m.l + w, m.t + hgt + 14 + 0.01);
      ctx.textAlign = 'left';
      ctx.fillText('you', m.l + 3, Y(0) - 4);
      ctx.textAlign = 'right';
      ctx.fillText('Mytikas', m.l + w - 2, m.t + 10);
    }

    // --- Update -----------------------------------------------------------------
    let pending = false, fineNext = false;
    function update(fine: boolean) {
      fineNext = fineNext || fine;
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        const f = fineNext; fineNext = false;
        // keep the viewer on the grid
        let ll = viewer.getLatLng();
        let [x, y] = toGrid(ll.lat, ll.lng);
        const lim = HALF - 5000;
        if (Math.abs(x) > lim || Math.abs(y) > lim) {
          x = Math.max(-lim, Math.min(lim, x)); y = Math.max(-lim, Math.min(lim, y));
          ll = toLatLng(x, y); viewer.setLatLng(ll);
        }
        const eye = Number(eyeSel.value) || 1.7;
        const s = sightline(ll.lat, ll.lng, eye);
        line.setLatLngs([ll, [meta.summit.lat, meta.summit.lon]]);
        line.setStyle({ color: s.seen ? '#1d7a3a' : '#c81e2d', dashArray: s.seen ? undefined : '6 5' });
        if (!s.seen && s.od > 0) obstacle.setLatLng(toLatLng(s.ox, s.oy)).addTo(map); else obstacle.remove();

        const km = s.D / 1000;
        if (s.D < 1500) {
          verdictEl.innerHTML = '<strong>You are on the summit.</strong>';
          factsEl.textContent = 'Drag the figure away from Olympus.';
        } else if (s.seen) {
          verdictEl.innerHTML = `<strong>Olympus is in view</strong>, ${fmt(km)} km away.`;
          factsEl.textContent = s.hidden > 1
            ? `The lowest ${fmt(s.hidden)} m of the mountain are below your horizon.`
            : 'You can see it down to its foot.';
        } else {
          const p = nearest(s.ox, s.oy, 6000);
          const what = s.oh < 1
            ? 'the curve of the sea'
            : `high ground ${fmt(s.od / 1000)} km away, ${fmt(s.oh)} m${p ? `, near ${p.name}` : ''}`;
          verdictEl.innerHTML = `<strong>Olympus is hidden</strong>, ${fmt(km)} km away, by ${what}.`;
          factsEl.textContent = s.needed < 3000
            ? `You would need to stand about ${fmt(s.needed)} m higher to see the summit.`
            : 'No realistic height would bring the summit into view.';
        }
        drawPano(s, eye, f);
        drawProfile(s, f);
      });
    }
    update(true);
    window.addEventListener('resize', () => update(true));
  }

  document.querySelectorAll<HTMLElement>('[data-sightmap]').forEach((el) => whenNear(el, () => initMap(el)));
</script>

