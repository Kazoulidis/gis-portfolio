---
/**
 * The coastline paradox, by hand: a slider walks the Greek coast with a ruler of
 * any length from 100 km down to 200 m, and the measured length keeps rising.
 *
 * The walk is the printed map's (Day_02/prep/coastline_dividers.py, walk()),
 * done here in the browser on the same EU-Hydro coast: each piece is stepped
 * along with a fixed straight ruler, and the steps are drawn as chords. Long
 * rulers cut across gulfs and miss small islands; short ones follow the bays.
 * A chart plots length against ruler: a curve filled in from walks run in the
 * background, the printed map's rulers as dots, and the full coastline (every
 * vertex) as the ceiling.
 *
 * File (see Day_02/prep/web_coast.py):
 *   *-coast.json   full_km; printed, the map's [ruler km, length km]; pieces,
 *                  each [closed, x0, y0, dx, dy, ...] in metres on the Greek
 *                  Grid (EPSG:2100), simplified to 5 m
 */
interface Props {
  src: string;
  caption?: string;
}

const { src, caption } = Astro.props;
const TICKS_KM = [100, 50, 20, 10, 5, 2, 1, 0.5, 0.2];
// Too close to the ends to label on a phone: they would run into 100 km and 200 m.
const PHONE_HIDDEN = [50, 0.5];
const KM_MAX = 100, KM_MIN = 0.2;
const pos = (km: number) => (100 * Math.log(KM_MAX / km)) / Math.log(KM_MAX / KM_MIN);
const label = (km: number) => (km >= 1 ? `${km} km` : `${km * 1000} m`);
---

<figure class="map-figure">
  <div class="ruler">
    <div class="map map--tall" data-rulermap data-src={src} role="application" aria-label={caption ?? 'Map of the Greek coast walked with a ruler of any length'}></div>

    <div class="ruler-ui" data-ruler-ui hidden>
      <div class="ruler-ui__row">
        <p class="ruler-ui__readout" aria-live="polite">
          <strong data-ruler-length>&nbsp;</strong>
          <span data-ruler-detail>&nbsp;</span>
        </p>
        <button type="button" class="ruler-ui__play" data-ruler-play>Play</button>
      </div>
      <label class="ruler-ui__slider">
        <span>Ruler length</span>
        <input type="range" min="0" max="1000" step="1" value="0" data-ruler-slider aria-label="Ruler length" />
      </label>
      <div class="ruler-ui__ticks" aria-hidden="true">
        {TICKS_KM.map((km) => (
          <span class={PHONE_HIDDEN.includes(km) ? 'is-minor' : undefined} style={`left:${pos(km).toFixed(2)}%`}>{label(km)}</span>
        ))}
      </div>
      <div class="ruler-ui__chart">
        <div class="ruler-ui__label">Measured length against ruler length</div>
        <svg data-ruler-chart viewBox="0 0 640 200" role="img" aria-label="Chart of coast length rising as the ruler gets shorter"></svg>
      </div>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import * as L from 'leaflet';
  import { whenNear } from '../lazy';
  import 'leaflet/dist/leaflet.css';

  const BASEMAP = 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}';
  const ATTRIBUTION =
    'Tiles &copy; <a href="https://www.esri.com/">Esri</a> - Esri, HERE, Garmin, ' +
    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';
  const KM_MAX = 100, KM_MIN = 0.2;
  // The printed map's rulers: 100 km yellow, 20 km orange, 5 km dark red; any
  // ruler in between gets the colour between, darker as it shortens.
  const RAMP: [number, number[]][] = [[100, [235, 185, 30]], [20, [230, 120, 40]], [5, [160, 30, 30]], [0.2, [90, 10, 30]]];
  // Divider points are drawn for rulers this long and longer; below it they
  // would be a solid line of dots.
  const DOTS_FROM_KM = 10;
  const PLAY_MS = 9000;           // 100 km down to 200 m
  const CURVE_RULERS = 32;        // walks run in the background for the chart's curve

  interface Data { full_km: number; printed: [number, number][]; pieces: number[][] }
  interface Piece { xy: Float64Array; closed: boolean }

  const fmt = (n: number) => Math.round(n).toLocaleString('en-GB');
  const kmLabel = (km: number) =>
    km >= 10 ? `${Math.round(km)} km` : km >= 1 ? `${km.toFixed(1).replace(/\.0$/, '')} km` : `${Math.round(km * 100) * 10} m`;
  const sliderKm = (v: number) => Math.exp(Math.log(KM_MAX) + (v / 1000) * Math.log(KM_MIN / KM_MAX));

  function colour(km: number): string {
    for (let i = 0; i < RAMP.length - 1; i++) {
      const [k0, c0] = RAMP[i], [k1, c1] = RAMP[i + 1];
      if (km <= k0 && km >= k1) {
        const t = (Math.log(k0) - Math.log(km)) / (Math.log(k0) - Math.log(k1));
        return `rgb(${c0.map((v, j) => Math.round(v + (c1[j] - v) * t)).join(',')})`;
      }
    }
    return `rgb(${RAMP[km > RAMP[0][0] ? 0 : RAMP.length - 1][1].join(',')})`;
  }

  /**
   * The divider walk of coastline_dividers.py, step for step: from the last
   * divider, the next is where the line first gets r away, found on the segment
   * that crosses that circle. A piece that never reaches r from its start is too
   * small for the ruler. The length is the whole steps plus the straight gap to
   * the end (back to the start on a closed ring).
   */
  function walk(p: Piece, r: number): { pts: number[]; len: number } | null {
    const v = p.xy, n = v.length / 2;
    let px = v[0], py = v[1];
    const pts = [px, py];
    let j = 1, t0 = 0;
    while (j < n) {
      const x0 = v[2 * j - 2], y0 = v[2 * j - 1], x1 = v[2 * j], y1 = v[2 * j + 1];
      const ax = x0 + t0 * (x1 - x0), ay = y0 + t0 * (y1 - y0);
      if (Math.hypot(x1 - px, y1 - py) < r) { j++; t0 = 0; continue; }
      const dx = x1 - ax, dy = y1 - ay, fx = ax - px, fy = ay - py;
      const A = dx * dx + dy * dy, B = 2 * (fx * dx + fy * dy), C = fx * fx + fy * fy - r * r;
      const s = (-B + Math.sqrt(Math.max(B * B - 4 * A * C, 0))) / (2 * A);
      const qx = ax + s * dx, qy = ay + s * dy;
      pts.push(qx, qy); px = qx; py = qy;
      const sx = x1 - x0, sy = y1 - y0, L2 = sx * sx + sy * sy;
      t0 = L2 ? ((qx - x0) * sx + (qy - y0) * sy) / L2 : 1;
    }
    if (pts.length === 2) return null;
    const ex = p.closed ? v[0] : v[2 * n - 2], ey = p.closed ? v[1] : v[2 * n - 1];
    pts.push(ex, ey);
    const k = pts.length;
    return { pts, len: (k / 2 - 2) * r + Math.hypot(pts[k - 2] - pts[k - 4], pts[k - 1] - pts[k - 3]) };
  }

  function walkAll(pieces: Piece[], r: number) {
    let total = 0, seen = 0;
    const lines: number[][] = [];
    for (const p of pieces) {
      const w = walk(p, r);
      if (!w) continue;
      total += w.len; seen++; lines.push(w.pts);
    }
    return { km: total / 1000, seen, lines };
  }

  /**
   * Greek Grid (EPSG:2100) to WGS84 latitude and longitude: the inverse
   * transverse Mercator on GRS80 (central meridian 24 degrees, scale 0.9996,
   * false easting 500,000 m), then GGRS87's shift to WGS84 (EPSG:1272) through
   * earth-centred coordinates.
   */
  const RAD = Math.PI / 180;
  const A_ = 6378137, F_ = 1 / 298.257222101, E2 = F_ * (2 - F_), EP2 = E2 / (1 - E2), K0 = 0.9996, LON0 = 24 * RAD;
  const E1 = (1 - Math.sqrt(1 - E2)) / (1 + Math.sqrt(1 - E2));
  const SHIFT = [-199.87, 74.79, 246.62];
  function toLatLng(x: number, y: number): [number, number] {
    const M = y / K0;
    const mu = M / (A_ * (1 - E2 / 4 - (3 * E2 * E2) / 64 - (5 * E2 ** 3) / 256));
    const p1 = mu + (1.5 * E1 - (27 / 32) * E1 ** 3) * Math.sin(2 * mu) + ((21 / 16) * E1 * E1 - (55 / 32) * E1 ** 4) * Math.sin(4 * mu)
      + ((151 / 96) * E1 ** 3) * Math.sin(6 * mu) + ((1097 / 512) * E1 ** 4) * Math.sin(8 * mu);
    const s1 = Math.sin(p1), c1 = Math.cos(p1), t1 = Math.tan(p1);
    const N1 = A_ / Math.sqrt(1 - E2 * s1 * s1), R1 = (A_ * (1 - E2)) / (1 - E2 * s1 * s1) ** 1.5;
    const C1 = EP2 * c1 * c1, T1 = t1 * t1, D = (x - 500000) / (N1 * K0);
    const lat = p1 - ((N1 * t1) / R1) * (D * D / 2 - ((5 + 3 * T1 + 10 * C1 - 4 * C1 * C1 - 9 * EP2) * D ** 4) / 24
      + ((61 + 90 * T1 + 298 * C1 + 45 * T1 * T1 - 252 * EP2 - 3 * C1 * C1) * D ** 6) / 720);
    const lon = LON0 + (D - ((1 + 2 * T1 + C1) * D ** 3) / 6 + ((5 - 2 * C1 + 28 * T1 - 3 * C1 * C1 + 8 * EP2 + 24 * T1 * T1) * D ** 5) / 120) / c1;
    // GGRS87 (GRS80) to WGS84: through x, y, z; the ellipsoids differ by 0.1 mm.
    const sl = Math.sin(lat), N = A_ / Math.sqrt(1 - E2 * sl * sl);
    const X = N * Math.cos(lat) * Math.cos(lon) + SHIFT[0], Y = N * Math.cos(lat) * Math.sin(lon) + SHIFT[1], Z = N * (1 - E2) * sl + SHIFT[2];
    const pr = Math.hypot(X, Y);
    let la = Math.atan2(Z, pr * (1 - E2));
    for (let i = 0; i < 3; i++) { const s = Math.sin(la); la = Math.atan2(Z + E2 * (A_ / Math.sqrt(1 - E2 * s * s)) * s, pr); }
    return [la / RAD, Math.atan2(Y, X) / RAD];
  }

  async function initMap(el: HTMLElement) {
    const src = el.dataset.src;
    if (!src) return;
    const root = el.closest('.ruler') as HTMLElement;
    const ui = root.querySelector('[data-ruler-ui]') as HTMLElement;

    const map = L.map(el, { scrollWheelZoom: true, preferCanvas: true });
    L.tileLayer(BASEMAP, { attribution: ATTRIBUTION, maxZoom: 19, maxNativeZoom: 16 }).addTo(map);
    L.control.scale({ imperial: false }).addTo(map);
    // Greece's coast, one level closer than fitting its bounds would allow on a
    // wide screen; a phone keeps the whole country in view.
    map.setView([38.4, 24.0], el.clientWidth >= 640 ? 6 : 5);

    let data: Data;
    try {
      const res = await fetch(src);
      if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
      data = await res.json();
    } catch (err) {
      console.error(err);
      el.insertAdjacentHTML('beforeend', '<p class="map-error">This map’s data could not be loaded.</p>');
      return;
    }
    const pieces: Piece[] = data.pieces.map((f) => {
      const xy = new Float64Array(f.length - 1);
      xy[0] = f[1]; xy[1] = f[2];
      for (let i = 3; i < f.length; i += 2) { xy[i - 1] = xy[i - 3] + f[i]; xy[i] = xy[i - 2] + f[i + 1]; }
      return { xy, closed: f[0] === 1 };
    });
    const base = walkAll(pieces, KM_MAX * 1000).km;     // the 100 km ruler, the yardstick in the readout

    const renderer = L.canvas({ padding: 0.3 });
    let layer: L.LayerGroup | null = null;
    const lengthEl = root.querySelector('[data-ruler-length]') as HTMLElement;
    const detailEl = root.querySelector('[data-ruler-detail]') as HTMLElement;
    const slider = root.querySelector('[data-ruler-slider]') as HTMLInputElement;
    const playBtn = root.querySelector('[data-ruler-play]') as HTMLButtonElement;
    const chart = root.querySelector('[data-ruler-chart]') as SVGSVGElement;
    ui.hidden = false;

    // --- The chart: length against ruler, ruler on a log scale, longest left ----
    const W = 640, H = 200, m = { l: 52, r: 14, t: 12, b: 26 };
    const X = (km: number) => m.l + (Math.log(KM_MAX / km) / Math.log(KM_MAX / KM_MIN)) * (W - m.l - m.r);
    const yMax = Math.ceil(data.full_km / 2000) * 2000;
    const Y = (len: number) => m.t + (1 - len / yMax) * (H - m.t - m.b);
    let svg = '';
    for (let v = 0; v <= yMax; v += 4000) {
      svg += `<line x1="${m.l}" x2="${W - m.r}" y1="${Y(v)}" y2="${Y(v)}" class="ruler-chart__grid"/>` +
        `<text x="${m.l - 6}" y="${Y(v) + 4}" text-anchor="end" class="ruler-chart__tick">${fmt(v)}</text>`;
    }
    svg += `<line x1="${m.l}" x2="${W - m.r}" y1="${Y(data.full_km)}" y2="${Y(data.full_km)}" class="ruler-chart__full"/>` +
      `<text x="${W - m.r}" y="${Y(data.full_km) - 5}" text-anchor="end" class="ruler-chart__note">every point of the coastline, ${fmt(data.full_km)} km</text>`;
    svg += data.printed.map(([km]) => `<text x="${X(km)}" y="${H - 8}" text-anchor="middle" class="ruler-chart__tick">${kmLabel(km)}</text>`).join('');
    svg += `<path class="ruler-chart__line" data-ruler-curve d="${data.printed.map(([km, len], i) => `${i ? 'L' : 'M'}${X(km).toFixed(1)},${Y(len).toFixed(1)}`).join('')}"/>`;
    svg += data.printed.map(([km, len]) => `<circle cx="${X(km)}" cy="${Y(len)}" r="3.5" fill="${colour(km)}" data-km="${km}" class="ruler-chart__pt"><title>Printed map, ${kmLabel(km)} ruler: ${fmt(len)} km</title></circle>`).join('');
    svg += `<circle r="7" class="ruler-chart__now" data-ruler-now/>`;
    chart.innerHTML = svg;
    const now = chart.querySelector('[data-ruler-now]') as SVGCircleElement;
    const curve = chart.querySelector('[data-ruler-curve]') as SVGPathElement;
    const toSlider = (km: number) => Math.round((1000 * Math.log(KM_MAX / km)) / Math.log(KM_MAX / KM_MIN));
    chart.querySelectorAll<SVGCircleElement>('.ruler-chart__pt').forEach((c) =>
      c.addEventListener('click', () => { stop(); slider.value = String(toSlider(Number(c.dataset.km))); request(); }));

    // The curve between the printed rulers, walked a few at a time so the page stays responsive.
    const curvePts: [number, number][] = [];
    let ci = 0;
    const more = () => {
      for (let k = 0; k < 3 && ci <= CURVE_RULERS; k++, ci++) {
        const km = Math.exp(Math.log(KM_MAX) + (ci / CURVE_RULERS) * Math.log(KM_MIN / KM_MAX));
        curvePts.push([km, walkAll(pieces, km * 1000).km]);
      }
      curve.setAttribute('d', curvePts.map(([km, len], i) => `${i ? 'L' : 'M'}${X(km).toFixed(1)},${Y(len).toFixed(1)}`).join(''));
      if (ci <= CURVE_RULERS) setTimeout(more, 30);
    };

    // --- Showing one ruler: walk, then draw -----------------------------------------
    function show(km: number) {
      const w = walkAll(pieces, km * 1000);
      const col = colour(km);
      const group = L.layerGroup();
      const dots = km >= DOTS_FROM_KM;
      for (const pts of w.lines) {
        const ll: L.LatLngExpression[] = [];
        for (let i = 0; i < pts.length; i += 2) ll.push(toLatLng(pts[i], pts[i + 1]));
        L.polyline(ll, { renderer, color: col, weight: km >= 1 ? 2 : 1.4, interactive: false }).addTo(group);
        if (dots) for (const p of ll) L.circleMarker(p, { renderer, radius: 2.5, color: col, weight: 1, fillColor: '#fff', fillOpacity: 1, interactive: false }).addTo(group);
      }
      group.addTo(map);
      layer?.remove();
      layer = group;
      lengthEl.textContent = `${fmt(w.km)} km of coast`;
      detailEl.textContent = `with a ${kmLabel(km)} ruler, over ${fmt(w.seen)} pieces of coast` +
        (km < KM_MAX * 0.995 ? `: ${(w.km / base).toFixed(1)} times the ${kmLabel(KM_MAX)} ruler's` : '');
      now.setAttribute('cx', String(X(km)));
      now.setAttribute('cy', String(Y(w.km)));
      now.setAttribute('stroke', col);
    }
    // One walk per frame however fast the slider moves.
    let pending = false;
    function request() {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => { pending = false; show(sliderKm(Number(slider.value))); });
    }

    // --- Play: a sweep from 100 km down to 200 m --------------------------------------
    let anim = 0, t0 = 0;
    function stop() { cancelAnimationFrame(anim); anim = 0; playBtn.textContent = 'Play'; }
    function frame(t: number) {
      const k = Math.min(1, (t - t0) / PLAY_MS);
      slider.value = String(Math.round(k * 1000));
      show(sliderKm(Number(slider.value)));
      if (k < 1) anim = requestAnimationFrame(frame); else stop();
    }
    playBtn.addEventListener('click', () => {
      if (anim) { stop(); return; }
      const start = Number(slider.value) >= 1000 ? 0 : Number(slider.value);
      t0 = performance.now() - (start / 1000) * PLAY_MS;
      playBtn.textContent = 'Pause';
      anim = requestAnimationFrame(frame);
    });
    slider.addEventListener('input', () => { stop(); request(); });

    show(KM_MAX);
    setTimeout(more, 200);
  }

  document.querySelectorAll<HTMLElement>('[data-rulermap]').forEach((el) => whenNear(el, () => initMap(el)));
</script>

<style>
  .ruler-ui {
    margin-top: 0.6rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-surface);
  }
  .ruler-ui__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    flex-wrap: wrap;
  }
  .ruler-ui__readout {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .ruler-ui__readout strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .ruler-ui__play {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.25rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--bg);
    color: var(--accent);
    cursor: pointer;
  }
  .ruler-ui__play:hover { background: var(--accent); color: var(--bg); }
  .ruler-ui__slider {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .ruler-ui__slider input { width: 100%; accent-color: var(--accent); }
  .ruler-ui__ticks {
    position: relative;
    height: 1.1rem;
    margin: 0 8px;           /* the slider thumb's half-width, so a label sits under its stop */
    font-size: 0.7rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .ruler-ui__ticks span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .ruler-ui__ticks span:first-child { transform: none; }
  .ruler-ui__ticks span:last-child { transform: translateX(-100%); }
  @media (max-width: 40rem) {
    .ruler-ui__ticks .is-minor { display: none; }
  }
  .ruler-ui__chart { margin-top: 0.7rem; }
  .ruler-ui__label {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }
  .ruler-ui__chart svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: #fff;
  }
  .ruler-ui__chart :global(.ruler-chart__grid) { stroke: #e3e3e3; stroke-width: 1; }
  .ruler-ui__chart :global(.ruler-chart__tick) { font: 11px system-ui, sans-serif; fill: #666; }
  .ruler-ui__chart :global(.ruler-chart__note) { font: 11px system-ui, sans-serif; fill: #555; }
  .ruler-ui__chart :global(.ruler-chart__full) { stroke: #888; stroke-width: 1; stroke-dasharray: 5 4; }
  .ruler-ui__chart :global(.ruler-chart__line) { fill: none; stroke: #444; stroke-width: 1.5; }
  .ruler-ui__chart :global(.ruler-chart__pt) { cursor: pointer; stroke: #fff; stroke-width: 1; }
  .ruler-ui__chart :global(.ruler-chart__now) { fill: none; stroke-width: 2.5; pointer-events: none; }
</style>
