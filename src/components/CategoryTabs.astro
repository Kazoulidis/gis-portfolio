---
/**
 * The tabs under the Projects heading. Categories come from
 * `projectCategories` in src/site.ts.
 *
 * There is deliberately no combined "All" tab: the categories are separate
 * collections rather than one pool, and a challenge with 30 entries would
 * otherwise bury everything else.
 */
import { getCollection } from 'astro:content';
import { projectCategories } from '../site';
import { isListed } from '../projects';

interface Props {
  current: string;
}

const { current } = Astro.props;

// Only categories with something published. [category].astro builds no page
// for an empty one, so a tab for it would link to a 404.
const published = await getCollection('projects', isListed);
const visible = projectCategories.filter((category) =>
  published.some((project) => project.data.category === category.slug),
);
---

<nav class="subnav" aria-label="Project categories">
  {/* 'load' rather than the site-wide 'hover' default, matching the main nav:
      there are only a few of them and they are a few KB each, so fetching them
      up front makes every tab switch a cache hit. */}
  {
    visible.map((category) => (
      <a
        href={`/projects/${category.slug}`}
        data-astro-prefetch="load"
        aria-current={current === category.slug ? 'page' : undefined}
      >
        {category.label}
      </a>
    ))
  }
</nav>
