---
/**
 * Day 16: twelve years of one person's location history as a space-time cube (Hägerstrand's time geography): the map of Greece is the floor and
 * time rises upward, so staying home draws a trunk and every trip a branch. Three.js; drag to turn it, scroll to zoom, the slider grows it.
 *
 * `src`: the JSON written by Day_16/prep/cube_data.py (the path in km and years, the floor picture, the named trips). Positions are on
 * a 1 km grid, home is moved to the centre of its 10 km square, and the page offers no download.
 */
interface Props {
  src: string;
  caption?: string;
}
const { src, caption } = Astro.props;
---

<figure class="map-figure">
  <div class="tower" data-tower data-src={src}>
    <div class="tower__stage" data-tower-stage role="img" aria-label="A 3D tower over a map of Greece: a vertical trunk rising from home over twelve years, with branches reaching out to every trip">
      <div class="tower__year" data-tower-year aria-live="polite"></div>
    </div>
    <div class="tower__controls">
      <button type="button" class="tower__play" data-tower-play aria-label="Grow the tower">&#9654;</button>
      <label class="tower__slider"><span>Up to</span><input type="range" min="0" max="1000" value="1000" data-tower-range aria-label="Show the years up to" /></label>
      <label class="tower__check"><input type="checkbox" checked data-tower-spin /> Turn slowly</label>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  /* global: the labels are made by the script, which scoped styles do not reach */
  .tower__stage { position: relative; width: 100%; aspect-ratio: 4 / 5; max-height: 86vh; background: #0b0d12; border: 1px solid var(--rule, #d9d4c8); overflow: hidden; cursor: grab; touch-action: none; }
  .tower__stage:active { cursor: grabbing; }
  .tower__stage canvas { display: block; }
  .tower__year { position: absolute; left: 1rem; top: 0.8rem; z-index: 2; color: #f3efe6; font-size: clamp(1.4rem, 4vw, 2.2rem); font-weight: 700; font-variant-numeric: tabular-nums; pointer-events: none; }
  .tower__label { color: #f3efe6; font-size: 0.74rem; line-height: 1.15; white-space: nowrap; text-shadow: 0 0 4px #000, 0 0 2px #000; pointer-events: none; }
  .tower__label b { font-weight: 700; }
  .tower__label span { opacity: 0.75; }
  .tower__tick { color: #9aa3b0; font-size: 0.68rem; font-variant-numeric: tabular-nums; pointer-events: none; text-shadow: 0 0 3px #000; }
  .tower__controls { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; margin-top: 0.6rem; font-size: 0.9rem; }
  .tower__play { width: 2.2rem; height: 2.2rem; border-radius: 50%; border: 1px solid #b9b2a3; background: #f6f4ee; cursor: pointer; }
  .tower__slider { flex: 1 1 14rem; display: flex; gap: 0.6rem; align-items: center; }
  .tower__slider input { flex: 1; accent-color: #c0623a; }
  .tower__check { display: flex; gap: 0.35rem; align-items: center; }
</style>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { CSS2DRenderer, CSS2DObject } from 'three/examples/jsm/renderers/CSS2DRenderer.js';
  import { Line2 } from 'three/examples/jsm/lines/Line2.js';
  import { LineMaterial } from 'three/examples/jsm/lines/LineMaterial.js';
  import { LineGeometry } from 'three/examples/jsm/lines/LineGeometry.js';
  import { LineSegments2 } from 'three/examples/jsm/lines/LineSegments2.js';
  import { LineSegmentsGeometry } from 'three/examples/jsm/lines/LineSegmentsGeometry.js';
  import { whenNear } from '../lazy';

  type Meta = { size_km: number; t0: number; t1: number; n: number; path: string; floor: string; heights: string; trips: number; wide?: { size_km: number; floor: string; heights: string };
    labels: { name: string; x: number; y: number; t: number; when: string; km: number; days: number; far?: boolean }[] };
  const box = document.querySelector<HTMLElement>('[data-tower]');
  if (box) whenNear(box, () => { void start(box); });

  // a warm ramp up the years: deep blue, teal, gold, coral
  const RAMP = [[0.25, 0.42, 0.95], [0.18, 0.78, 0.82], [0.98, 0.82, 0.32], [0.98, 0.42, 0.33]];
  const ramp = (f: number) => { const s = Math.min(0.999, Math.max(0, f)) * (RAMP.length - 1), i = Math.floor(s), k = s - i; return RAMP[i].map((c, j) => c + (RAMP[i + 1][j] - c) * k); };

  async function start(root: HTMLElement) {
    const $ = <T extends Element>(n: string) => root.querySelector<T>(`[data-tower-${n}]`)!;
    const meta: Meta = await (await fetch(root.dataset.src!)).json();
    const raw = Uint8Array.from(atob(meta.path), (c) => c.charCodeAt(0));
    const P = new Float32Array(raw.buffer);                                // x km, y km, year, gap
    const S = meta.size_km, HEIGHT = S * 1.15, half = S / 2;
    const EX = 10, BASE = 2.9 * EX + 8;                                  // the relief 10 times exaggerated; the tower starts just above its peaks
    const Y = (t: number) => BASE + ((t - meta.t0) / (meta.t1 - meta.t0)) * HEIGHT;
    const stage = $<HTMLElement>('stage');

    const renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
    renderer.setPixelRatio(Math.min(2, window.devicePixelRatio)); renderer.setClearColor(0x0b0d12);
    stage.append(renderer.domElement);
    const labelR = new CSS2DRenderer(); labelR.domElement.style.position = 'absolute'; labelR.domElement.style.inset = '0'; labelR.domElement.style.pointerEvents = 'none';
    stage.append(labelR.domElement);
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 10, 20000);
    camera.position.set(S * 1.7, HEIGHT * 0.8, S * 2.1);
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.target.set(0, HEIGHT * 0.47, 0); controls.enableDamping = true; controls.minDistance = S * 0.6; controls.maxDistance = S * 3.2;   // no further out than the fog hides the floor's edges
    controls.maxPolarAngle = Math.PI * 0.49; controls.autoRotate = true; controls.autoRotateSpeed = 0.35; controls.enablePan = false;

    // the floor: Greece in grey relief
    // the floor: Greece and its neighbours in relief, a 512 x 512 surface lifted by the heights (metres in red and green), shaded by the picture
    // a wide floor round the same centre, its edges lost in fog
    const wide = meta.wide ?? null;                                     // the wide floor everywhere: no square edge in sight
    const FS = wide ? wide.size_km : S;
    if (wide) scene.fog = new THREE.Fog(0x0b0d12, S * 2.4, S * 3.3);   // the camera is about 3.4 S away: Greece clear, the far edges gone
    const himg = new Image(); himg.src = wide ? wide.heights : meta.heights; await himg.decode();
    const hc = document.createElement('canvas'); hc.width = himg.naturalWidth; hc.height = himg.naturalHeight;
    const hx_ = hc.getContext('2d', { willReadFrequently: true })!; hx_.drawImage(himg, 0, 0);
    const hp = hx_.getImageData(0, 0, hc.width, hc.height).data, M = hc.width;
    const fg = new THREE.PlaneGeometry(FS, FS, M - 1, M - 1);              // vertices row by row from the top (north), as the picture
    const fpos = fg.attributes.position as THREE.BufferAttribute;
    for (let k = 0; k < fpos.count; k++) fpos.setZ(k, ((hp[k * 4] << 8) | hp[k * 4 + 1]) / 1000 * EX);
    fpos.needsUpdate = true;
    const floor = new THREE.Mesh(fg, new THREE.MeshBasicMaterial({ map: (() => { const tx = new THREE.TextureLoader().load(wide ? wide.floor : meta.floor); tx.colorSpace = THREE.SRGBColorSpace; tx.anisotropy = 8; return tx; })(), color: 0xffffff }));
    floor.rotation.x = -Math.PI / 2; scene.add(floor);
    // beyond the floor, the background colour to the horizon, so its square edge never shows against the clear colour
    if (wide) { const under = new THREE.Mesh(new THREE.PlaneGeometry(S * 40, S * 40), new THREE.MeshBasicMaterial({ color: 0x0b0d12, fog: false })); under.rotation.x = -Math.PI / 2; under.position.y = -0.5; scene.add(under); }

    // the path, in one line; the record's gaps faint; colour by year
    const pos: number[] = [], col: number[] = [];
    const home = [0, 0]; { const c = new Map<string, number>(); for (let i = 0; i < meta.n; i++) { const k = P[i * 4] + ',' + P[i * 4 + 1]; c.set(k, (c.get(k) || 0) + 1); } const [hk] = [...c.entries()].sort((a, b) => b[1] - a[1])[0]; const [a, b] = hk.split(',').map(Number); home[0] = a; home[1] = b; }
    for (let i = 0; i < meta.n; i++) {
      const x = P[i * 4] - half, z = -(P[i * 4 + 1] - half), t = P[i * 4 + 2], g = P[i * 4 + 3];
      pos.push(x, Y(t), z);
      // 1: the record is missing before this point (faint); 2: beyond 450 km, drawn in the dashed line below instead (black adds nothing)
      const far = g === 2 || (i > 0 && P[(i - 1) * 4 + 3] === 2);
      const c = ramp((t - meta.t0) / (meta.t1 - meta.t0)), dim = far ? 0 : g === 1 ? 0.28 : 1;
      col.push(c[0] * dim, c[1] * dim, c[2] * dim);
    }
    const geo = new LineGeometry(); geo.setPositions(pos); geo.setColors(col);
    const mat = new LineMaterial({ vertexColors: true, linewidth: 2, transparent: true, opacity: 0.7, blending: THREE.AdditiveBlending, depthWrite: false, fog: false });
    const glowMat = new LineMaterial({ vertexColors: true, linewidth: 7, transparent: true, opacity: 0.09, blending: THREE.AdditiveBlending, depthWrite: false, fog: false });
    const line = new Line2(geo, mat), glow = new Line2(geo, glowMat);
    scene.add(glow, line);
    // the trips abroad: distance compressed beyond 450 km, so drawn dashed
    const apos: number[] = [], acol: number[] = [], fT: number[] = [];
    for (let i = 1; i < meta.n; i++) {
      if (P[i * 4 + 3] !== 2 && P[(i - 1) * 4 + 3] !== 2) continue;
      for (const k of [i - 1, i]) {
        apos.push(P[k * 4] - half, Y(P[k * 4 + 2]), -(P[k * 4 + 1] - half));
        const c = ramp((P[k * 4 + 2] - meta.t0) / (meta.t1 - meta.t0)); acol.push(c[0], c[1], c[2]);
      }
      fT.push(P[i * 4 + 2]);
    }
    const fgeo = new LineSegmentsGeometry(); fgeo.setPositions(apos); fgeo.setColors(acol);
    const fmat = new LineMaterial({ vertexColors: true, linewidth: 2, dashed: true, dashSize: 14, gapSize: 9, transparent: true, opacity: 0.85, blending: THREE.AdditiveBlending, depthWrite: false, fog: false });
    const farLine = new LineSegments2(fgeo, fmat); farLine.computeLineDistances(); scene.add(farLine);

    // the years, as ticks up the trunk
    const hx = home[0] - half, hz = -(home[1] - half);
    // turn round the trunk, not the middle of the map; the camera keeps its angle and distance
    controls.target.set(hx, Y((meta.t0 + meta.t1) / 2) * 0.92, hz); camera.position.set(hx + S * 1.7, HEIGHT * 0.8, hz + S * 2.1);
    const ticks: { yr: number; objs: THREE.Object3D[] }[] = [];
    for (let yr = Math.ceil(meta.t0); yr <= Math.floor(meta.t1); yr++) {
      const r = new THREE.Mesh(new THREE.RingGeometry(9, 10.5, 48), new THREE.MeshBasicMaterial({ color: 0x5b6472, side: THREE.DoubleSide, transparent: true, opacity: 0.8 }));
      r.rotation.x = -Math.PI / 2; r.position.set(hx, Y(yr), hz); scene.add(r);
      const el = document.createElement('div'); el.className = 'tower__tick'; el.textContent = String(yr);
      const o = new CSS2DObject(el); o.position.set(hx - 22, Y(yr), hz); scene.add(o);
      ticks.push({ yr, objs: [r, o] });
    }
    // the trips worth naming, at the far end of each branch
    const seen = new Set<string>(); let farN = 0;
    const tags = meta.labels.filter((l) => !seen.has(l.name) && (seen.add(l.name), true)).map((l) => {   // one label a place: its biggest trip
      const el = document.createElement('div'); el.className = 'tower__label';
      el.innerHTML = '<b></b><br><span></span>'; el.querySelector('b')!.textContent = l.name; el.querySelector('span')!.textContent = `${l.when}, ${l.km.toLocaleString('en-GB')} km${l.far ? ', not to scale' : ''}`;
      const o = new CSS2DObject(el); o.position.set(l.x - half, Y(l.t), -(l.y - half));
      o.center.set(-0.05, l.far ? (farN++ % 2 ? -0.6 : 1.6) : 0.5); scene.add(o);   // the two trips abroad end close together: one label above its branch, one below
      return { o, t: l.t };
    });

    function resize() {
      const w = stage.clientWidth, h = stage.clientHeight;
      renderer.setSize(w, h, false); renderer.domElement.style.width = '100%'; renderer.domElement.style.height = '100%';
      labelR.setSize(w, h); camera.aspect = w / h; camera.updateProjectionMatrix();
      mat.resolution.set(w, h); glowMat.resolution.set(w, h); fmat.resolution.set(w, h);
    }
    new ResizeObserver(resize).observe(stage); resize();

    // up to a year: how much of the line is drawn
    const range = $<HTMLInputElement>('range'), yearEl = $<HTMLElement>('year');
    const tAt = (v: number) => meta.t0 + (meta.t1 - meta.t0) * v / 1000;
    function upTo(t: number) {
      let k = 0; while (k < meta.n && P[k * 4 + 2] <= t) k++;
      geo.instanceCount = Math.max(0, k - 1);
      let f = 0; while (f < fT.length && fT[f] <= t) f++; fgeo.instanceCount = f;
      tags.forEach((g) => { g.o.visible = g.t <= t; });
      ticks.forEach((k) => k.objs.forEach((o) => { o.visible = k.yr <= t; }));
      yearEl.textContent = String(Math.min(Math.floor(t), Math.floor(meta.t1)));
    }
    range.addEventListener('input', () => { playing = false; upTo(tAt(Number(range.value))); });
    let playing = false, last = 0;
    $<HTMLButtonElement>('play').addEventListener('click', () => { playing = true; range.value = '0'; last = performance.now(); });
    const spin = $<HTMLInputElement>('spin'); spin.addEventListener('change', () => { controls.autoRotate = spin.checked; });
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) { controls.autoRotate = false; spin.checked = false; }
    upTo(meta.t1);
    (window as any).__tower = { upTo, controls, camera, render: () => { controls.update(); renderer.render(scene, camera); labelR.render(scene, camera); }, HEIGHT, S, trunk: [hx, hz], Y, meta: { t0: meta.t0, t1: meta.t1 }, scene };

    function frame(now: number) {
      if (playing) {
        const v = Math.min(1000, Number(range.value) + (now - last) / 12); last = now;   // twelve years in twelve seconds
        range.value = String(v); upTo(tAt(v)); if (v >= 1000) playing = false;
      }
      controls.update(); renderer.render(scene, camera); labelR.render(scene, camera);
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
</script>
