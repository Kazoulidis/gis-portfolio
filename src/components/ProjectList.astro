---
/**
 * The list of projects, shared by /projects and each /projects/<category> page
 * so the two can never drift apart.
 */
import type { CollectionEntry } from 'astro:content';
import { untilPublic } from '../projects';
import { plainTitle } from '../cv';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** Shown when the list is empty - e.g. a category with nothing in it yet. */
  emptyMessage?: string;
  /** Drop the "Day 22 - Projections: " lead from challenge titles; off only on the challenge's own tab. */
  plain?: boolean;
}

const { projects, emptyMessage = 'No projects published yet.', plain = false } = Astro.props;
---

{
  projects.length === 0 ? (
    <p class="muted">{emptyMessage}</p>
  ) : (
    <ul class="project-list">
      {projects.map((project) => (
        <li class="project-item" {...untilPublic(project)}>
          <div>
            {project.data.thumbnail ? (
              <a href={`/projects/${project.id}`}>
                <img
                  class="project-item__thumb"
                  src={project.data.thumbnail}
                  alt={project.data.thumbnailAlt ?? ''}
                  loading="lazy"
                  width="416"
                  height="416"
                />
              </a>
            ) : (
              <span class="project-item__thumb" aria-hidden="true" />
            )}
          </div>
          <div>
            <h2 class="project-item__title">
              <a href={`/projects/${project.id}`}>{plain ? plainTitle(project.data.title) : project.data.title}</a>
            </h2>
            <p class="project-item__meta">
              {/* The full publication date. UTC: frontmatter dates parse as UTC midnight,
                  so a local date is a day early on any machine west of Greenwich. */}
              <time datetime={project.data.date.toISOString().slice(0, 10)}>
                {project.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
              </time>
              {/* The challenge's "· Day 27" is left off here: the date above already places it. */}
              {project.data.context && <> &middot; {project.data.context.replace(/\s*·\s*Day \d+$/, '')}</>}
            </p>
            <p>{project.data.summary}</p>
            {project.data.tags.length > 0 && (
              <ul class="tags">
                {project.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  .project-item__title {
    margin-top: 0;
  }
</style>
