---
/**
 * Day 8: every 100 m of Crete against the seven rules from Plato's Laws. Click the map or pick a place, and the page reads
 * that cell from a lossless PNG (R: one bit a rule; G: territory radius in half kilometres; B: 255 on Crete), lists what
 * passes and draws the territory. The picture and the PNG share one grid, so a position on one is a position on the other.
 *
 * File (`src`, under public/):
 *   *-rules.json   { rules, picture, alt, width, height, kmPerPixel, places: [{name, x, y}] }
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  src: string;
  caption?: string;
}
interface Place { name: string; x: number; y: number }
interface Meta { rules: string; picture: string; alt: string; width: number; height: number; kmPerPixel: number; places: Place[] }

const { src, caption } = Astro.props;
const data: Meta = JSON.parse(readFileSync(join(process.cwd(), 'public', src), 'utf-8'));
const RULES = [
  'About 80 stadia from the sea',
  'Excellent harbours in the territory',
  'More rock than plain',
  'Nothing in abundance',
  'Little timber',
  'City at the centre of its farmland',
  'A fit site for a city',
];
const RAMP = ['#f7f3e8', '#f0e7cd', '#e8d6aa', '#e2be80', '#de9e5c', '#d67642', '#be4634', '#960f23'];
---

<figure class="map-figure">
  <div class="rules" data-rules data-png={data.rules} data-width={data.width} data-height={data.height}
       data-km={data.kmPerPixel} data-start={JSON.stringify(data.places[0])}>
    <div class="rules__map" data-rules-map style={`aspect-ratio: ${data.width} / ${data.height}`}>
      <img src={data.picture} alt={data.alt} width={data.width} height={data.height} decoding="async" />
      <svg viewBox={`0 0 ${data.width} ${data.height}`} aria-hidden="true">
        <circle data-rules-territory fill="none" stroke="#111" stroke-width="10" vector-effect="non-scaling-stroke" style="stroke-width: 1.5px" visibility="hidden" />
        <circle data-rules-point r="22" fill="#111" stroke="#fff" stroke-width="8" visibility="hidden" />
      </svg>
    </div>
    <div class="rules__scale" aria-hidden="true">
      <span>Rules met</span>
      {RAMP.map((colour, i) => <span class="rules__step" style={`background: ${colour}; color: ${i > 5 ? '#fff' : '#222'}`}>{i}</span>)}
    </div>
    <div class="rules__places">
      {data.places.map((p) => <button type="button" data-x={p.x} data-y={p.y}>{p.name}</button>)}
    </div>
    <div class="rules__answer" aria-live="polite">
      <p class="rules__head" data-rules-head>Click anywhere on Crete.</p>
      <ul>
        {RULES.map((rule) => <li data-rule>{rule}</li>)}
      </ul>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-rules]')) {
    const map = box.querySelector<HTMLElement>('[data-rules-map]')!;
    const head = box.querySelector<HTMLElement>('[data-rules-head]')!;
    const items = [...box.querySelectorAll<HTMLElement>('[data-rule]')];
    const point = box.querySelector<SVGCircleElement>('[data-rules-point]')!;
    const territory = box.querySelector<SVGCircleElement>('[data-rules-territory]')!;
    const width = Number(box.dataset.width);
    const height = Number(box.dataset.height);
    const km = Number(box.dataset.km);
    let cells: Uint8ClampedArray | null = null;

    const show = (x: number, y: number, name?: string) => {
      if (!cells) return;
      const i = (y * width + x) * 4;
      const [bits, radius, land] = [cells[i], cells[i + 1], cells[i + 2]];
      point.setAttribute('cx', String(x + 0.5));
      point.setAttribute('cy', String(y + 0.5));
      point.setAttribute('visibility', 'visible');
      if (!land) {
        head.textContent = 'That is the sea. Click on Crete.';
        territory.setAttribute('visibility', 'hidden');
        items.forEach((li) => li.removeAttribute('data-pass'));
        return;
      }
      let count = 0;
      items.forEach((li, k) => {
        const pass = (bits >> k) & 1;
        count += pass;
        li.setAttribute('data-pass', pass ? 'yes' : 'no');
      });
      head.textContent = `${name ? name + ': ' : ''}${count} of 7 rules${radius ? `, with a territory ${(radius / 2).toFixed(1)} km round the city` : ''}`;
      if (radius) {
        territory.setAttribute('cx', String(x + 0.5));
        territory.setAttribute('cy', String(y + 0.5));
        territory.setAttribute('r', String(radius / 2 / km));
        territory.setAttribute('visibility', 'visible');
      } else {
        territory.setAttribute('visibility', 'hidden');
      }
    };

    map.addEventListener('click', (event) => {
      const r = map.getBoundingClientRect();
      const x = Math.min(width - 1, Math.max(0, Math.floor(((event.clientX - r.left) / r.width) * width)));
      const y = Math.min(height - 1, Math.max(0, Math.floor(((event.clientY - r.top) / r.height) * height)));
      show(x, y);
    });
    box.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
      b.addEventListener('click', () => show(Number(b.dataset.x), Number(b.dataset.y), b.textContent ?? ''));
    });

    // Read only when the map comes near: the file is a few hundred kB and most readers stop at the printed map.
    const load = () => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d', { colorSpace: 'srgb', willReadFrequently: true })!;
        ctx.drawImage(img, 0, 0);
        cells = ctx.getImageData(0, 0, width, height).data;
        const start = JSON.parse(box.dataset.start!);
        show(start.x, start.y, start.name);
      };
      img.onerror = () => { head.textContent = 'The rule map could not be loaded.'; };
      img.src = box.dataset.png!;
    };
    new IntersectionObserver((entries, observer) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      load();
    }, { rootMargin: '400px' }).observe(box);
  }
</script>

<style>
  .rules__map {
    position: relative;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: #cfe3ee;
    cursor: crosshair;
  }
  .rules__map img,
  .rules__map svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .rules__scale {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    margin-top: 0.6rem;
    font-size: 0.82rem;
  }
  .rules__scale > :first-child { margin-right: 0.5rem; }
  .rules__step {
    width: 1.7rem;
    text-align: center;
    border-radius: 2px;
  }
  .rules__places {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .rules__places button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.2rem 0.6rem;
    color: var(--text, inherit);
    background: var(--bg-subtle);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .rules__places button:hover { border-color: var(--accent); }
  .rules__places button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .rules__answer { margin-top: 0.8rem; }
  .rules__head { margin: 0 0 0.4rem; font-weight: 600; }
  .rules__answer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.15rem 1rem;
    font-size: 0.92rem;
  }
  .rules__answer li { padding-left: 1.4rem; position: relative; }
  .rules__answer li::before { content: '\2013'; position: absolute; left: 0; }
  .rules__answer li[data-pass='yes']::before { content: '\2713'; color: #2f7d4f; font-weight: 700; }
  .rules__answer li[data-pass='no'] { opacity: 0.6; }
  .rules__answer li[data-pass='no']::before { content: '\2717'; color: #be2633; font-weight: 700; }
</style>
