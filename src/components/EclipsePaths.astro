---
/**
 * Day 17: every central eclipse of the Sun over Greece, 500 BC to AD 2500, one at a time, on a Leaflet map. For the chosen eclipse the page
 * works out, from its Besselian elements, the largest share of the Sun the Moon covers at each place (the same method as
 * Day_17/prep/eclipse_paths.py), shades it and draws its contours, the path of totality or annularity and its centre line, and the map's
 * camera moves to the centre line; Play, or the time slider, moves the Moon's shadow across the map minute by minute.
 *
 * The shading is worked out on a grid over the map's view, a node every few pixels, so it stays sharp at any zoom: when the view changes the
 * grid is laid again. Two canvases hold it, one under the path (the coverage) and one over it (the umbra), in their own panes.
 *
 * `src`: the JSON written by Day_17/prep/page_data.py (the area, cities, eclipses with their paths and elements, in latitude and longitude).
 */
interface Props {
  src: string;
  caption?: string;
}
const { src, caption } = Astro.props;
---

<figure class="map-figure">
  <div class="ecl" data-ecl data-src={src}>
    <div class="ecl__controls">
      <div class="ecl__row ecl__row--pick">
        <span class="ecl__pick">
          <button type="button" class="ecl__btn ecl__btn--step" data-ecl-prev aria-label="The eclipse before">&#8249;</button>
          <span class="ecl__list">
            <button type="button" class="ecl__btn ecl__open" data-ecl-open aria-haspopup="listbox" aria-expanded="false" aria-label="Choose an eclipse"><span data-ecl-current></span><i aria-hidden="true">&#9662;</i></button>
            <ul class="ecl__options" data-ecl-options role="listbox" aria-label="Eclipses, by century" tabindex="-1" hidden></ul>
          </span>
          <button type="button" class="ecl__btn ecl__btn--step" data-ecl-next aria-label="The eclipse after">&#8250;</button>
        </span>
        <span class="ecl__types" data-ecl-types>
          <label><input type="checkbox" value="T" checked /> Total</label>
          <label><input type="checkbox" value="A" checked /> Annular</label>
          <label><input type="checkbox" value="H" checked /> Hybrid</label>
          <label><input type="checkbox" data-ecl-land checked /> Over Greek land only</label>
        </span>
      </div>
    </div>
    <div class="ecl__read" aria-live="polite">
      <p class="ecl__title" data-ecl-title></p>
      <p class="ecl__sub" data-ecl-sub></p>
    </div>
    <div class="ecl__row ecl__row--time">
      <button type="button" class="ecl__btn" data-ecl-play>&#9654; Play</button>
      <input type="range" min="0" max="1000" step="1" value="0" data-ecl-time aria-label="Time during the eclipse: drag to move the Moon's shadow across the map" />
      <button type="button" class="ecl__btn" data-ecl-whole>Whole eclipse</button>
    </div>
    <div class="ecl__stage" data-ecl-stage>
      <div class="ecl__map" data-ecl-map role="img" aria-label="Map of Greece with the chosen eclipse: its path, centre line and how much of the Sun it covered"></div>
      <div class="ecl__clock" data-ecl-clock hidden></div>
    </div>
    <div class="ecl__foot">
      <div class="ecl__legend" aria-hidden="true">
        <span class="ecl__ramp"></span>
        <span class="ecl__ticks"><em>Sun covered: 0%</em><em>50%</em><em>100%</em></span>
        <span class="ecl__key"><i class="ecl__key-path"></i> Path of totality or annularity, with its centre line</span>
      </div>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  /* global: the labels are written by the script, which scoped styles do not reach */
  .ecl { max-width: 760px; margin: 0 auto; }                      /* smaller than the column: the map and its controls together */
  .ecl__controls { display: grid; gap: 0.5rem; margin-bottom: 0.5rem; }
  .ecl__row { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; align-items: center; }
  .ecl__row input[type='range'] { width: 100%; accent-color: #2a2648; }
  .ecl__row--pick { grid-template-columns: auto 1fr; font-size: 0.88rem; }
  .ecl__row--time { grid-template-columns: auto 1fr auto; margin-bottom: 0.5rem; }
  .ecl__pick { display: flex; gap: 0.3rem; align-items: center; }
  /* the list of eclipses: drawn on the page, not the browser's own, so it looks the same everywhere (and in the demo video) */
  .ecl__list { position: relative; }
  .ecl__open { display: inline-flex; gap: 0.5rem; align-items: center; min-width: 14.5rem; justify-content: space-between; }
  .ecl__open i { font-style: normal; font-size: 0.75rem; }
  .ecl__options { position: absolute; left: 0; top: calc(100% + 3px); z-index: 1100; width: 16rem; max-height: 17rem; overflow-y: auto; margin: 0; padding: 0.2rem 0;
    list-style: none; background: #f7f4ec; border: 1px solid #2a2648; border-radius: 3px; box-shadow: 0 6px 18px rgba(22, 20, 44, 0.22); font-size: 0.85rem; }
  .ecl__options li { padding: 0.18rem 0.7rem; cursor: pointer; white-space: nowrap; }
  .ecl__options li[role='option']:hover, .ecl__options li.is-active { background: #2a2648; color: #f7f4ec; }
  .ecl__options li[aria-selected='true'] { font-weight: 700; }
  .ecl__options li.ecl__group { padding-top: 0.45rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; opacity: 0.6; cursor: default; }
  .ecl__btn--step { padding: 0.1rem 0.55rem; font-size: 1rem; line-height: 1.2; }
  .ecl__types { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; justify-content: flex-end; }
  .ecl__types label { white-space: nowrap; }
  .ecl__btn { font: inherit; font-size: 0.88rem; padding: 0.25rem 0.75rem; border: 1px solid #2a2648; background: #f7f4ec; color: #23232a; border-radius: 3px; cursor: pointer; white-space: nowrap; }
  .ecl__btn:hover { background: #2a2648; color: #f7f4ec; }
  .ecl__read { min-height: 4.1rem; margin-bottom: 0.4rem; text-align: center; }
  .ecl__title { margin: 0; font-size: 1.05rem; font-weight: 700; }
  .ecl__sub { margin: 0; font-size: 0.85rem; opacity: 0.85; }
  .ecl__stage { position: relative; width: 100%; aspect-ratio: 3 / 2; max-height: 440px; border: 1px solid var(--rule, #d9d4c8); }
  .ecl__map { position: absolute; inset: 0; background: #dee2e6; }
  .ecl__cv { position: absolute; left: 0; top: 0; pointer-events: none; }
  .ecl__label { background: none; border: 0; }
  .ecl__label div { position: absolute; left: 0; bottom: 0; transform: translateX(-50%); padding-bottom: 6px; font-size: clamp(0.6rem, 1.5vw, 0.8rem); line-height: 1.15;
    text-align: center; color: #23232a; text-shadow: 0 0 3px #f7f4ec, 0 0 3px #f7f4ec, 0 0 2px #f7f4ec; white-space: nowrap; }
  .ecl__label div::after { content: ''; position: absolute; left: 50%; bottom: 0; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #23232a; box-shadow: 0 0 0 1.5px #f7f4ec; }
  .ecl__label b { font-weight: 700; }
  .ecl__label span { display: block; font-variant-numeric: tabular-nums; }
  .ecl__clock { position: absolute; left: 0.6rem; bottom: 1.6rem; z-index: 1000; padding: 0.15rem 0.45rem; font-size: 0.85rem; font-variant-numeric: tabular-nums; background: rgba(247, 244, 236, 0.9); color: #23232a; border-radius: 3px; pointer-events: none; }
  .ecl__foot { margin-top: 0.5rem; }
  .ecl__legend { display: grid; gap: 0.15rem; font-size: 0.72rem; }
  .ecl__ramp { display: block; height: 0.6rem; background: linear-gradient(to right, rgba(22, 20, 44, 0) 50%, rgba(22, 20, 44, 0.08) 70%, rgba(22, 20, 44, 0.18) 80%, rgba(22, 20, 44, 0.37) 90%, rgba(22, 20, 44, 0.7));   /* 0.7 x coverage^6, as drawn */ border: 1px solid #c9c4b8; }
  .ecl__ticks { display: flex; justify-content: space-between; }
  .ecl__ticks em { font-style: normal; opacity: 0.8; }
  .ecl__key { display: flex; align-items: center; gap: 0.4rem; }
  .ecl__key-path { display: inline-block; width: 1.6rem; height: 0.6rem; background: rgba(22, 20, 44, 0.85); background-image: linear-gradient(transparent 45%, #f7f4ec 45%, #f7f4ec 55%, transparent 55%); }
  @media (max-width: 560px) {
    .ecl__row--pick { grid-template-columns: 1fr; }
    .ecl__types { justify-content: flex-start; }
  }
</style>

<script>
  import * as L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { whenNear } from '../lazy';

  type El = { t0: number; tmin: number; tmax: number; dt: number; x: number[]; y: number[]; d: number[]; mu: number[]; l1: number[]; l2: number[]; f1: number; f2: number };
  type LL = [number, number];
  type Ecl = { id: number; year: number; era: string; month: number; day: number; type: 'T' | 'A' | 'H'; land: boolean; dur: string;
    path: LL[][]; centre: LL[][]; el: El };
  type Data = { area: [LL, LL]; cities: { name: string; lat: number; lon: number }[]; eclipses: Ecl[] };

  const BASEMAP = 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}';
  const ATTRIBUTION = 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ · Eclipse Predictions by Fred Espenak, NASA’s GSFC';
  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const TYPES = { T: 'Total', A: 'Annular', H: 'Hybrid' } as const;
  // the eclipses writers recorded (astronomical years: -462 is 463 BC)
  const NOTES: Record<number, string> = {
    [-462]: 'Probably the eclipse of Pindar’s ninth Paean, written for Thebes.',
    [-309]: 'Diodorus records it as Agathocles’ fleet sailed from Syracuse for Africa: the stars came out by day.',
    59: 'Recorded by Pliny and Tacitus, in the reign of Nero.',
    968: 'Leo the Deacon’s account from Constantinople is the first clear description of the corona.',
    2006: 'The last total eclipse over Greek land, on Kastellorizo.',
    2088: 'The next total eclipse over Greek land.',
  };
  const SHADE = '22, 20, 44';
  const CELL = 7;                                                    // pixels between the shading grid's nodes
  const F = 0.99664719;                                              // the Besselian elements' 1 - flattening
  const GREECE: LL = [38.6, 23.6];                                   // the camera centres the centre line's point nearest here

  const box = document.querySelector<HTMLElement>('[data-ecl]');
  if (box) whenNear(box, () => { void start(box); });

  // a share of the Sun as a percentage: 100% only when it is all covered, so 99.6% just outside totality reads 99%
  const pct = (v: number) => `${v >= 1 ? 100 : Math.min(99, Math.round(v * 100))}%`;
  const poly = (c: number[], t: number) => c[0] + t * (c[1] + t * (c[2] + t * (c[3] ?? 0)));

  /** Places as sea-level rho sin phi', rho cos phi' and longitude, ready for the elements. */
  function places(lat: ArrayLike<number>, lon: ArrayLike<number>) {
    const n = lat.length, rs = new Float64Array(n), rc = new Float64Array(n), lo = Float64Array.from(lon);
    for (let k = 0; k < n; k++) { const U = Math.atan(F * Math.tan((lat[k] * Math.PI) / 180)); rs[k] = F * Math.sin(U); rc[k] = Math.cos(U); }
    return { n, rs, rc, lon: lo };
  }
  type Places = ReturnType<typeof places>;

  /** The share of the Sun's disc the Moon covers at each place at time t (hours from t0), and how deep in the umbra or antumbra it is. */
  function coverAt(el: El, P: Places, t: number, out: Float32Array, inside?: Float32Array) {
    const x = poly(el.x, t), y = poly(el.y, t), d = (poly(el.d, t) * Math.PI) / 180, mu = poly(el.mu, t);
    const l1 = poly(el.l1, t), l2 = poly(el.l2, t), sd = Math.sin(d), cd = Math.cos(d);
    for (let k = 0; k < P.n; k++) {
      const H = ((mu + P.lon[k] - 0.00417807 * el.dt) * Math.PI) / 180, cH = Math.cos(H);
      const xi = P.rc[k] * Math.sin(H), eta = P.rs[k] * cd - P.rc[k] * cH * sd, zeta = P.rs[k] * sd + P.rc[k] * cH * cd;
      if (zeta <= 0) { out[k] = 0; if (inside) inside[k] = -1; continue; }               // the Sun below the horizon
      const L1 = l1 - zeta * el.f1, L2 = l2 - zeta * el.f2, Rs = (L1 + L2) / 2, Rm = (L1 - L2) / 2;
      const s = Math.hypot(x - xi, y - eta);
      if (inside) inside[k] = Math.abs(L2) - s;                                          // > 0 inside the umbra or antumbra
      let a: number;
      if (s >= Rs + Rm) a = 0;
      else if (s <= Math.abs(Rm - Rs)) a = Math.min(Rs, Rm) ** 2 / (Rs * Rs);
      else {
        const ca = Math.min(1, Math.max(-1, (s * s + Rs * Rs - Rm * Rm) / (2 * s * Rs))), cb = Math.min(1, Math.max(-1, (s * s + Rm * Rm - Rs * Rs) / (2 * s * Rm)));
        const part = Rs * Rs * Math.acos(ca) + Rm * Rm * Math.acos(cb) - 0.5 * Math.sqrt(Math.max(0, (-s + Rs + Rm) * (s + Rs - Rm) * (s - Rs + Rm) * (s + Rs + Rm)));
        a = part / (Math.PI * Rs * Rs);
      }
      out[k] = Math.min(1, Math.max(0, a));
    }
  }

  /** The times the shadow touches some of the places, a coarse pass at 5 minutes. */
  function windowOf(el: El, P: Places) {
    const now = new Float32Array(P.n); let t0 = Infinity, t1 = -Infinity;
    for (let t = el.tmin; t <= el.tmax + 1e-9; t += 5 / 60) {
      coverAt(el, P, t, now);
      if (now.some((v) => v > 0)) { t0 = Math.min(t0, t); t1 = Math.max(t1, t); }
    }
    return isFinite(t0) ? { t0: Math.max(el.tmin, t0 - 5 / 60), t1: Math.min(el.tmax, t1 + 5 / 60) } : { t0: el.tmin, t1: el.tmin };
  }
  /** The largest coverage at each place over a window, minute by minute. */
  function coverMax(el: El, P: Places, w: { t0: number; t1: number }) {
    const best = new Float32Array(P.n), now = new Float32Array(P.n);
    for (let t = w.t0; t <= w.t1 + 1e-9; t += 1 / 60) {
      coverAt(el, P, t, now);
      for (let k = 0; k < P.n; k++) if (now[k] > best[k]) best[k] = now[k];
    }
    return best;
  }

  /** Contour segments of a GX x GY field at a level, in node units (marching squares). */
  function contour(v: Float32Array, GX: number, GY: number, level: number) {
    const segs: number[][] = [];
    const lerp = (a: number, b: number) => (level - a) / (b - a);
    for (let j = 0; j < GY - 1; j++) for (let i = 0; i < GX - 1; i++) {
      const a = v[j * GX + i], b = v[j * GX + i + 1], c = v[(j + 1) * GX + i + 1], d = v[(j + 1) * GX + i];
      const code = (a >= level ? 8 : 0) | (b >= level ? 4 : 0) | (c >= level ? 2 : 0) | (d >= level ? 1 : 0);
      if (code === 0 || code === 15) continue;
      const top = [i + lerp(a, b), j], right = [i + 1, j + lerp(b, c)], bottom = [i + lerp(d, c), j + 1], left = [i, j + lerp(a, d)];
      const pairs: Record<number, number[][][]> = {
        1: [[left, bottom]], 2: [[bottom, right]], 3: [[left, right]], 4: [[top, right]], 5: [[left, top], [bottom, right]], 6: [[top, bottom]], 7: [[left, top]],
        8: [[left, top]], 9: [[top, bottom]], 10: [[top, right], [left, bottom]], 11: [[top, right]], 12: [[left, right]], 13: [[bottom, right]], 14: [[left, bottom]],
      };
      for (const [p, q] of pairs[code]) segs.push([p[0], p[1], q[0], q[1]]);
    }
    return segs;
  }

  async function start(root: HTMLElement) {
    const $ = <T extends Element>(n: string) => root.querySelector<T>(`[data-ecl-${n}]`)!;
    const data: Data = await (await fetch(root.dataset.src!)).json();

    // the map
    const area = L.latLngBounds(data.area);
    const map = L.map($<HTMLElement>('map'), { scrollWheelZoom: true, zoomSnap: 0.25, maxBounds: area, maxBoundsViscosity: 1 });
    L.tileLayer(BASEMAP, { attribution: ATTRIBUTION, maxZoom: 12, maxNativeZoom: 16 }).addTo(map);
    L.control.scale({ imperial: false }).addTo(map);
    const fit = () => map.getBoundsZoom(L.latLngBounds([[34.6, 19.3], [41.8, 28.4]]));      // Greece
    map.setView(GREECE, fit(), { animate: false });
    map.setMinZoom(map.getBoundsZoom(area, true));                      // never so far out that the view passes the area the paths were traced over

    // two canvases in their own panes: the coverage under the path, the umbra over it
    function canvasPane(name: string, z: number) {
      const pane = map.createPane(name); pane.style.zIndex = String(z); pane.style.pointerEvents = 'none';
      return L.DomUtil.create('canvas', 'ecl__cv', pane) as HTMLCanvasElement;
    }
    const cvCover = canvasPane('ecl-cover', 350), cvUmbra = canvasPane('ecl-umbra', 450);
    const cxCover = cvCover.getContext('2d')!, cxUmbra = cvUmbra.getContext('2d')!;
    map.createPane('ecl-path').style.zIndex = '400';

    // the grid over the view: a node every CELL pixels, its places laid again whenever the view changes
    let GX = 0, GY = 0, P: Places = places([], []), dpr = 1;
    function layGrid() {
      const s = map.getSize(); dpr = Math.min(2, window.devicePixelRatio || 1);
      GX = Math.ceil(s.x / CELL) + 2; GY = Math.ceil(s.y / CELL) + 2;
      const lat = new Float64Array(GX * GY), lon = new Float64Array(GX * GY);
      for (let j = 0; j < GY; j++) for (let i = 0; i < GX; i++) {
        const p = map.containerPointToLatLng([(i - 0.5) * CELL, (j - 0.5) * CELL]); lat[j * GX + i] = p.lat; lon[j * GX + i] = p.lng;
      }
      P = places(lat, lon);
      const origin = map.containerPointToLayerPoint([0, 0]);
      for (const c of [cvCover, cvUmbra]) {
        c.width = Math.round(s.x * dpr); c.height = Math.round(s.y * dpr); c.style.width = `${s.x}px`; c.style.height = `${s.y}px`;
        L.DomUtil.setPosition(c, origin);
      }
    }
    // node (i, j) sits at pixel ((i - 0.5) * CELL, (j - 0.5) * CELL) of the map's container
    const px = (i: number) => ((i - 0.5) * CELL) * dpr;

    // a fixed grid over the whole area, for the times the shadow is over it, the same whatever the view
    const AG = 40, alat: number[] = [], alon: number[] = [];
    for (let j = 0; j < AG; j++) for (let i = 0; i < AG; i++) {
      alat.push(area.getSouth() + ((j + 0.5) / AG) * (area.getNorth() - area.getSouth())); alon.push(area.getWest() + ((i + 0.5) / AG) * (area.getEast() - area.getWest()));
    }
    const A = places(alat, alon);
    const C = places(data.cities.map((c) => c.lat), data.cities.map((c) => c.lon));

    // the cities, with the coverage of the chosen eclipse
    const tags = data.cities.map((c) => {
      const icon = L.divIcon({ className: 'ecl__label', html: '<div><b></b><span></span></div>', iconSize: [0, 0] });
      const m = L.marker([c.lat, c.lon], { icon, interactive: false, keyboard: false }).addTo(map);
      const el = m.getElement()!; el.querySelector('b')!.textContent = c.name;
      return el.querySelector('span')!;
    });

    // which eclipses are shown
    const openBtn = $<HTMLButtonElement>('open'), options = $<HTMLUListElement>('options'), current = $<HTMLElement>('current');
    let at = 0;                                                       // the chosen eclipse's place in the list
    const typeBoxes = [...$<HTMLElement>('types').querySelectorAll<HTMLInputElement>('input[value]')], landBox = $<HTMLInputElement>('land');
    let list: Ecl[] = [];
    let cur: Ecl | null = null, win = { t0: 0, t1: 0 };
    const wins = new Map<number, { t0: number; t1: number }>();
    function centuryName(k: number) {
      const n = k < 5 ? 5 - k : k - 4, suf = n % 100 >= 10 && n % 100 <= 20 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
      return `${n}${suf} century${k < 5 ? ' BC' : ''}`;
    }
    function filter(keep?: Ecl | null) {
      const on = new Set(typeBoxes.filter((b) => b.checked).map((b) => b.value));
      list = data.eclipses.filter((e) => on.has(e.type) && (!landBox.checked || e.land));
      options.replaceChildren();
      let gk = '';
      list.forEach((e, i) => {
        const name = centuryName(Math.floor((e.year + 499) / 100));
        if (name !== gk) { const g = document.createElement('li'); g.className = 'ecl__group'; g.setAttribute('role', 'presentation'); g.textContent = name; options.append(g); gk = name; }
        const o = document.createElement('li'); o.setAttribute('role', 'option'); o.id = `ecl-opt-${i}`; o.dataset.i = String(i);
        o.textContent = `${e.era}, ${e.day} ${MONTHS[e.month - 1]} \u00b7 ${TYPES[e.type]}`;
        options.append(o);
      });
      const i = keep ? list.indexOf(keep) : -1;
      show(i >= 0 ? i : 0);
    }

    // the path and centre line, as Leaflet layers
    const pathLayer = L.layerGroup().addTo(map);
    let pathPoly: L.Polygon | null = null;
    function drawPath() {
      pathLayer.clearLayers(); pathPoly = null;
      if (!cur) return;
      pathPoly = L.polygon(cur.path, { pane: 'ecl-path', interactive: false, color: cur.type === 'A' ? 'rgb(214, 128, 30)' : `rgb(${SHADE})`, weight: 1.2, opacity: 0.9,
        fillColor: `rgb(${SHADE})`, fillOpacity: 0.62 }).addTo(pathLayer);
      L.polyline(cur.centre, { pane: 'ecl-path', interactive: false, color: '#f7f4ec', weight: 1.6, opacity: 0.95 }).addTo(pathLayer);
    }
    function pathMode(passing: boolean) { pathPoly?.setStyle({ fillOpacity: passing ? 0.16 : 0.62 }); }

    // drawing on the canvases
    const off = document.createElement('canvas'), ox = off.getContext('2d')!;
    function paintField(cx: CanvasRenderingContext2D, v: Float32Array, power: number, scale: number) {
      off.width = GX; off.height = GY;
      const img = ox.createImageData(GX, GY), d = img.data;
      for (let k = 0; k < GX * GY; k++) { const o = k * 4; d[o] = 22; d[o + 1] = 20; d[o + 2] = 44; d[o + 3] = Math.round(255 * scale * v[k] ** power); }
      ox.putImageData(img, 0, 0);
      cx.imageSmoothingEnabled = true; cx.imageSmoothingQuality = 'high';
      // pixel i of the small canvas is node i: its centre lands on the node
      cx.drawImage(off, 0, 0, GX, GY, px(0) - (CELL * dpr) / 2, px(0) - (CELL * dpr) / 2, GX * CELL * dpr, GY * CELL * dpr);
    }
    /** Fill where a field is above zero, as one smooth shape: each cell's part, its edge interpolated between the nodes. */
    function fillAbove(cx: CanvasRenderingContext2D, v: Float32Array) {
      cx.beginPath();
      for (let j = 0; j < GY - 1; j++) for (let i = 0; i < GX - 1; i++) {
        const q = [v[j * GX + i], v[j * GX + i + 1], v[(j + 1) * GX + i + 1], v[(j + 1) * GX + i]];
        if (q[0] <= 0 && q[1] <= 0 && q[2] <= 0 && q[3] <= 0) continue;
        const pos = [[i, j], [i + 1, j], [i + 1, j + 1], [i, j + 1]].map(([a, b]) => [px(a), px(b)]);
        const pts: number[][] = [];
        for (let k = 0; k < 4; k++) {
          const n = (k + 1) % 4;
          if (q[k] > 0) pts.push(pos[k]);
          if (q[k] > 0 !== q[n] > 0) { const f = q[k] / (q[k] - q[n]); pts.push([pos[k][0] + f * (pos[n][0] - pos[k][0]), pos[k][1] + f * (pos[n][1] - pos[k][1])]); }
        }
        cx.moveTo(pts[0][0], pts[0][1]); for (let k = 1; k < pts.length; k++) cx.lineTo(pts[k][0], pts[k][1]); cx.closePath();
      }
      cx.fill();
    }
    function clear() { cxCover.clearRect(0, 0, cvCover.width, cvCover.height); cxUmbra.clearRect(0, 0, cvUmbra.width, cvUmbra.height); }
    /** The largest coverage over the whole eclipse, with contours every 10%. */
    function drawWhole() {
      clear(); pathMode(false);
      if (!cur) return;
      const field = coverMax(cur.el, P, win);
      paintField(cxCover, field, 6, 0.7);                              // daylight hardly fades until the Sun is mostly covered
      const cx = cxCover, u = dpr;
      cx.lineWidth = 1.1 * u; cx.strokeStyle = `rgba(${SHADE}, 0.55)`;
      cx.font = `italic ${Math.round(13 * u)}px 'Times New Roman', serif`; cx.textAlign = 'center'; cx.textBaseline = 'middle';
      const marks: [number, number, string][] = [];
      for (let lv = 10; lv <= 90; lv += 10) {
        const segs = contour(field, GX, GY, lv / 100);
        if (!segs.length) continue;
        cx.beginPath(); for (const s of segs) { cx.moveTo(px(s[0]), px(s[1])); cx.lineTo(px(s[2]), px(s[3])); } cx.stroke();
        // a label where the line crosses near the map's western edge, else nearest the middle
        let bestS = segs[0], bd = Infinity;
        for (const s of segs) {
          const mx = (s[0] + s[2]) / 2 / GX, my = (s[1] + s[3]) / 2 / GY;
          const dd = my > 0.08 && my < 0.92 ? Math.abs(mx - 0.08) : 9 + Math.hypot(mx - 0.5, my - 0.5);
          if (dd < bd) { bd = dd; bestS = s; }
        }
        marks.push([px((bestS[0] + bestS[2]) / 2), px((bestS[1] + bestS[3]) / 2), `${lv}%`]);
      }
      cx.lineWidth = 3 * u; cx.strokeStyle = 'rgba(247, 244, 236, 0.95)'; cx.fillStyle = '#23232a';
      for (const [x, y, s] of marks) { cx.strokeText(s, x, y); cx.fillText(s, x, y); }
    }

    // the chosen eclipse
    const title = $<HTMLElement>('title'), sub = $<HTMLElement>('sub');
    function describe(i: number) {
      const e = cur!, dur = e.dur.match(/(\d+)m(\d+)s/);
      title.textContent = `${e.era}, ${e.day} ${MONTHS[e.month - 1]}: ${TYPES[e.type].toLowerCase()} eclipse`;
      const note = NOTES[e.year] ?? '';
      sub.textContent = `${i + 1} of ${list.length} shown`
        + (dur ? ` · ${e.type === 'A' ? 'annularity' : 'totality'} up to ${Number(dur[1])} min ${Number(dur[2])} s, at the eclipse’s greatest` : '')
        + (e.land ? '' : ' · over the sea only') + (note ? ` · ${note}` : '');
    }
    /** The camera on the path: its centre line's point nearest the middle of Greece, at the zoom the map has. */
    function centreOn(e: Ecl, animate: boolean) {
      let best: LL | null = null, bd = Infinity;
      for (const p of e.centre.flat()) { const d = Math.hypot(p[0] - GREECE[0], (p[1] - GREECE[1]) * 0.78); if (d < bd) { bd = d; best = p; } }
      if (!best && e.path.length) {                                  // no centre line over the area: the point of the path nearest Greece
        const b = L.latLngBounds(e.path.flat());
        best = [Math.min(Math.max(GREECE[0], b.getSouth()), b.getNorth()), Math.min(Math.max(GREECE[1], b.getWest()), b.getEast())];
      }
      if (best) map.panTo(best, { animate, duration: 0.6 });
    }
    function show(i: number, animate = true) {
      resetTime();
      if (!list.length) { cur = null; title.textContent = 'No eclipse with these choices'; sub.textContent = ''; pathLayer.clearLayers(); clear(); return; }
      i = Math.max(0, Math.min(list.length - 1, i));
      at = i;
      current.textContent = `${list[i].era}, ${list[i].day} ${MONTHS[list[i].month - 1]} \u00b7 ${TYPES[list[i].type]}`;
      for (const o of options.querySelectorAll('[role=option]')) o.setAttribute('aria-selected', String(Number((o as HTMLElement).dataset.i) === i));
      const changed = cur !== list[i];
      cur = list[i];
      win = wins.get(cur.id) ?? windowOf(cur.el, A); wins.set(cur.id, win);
      const cityMax = coverMax(cur.el, C, win);
      tags.forEach((t, k) => { t.textContent = pct(cityMax[k]); });
      describe(i);
      drawPath();
      drawWhole();
      if (changed) centreOn(cur, animate);
    }

    // the chosen eclipse's shadow crossing the map: played, or dragged through with the time slider
    const play = $<HTMLButtonElement>('play'), time = $<HTMLInputElement>('time'), whole = $<HTMLButtonElement>('whole'), clock = $<HTMLElement>('clock');
    let raf = 0;
    function stopPass() { if (raf) { cancelAnimationFrame(raf); raf = 0; } play.innerHTML = '&#9654; Play'; }
    function resetTime() { stopPass(); time.value = '0'; clock.hidden = true; }
    // the umbra crosses the map in minutes, the whole eclipse takes hours: the pass slows down sixfold while the umbra is over the area
    const SLOW = 6, umbras = new Map<number, [number, number] | null>();
    function umbraWin(): [number, number] | null {
      if (!cur) return null;
      if (umbras.has(cur.id)) return umbras.get(cur.id)!;
      const v = new Float32Array(A.n), ins = new Float32Array(A.n); let u0 = Infinity, u1 = -Infinity;
      for (let t = win.t0; t <= win.t1 + 1e-9; t += 1 / 60) {
        coverAt(cur.el, A, t, v, ins);
        if (ins.some((x) => x > 0)) { u0 = Math.min(u0, t); u1 = Math.max(u1, t); }
      }
      const w: [number, number] | null = isFinite(u0) ? [Math.max(win.t0, u0 - 3 / 60), Math.min(win.t1, u1 + 3 / 60)] : null;
      umbras.set(cur.id, w); return w;
    }
    function passLength() { const u = umbraWin(); return u ? win.t1 - win.t0 + (SLOW - 1) * (u[1] - u[0]) : win.t1 - win.t0; }
    function timeAt(f: number) {
      const u = umbraWin(), p = f * passLength();
      if (!u) return win.t0 + p;
      const a = u[0] - win.t0, b = SLOW * (u[1] - u[0]);
      return p < a ? win.t0 + p : p < a + b ? u[0] + (p - a) / SLOW : u[1] + (p - a - b);
    }
    let now = new Float32Array(0), inside = new Float32Array(0);
    const cnow = new Float32Array(C.n);
    /** The chosen eclipse's shadow at a fraction f of the pass. */
    function passAt(f: number) {
      if (!cur) return;
      if (now.length !== P.n) { now = new Float32Array(P.n); inside = new Float32Array(P.n); }
      const el = cur.el, t = timeAt(f);
      clock.hidden = false; time.value = String(Math.round(f * 1000));
      coverAt(el, P, t, now, inside);
      clear(); pathMode(true);
      paintField(cxCover, now, 2.5, 0.75);                             // the moving shadow: gentler, so the partial phase shows as it sweeps
      cxUmbra.fillStyle = `rgba(${SHADE}, ${cur.type === 'A' ? 0.72 : 0.95})`;   // an annular's antumbra leaves a ring of Sun: a little lighter
      fillAbove(cxUmbra, inside);
      coverAt(el, C, t, cnow);                                         // the cities, at this moment
      tags.forEach((g, k) => { g.textContent = pct(cnow[k]); });
      let ut = el.t0 + t - el.dt / 3600; ut = ((ut % 24) + 24) % 24;
      const hh = Math.floor(ut), mm = Math.floor((ut - hh) * 60);
      clock.textContent = `${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')} UT`;
    }
    play.addEventListener('click', () => {
      if (raf) { stopPass(); return; }                                 // pause where it is
      if (!cur) return;
      const secs = Math.min(12, Math.max(6, passLength() * 2.5));
      let f0 = Number(time.value) / 1000; if (f0 >= 1) f0 = 0;        // from where the slider is, or from the start
      const t_start = performance.now() - f0 * secs * 1000;
      play.innerHTML = '&#10074;&#10074; Pause';
      const frame = (ts: number) => {
        const f = Math.min(1, (ts - t_start) / (secs * 1000));
        passAt(f);
        if (f < 1) raf = requestAnimationFrame(frame);
        else { raf = 0; play.innerHTML = '&#9654; Play'; }
      };
      raf = requestAnimationFrame(frame);
    });
    time.addEventListener('input', () => { stopPass(); passAt(Number(time.value) / 1000); });
    whole.addEventListener('click', () => show(at));   // back to the largest coverage over the whole eclipse

    // the list: opens under its button, scrolled to the chosen eclipse; a click, or Enter, picks; Escape or a click elsewhere closes it
    let active = -1;
    function mark(i: number) {
      active = Math.max(0, Math.min(list.length - 1, i));
      for (const o of options.querySelectorAll('.is-active')) o.classList.remove('is-active');
      const o = options.querySelector<HTMLElement>(`#ecl-opt-${active}`);
      if (o) { o.classList.add('is-active'); o.scrollIntoView({ block: 'nearest' }); options.setAttribute('aria-activedescendant', o.id); }
    }
    function openList() {
      options.hidden = false; openBtn.setAttribute('aria-expanded', 'true');
      const o = options.querySelector<HTMLElement>(`#ecl-opt-${at}`);
      if (o) options.scrollTop = o.offsetTop - options.clientHeight / 2 + o.offsetHeight / 2;
      mark(at); options.focus({ preventScroll: true });
    }
    function closeList(focus = true) { options.hidden = true; openBtn.setAttribute('aria-expanded', 'false'); if (focus) openBtn.focus({ preventScroll: true }); }
    openBtn.addEventListener('click', () => (options.hidden ? openList() : closeList()));
    options.addEventListener('click', (ev) => {
      const o = (ev.target as HTMLElement).closest<HTMLElement>('[role=option]');
      if (o) { closeList(); show(Number(o.dataset.i)); }
    });
    options.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowDown') { mark(active + 1); ev.preventDefault(); }
      else if (ev.key === 'ArrowUp') { mark(active - 1); ev.preventDefault(); }
      else if (ev.key === 'Enter' || ev.key === ' ') { closeList(); show(active); ev.preventDefault(); }
      else if (ev.key === 'Escape' || ev.key === 'Tab') closeList(ev.key === 'Escape');
    });
    document.addEventListener('pointerdown', (ev) => { if (!options.hidden && !(ev.target as HTMLElement).closest('.ecl__list')) closeList(false); });
    $<HTMLButtonElement>('prev').addEventListener('click', () => show(at - 1));
    $<HTMLButtonElement>('next').addEventListener('click', () => show(at + 1));
    for (const b of [...typeBoxes, landBox]) b.addEventListener('change', () => filter(cur));

    // the view changed: lay the grid again and redraw what was on it; while zooming, hide the canvases rather than stretch them
    function redraw() {
      layGrid();
      if (!cur) return;
      if (Number(time.value) > 0 || raf) passAt(Number(time.value) / 1000); else drawWhole();
    }
    map.on('zoomstart', () => { cvCover.style.visibility = 'hidden'; cvUmbra.style.visibility = 'hidden'; });
    map.on('moveend zoomend resize', () => { redraw(); cvCover.style.visibility = ''; cvUmbra.style.visibility = ''; });
    layGrid();
    filter();
    // open on the last total over Greek land
    const last = list.findIndex((e) => e.year === 2006); if (last >= 0) show(last, false);
    // for the demo recorder: set any eclipse or moment of its pass directly, frame by frame
    (window as any).__ecl = { show, passAt, map, count: () => list.length, index: (year: number) => list.findIndex((e) => e.year === year) };
  }
</script>
