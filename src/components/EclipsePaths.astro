---
/**
 * Day 17: every central eclipse of the Sun over Greece, 500 BC to AD 2500, one at a time. A timeline steps through them in order (or plays
 * through three thousand years), the earlier paths staying behind faintly; any one can be picked from the list. For the chosen eclipse the page
 * works out, from its Besselian elements, the largest share of the Sun the Moon covers at each place (the same method as
 * Day_17/prep/eclipse_paths.py, on a 100 x 100 grid over the frame), shades it, and draws its contours, the path of totality or annularity
 * and its centre line; "Watch it pass" moves the Moon's shadow across the map minute by minute.
 *
 * `src`: the JSON written by Day_17/prep/page_data.py (frame, base map, cities, eclipses with their paths and elements).
 */
interface Props {
  src: string;
  caption?: string;
}
const { src, caption } = Astro.props;
---

<figure class="map-figure">
  <div class="ecl" data-ecl data-src={src}>
    <div class="ecl__controls">
      <div class="ecl__row">
        <button type="button" class="ecl__btn" data-ecl-play aria-label="Play through the eclipses in order">&#9654; Play</button>
        <input type="range" min="0" max="0" step="1" value="0" data-ecl-range aria-label="Step through the eclipses in order of date" />
      </div>
      <div class="ecl__row ecl__row--pick">
        <label class="ecl__pick">Eclipse <select data-ecl-select></select></label>
        <span class="ecl__types" data-ecl-types>
          <label><input type="checkbox" value="T" checked /> Total</label>
          <label><input type="checkbox" value="A" checked /> Annular</label>
          <label><input type="checkbox" value="H" checked /> Hybrid</label>
          <label><input type="checkbox" data-ecl-land checked /> Over Greek land only</label>
        </span>
      </div>
    </div>
    <div class="ecl__read" aria-live="polite">
      <p class="ecl__title" data-ecl-title></p>
      <p class="ecl__sub" data-ecl-sub></p>
    </div>
    <div class="ecl__stage" data-ecl-stage>
      <img class="ecl__layer" data-ecl-base alt="" />
      <canvas class="ecl__layer" data-ecl-canvas role="img" aria-label="Map of Greece with the chosen eclipse: its path, centre line and how much of the Sun it covered"></canvas>
      <div class="ecl__labels" data-ecl-labels></div>
      <div class="ecl__clock" data-ecl-clock hidden></div>
    </div>
    <div class="ecl__foot">
      <button type="button" class="ecl__btn" data-ecl-pass>Watch it pass</button>
      <div class="ecl__legend" aria-hidden="true">
        <span class="ecl__ramp"></span>
        <span class="ecl__ticks"><em>Sun covered: 0%</em><em>50%</em><em>100%</em></span>
        <span class="ecl__key"><i class="ecl__key-path"></i> Path of totality or annularity, with its centre line</span>
      </div>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  /* global: the labels are written by the script, which scoped styles do not reach */
  .ecl__controls { display: grid; gap: 0.5rem; margin-bottom: 0.5rem; }
  .ecl__row { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; align-items: center; }
  .ecl__row input[type='range'] { width: 100%; accent-color: #2a2648; }
  .ecl__row--pick { grid-template-columns: auto 1fr; font-size: 0.88rem; }
  .ecl__pick select { max-width: 15rem; font: inherit; }
  .ecl__types { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; justify-content: flex-end; }
  .ecl__types label { white-space: nowrap; }
  .ecl__btn { font: inherit; font-size: 0.88rem; padding: 0.25rem 0.75rem; border: 1px solid #2a2648; background: #f7f4ec; color: #23232a; border-radius: 3px; cursor: pointer; white-space: nowrap; }
  .ecl__btn:hover { background: #2a2648; color: #f7f4ec; }
  .ecl__read { min-height: 4.1rem; margin-bottom: 0.4rem; text-align: center; }
  .ecl__title { margin: 0; font-size: 1.05rem; font-weight: 700; }
  .ecl__sub { margin: 0; font-size: 0.85rem; opacity: 0.85; }
  .ecl__stage { position: relative; width: 100%; aspect-ratio: 1 / 1; background: #dee6ec; border: 1px solid var(--rule, #d9d4c8); overflow: hidden; }
  .ecl__layer { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .ecl__labels { position: absolute; inset: 0; pointer-events: none; }
  .ecl__label { position: absolute; transform: translate(-50%, -100%); padding-bottom: 6px; font-size: clamp(0.6rem, 1.5vw, 0.8rem); line-height: 1.15; text-align: center;
    color: #23232a; text-shadow: 0 0 3px #f7f4ec, 0 0 3px #f7f4ec, 0 0 2px #f7f4ec; white-space: nowrap; }
  .ecl__label::after { content: ''; position: absolute; left: 50%; bottom: 0; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #23232a; box-shadow: 0 0 0 1.5px #f7f4ec; }
  .ecl__label b { font-weight: 700; }
  .ecl__label span { display: block; font-variant-numeric: tabular-nums; }
  .ecl__clock { position: absolute; left: 0.6rem; bottom: 0.5rem; padding: 0.15rem 0.45rem; font-size: 0.85rem; font-variant-numeric: tabular-nums; background: rgba(247, 244, 236, 0.85); color: #23232a; border-radius: 3px; }
  .ecl__foot { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; align-items: start; margin-top: 0.5rem; }
  .ecl__legend { display: grid; gap: 0.15rem; font-size: 0.72rem; }
  .ecl__ramp { display: block; height: 0.6rem; background: linear-gradient(to right, rgba(22, 20, 44, 0) 50%, rgba(22, 20, 44, 0.08) 70%, rgba(22, 20, 44, 0.18) 80%, rgba(22, 20, 44, 0.37) 90%, rgba(22, 20, 44, 0.7));   /* 0.7 x coverage^6, as drawn */ border: 1px solid #c9c4b8; }
  .ecl__ticks { display: flex; justify-content: space-between; }
  .ecl__ticks em { font-style: normal; opacity: 0.8; }
  .ecl__key { display: flex; align-items: center; gap: 0.4rem; }
  .ecl__key-path { display: inline-block; width: 1.6rem; height: 0.6rem; background: rgba(22, 20, 44, 0.85); background-image: linear-gradient(transparent 45%, #f7f4ec 45%, #f7f4ec 55%, transparent 55%); }
  @media (max-width: 560px) {
    .ecl__row--pick, .ecl__foot { grid-template-columns: 1fr; }
    .ecl__types { justify-content: flex-start; }
  }
</style>

<script>
  import { whenNear } from '../lazy';

  type El = { t0: number; tmin: number; tmax: number; dt: number; x: number[]; y: number[]; d: number[]; mu: number[]; l1: number[]; l2: number[]; f1: number; f2: number };
  type Ecl = { id: number; year: number; era: string; month: number; day: number; type: 'T' | 'A' | 'H'; land: boolean; dur: string;
    path: [number, number][][]; centre: [number, number][][]; el: El };
  type Data = { frame: { x0: number; y0: number; x1: number; y1: number }; base: string;
    cities: { name: string; x: number; y: number; lat: number; lon: number }[]; eclipses: Ecl[] };

  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const TYPES = { T: 'Total', A: 'Annular', H: 'Hybrid' } as const;
  // the eclipses writers recorded (astronomical years: -462 is 463 BC)
  const NOTES: Record<number, string> = {
    [-462]: 'Probably the eclipse of Pindar’s ninth Paean, written for Thebes.',
    [-309]: 'Diodorus records it as Agathocles’ fleet sailed from Syracuse for Africa: the stars came out by day.',
    59: 'Recorded by Pliny and Tacitus, in the reign of Nero.',
    968: 'Leo the Deacon’s account from Constantinople is the first clear description of the corona.',
    2006: 'The last total eclipse over Greek land, on Kastellorizo.',
    2088: 'The next total eclipse over Greek land.',
  };
  const SHADE = '22, 20, 44';
  const G = 100;                                                     // the coverage grid over the frame
  const F = 0.99664719;                                              // the Besselian elements' 1 - flattening

  const box = document.querySelector<HTMLElement>('[data-ecl]');
  if (box) whenNear(box, () => { void start(box); });

  // the Greek Grid (EPSG:2100) to latitude and longitude: transverse Mercator on GRS80, 24 E, k0 0.9996, false easting 500 km
  function gridToLatLon(E: number, N: number): [number, number] {
    const a = 6378137, f = 1 / 298.257222101, k0 = 0.9996, e2 = f * (2 - f), ep2 = e2 / (1 - e2);
    const M = N / k0, mu = M / (a * (1 - e2 / 4 - (3 * e2 * e2) / 64 - (5 * e2 ** 3) / 256));
    const e1 = (1 - Math.sqrt(1 - e2)) / (1 + Math.sqrt(1 - e2));
    const p1 = mu + (1.5 * e1 - (27 / 32) * e1 ** 3) * Math.sin(2 * mu) + ((21 / 16) * e1 * e1 - (55 / 32) * e1 ** 4) * Math.sin(4 * mu)
      + ((151 / 96) * e1 ** 3) * Math.sin(6 * mu) + ((1097 / 512) * e1 ** 4) * Math.sin(8 * mu);
    const s = Math.sin(p1), c = Math.cos(p1), t = Math.tan(p1);
    const N1 = a / Math.sqrt(1 - e2 * s * s), T1 = t * t, C1 = ep2 * c * c, R1 = (a * (1 - e2)) / (1 - e2 * s * s) ** 1.5, D = (E - 500000) / (N1 * k0);
    const lat = p1 - ((N1 * t) / R1) * (D * D / 2 - ((5 + 3 * T1 + 10 * C1 - 4 * C1 * C1 - 9 * ep2) * D ** 4) / 24
      + ((61 + 90 * T1 + 298 * C1 + 45 * T1 * T1 - 252 * ep2 - 3 * C1 * C1) * D ** 6) / 720);
    const lon = 24 + ((D - ((1 + 2 * T1 + C1) * D ** 3) / 6 + ((5 - 2 * C1 + 28 * T1 - 3 * C1 * C1 + 8 * ep2 + 24 * T1 * T1) * D ** 5) / 120) / c) * (180 / Math.PI);
    return [lat * (180 / Math.PI), lon];
  }

  // a share of the Sun as a percentage: 100% only when it is all covered, so 99.6% just outside totality reads 99%
  const pct = (v: number) => `${v >= 1 ? 100 : Math.min(99, Math.round(v * 100))}%`;
  const poly = (c: number[], t: number) => c[0] + t * (c[1] + t * (c[2] + t * (c[3] ?? 0)));

  /** Places as sea-level rho sin phi', rho cos phi' and longitude, ready for the elements. */
  function places(lat: Float64Array, lon: Float64Array) {
    const n = lat.length, rs = new Float64Array(n), rc = new Float64Array(n);
    for (let k = 0; k < n; k++) { const U = Math.atan(F * Math.tan((lat[k] * Math.PI) / 180)); rs[k] = F * Math.sin(U); rc[k] = Math.cos(U); }
    return { n, rs, rc, lon };
  }
  type Places = ReturnType<typeof places>;

  /** The share of the Sun's disc the Moon covers at each place at time t (hours from t0), and how deep in the umbra or antumbra it is. */
  function coverAt(el: El, P: Places, t: number, out: Float32Array, inside?: Float32Array) {
    const x = poly(el.x, t), y = poly(el.y, t), d = (poly(el.d, t) * Math.PI) / 180, mu = poly(el.mu, t);
    const l1 = poly(el.l1, t), l2 = poly(el.l2, t), sd = Math.sin(d), cd = Math.cos(d);
    for (let k = 0; k < P.n; k++) {
      const H = ((mu + P.lon[k] - 0.00417807 * el.dt) * Math.PI) / 180, cH = Math.cos(H);
      const xi = P.rc[k] * Math.sin(H), eta = P.rs[k] * cd - P.rc[k] * cH * sd, zeta = P.rs[k] * sd + P.rc[k] * cH * cd;
      if (zeta <= 0) { out[k] = 0; if (inside) inside[k] = -1; continue; }               // the Sun below the horizon
      const L1 = l1 - zeta * el.f1, L2 = l2 - zeta * el.f2, Rs = (L1 + L2) / 2, Rm = (L1 - L2) / 2;
      const s = Math.hypot(x - xi, y - eta);
      if (inside) inside[k] = Math.abs(L2) - s;                                          // > 0 inside the umbra or antumbra
      let a: number;
      if (s >= Rs + Rm) a = 0;
      else if (s <= Math.abs(Rm - Rs)) a = Math.min(Rs, Rm) ** 2 / (Rs * Rs);
      else {
        const ca = Math.min(1, Math.max(-1, (s * s + Rs * Rs - Rm * Rm) / (2 * s * Rs))), cb = Math.min(1, Math.max(-1, (s * s + Rm * Rm - Rs * Rs) / (2 * s * Rm)));
        const part = Rs * Rs * Math.acos(ca) + Rm * Rm * Math.acos(cb) - 0.5 * Math.sqrt(Math.max(0, (-s + Rs + Rm) * (s + Rs - Rm) * (s - Rs + Rm) * (s + Rs + Rm)));
        a = part / (Math.PI * Rs * Rs);
      }
      out[k] = Math.min(1, Math.max(0, a));
    }
  }

  /** The largest coverage at each place over the eclipse, and the times the shadow is over the area: a coarse pass, then minutes. */
  function coverMax(el: El, P: Places) {
    const best = new Float32Array(P.n), now = new Float32Array(P.n);
    let t0 = Infinity, t1 = -Infinity;
    for (let t = el.tmin; t <= el.tmax + 1e-9; t += 5 / 60) {
      coverAt(el, P, t, now);
      for (let k = 0; k < P.n; k++) if (now[k] > 0) { t0 = Math.min(t0, t); t1 = Math.max(t1, t); break; }
    }
    if (!isFinite(t0)) return { best, t0: el.tmin, t1: el.tmin };
    t0 = Math.max(el.tmin, t0 - 5 / 60); t1 = Math.min(el.tmax, t1 + 5 / 60);
    for (let t = t0; t <= t1 + 1e-9; t += 1 / 60) {
      coverAt(el, P, t, now);
      for (let k = 0; k < P.n; k++) if (now[k] > best[k]) best[k] = now[k];
    }
    return { best, t0, t1 };
  }

  /** Contour segments of a G x G field at a level, in fractions of the frame (marching squares). */
  function contour(v: Float32Array, level: number) {
    const segs: number[][] = [];
    const at = (i: number, j: number) => v[j * G + i];
    const lerp = (a: number, b: number) => (level - a) / (b - a);
    for (let j = 0; j < G - 1; j++) for (let i = 0; i < G - 1; i++) {
      const a = at(i, j), b = at(i + 1, j), c = at(i + 1, j + 1), d = at(i, j + 1);
      const code = (a >= level ? 8 : 0) | (b >= level ? 4 : 0) | (c >= level ? 2 : 0) | (d >= level ? 1 : 0);
      if (code === 0 || code === 15) continue;
      const X = (u: number) => (i + 0.5 + u) / G, Y = (u: number) => (j + 0.5 + u) / G;
      const top = [X(lerp(a, b)), Y(0)], right = [X(1), Y(lerp(b, c))], bottom = [X(lerp(d, c)), Y(1)], left = [X(0), Y(lerp(a, d))];
      const pairs: Record<number, number[][][]> = {
        1: [[left, bottom]], 2: [[bottom, right]], 3: [[left, right]], 4: [[top, right]], 5: [[left, top], [bottom, right]], 6: [[top, bottom]], 7: [[left, top]],
        8: [[left, top]], 9: [[top, bottom]], 10: [[top, right], [left, bottom]], 11: [[top, right]], 12: [[left, right]], 13: [[bottom, right]], 14: [[left, bottom]],
      };
      for (const [p, q] of pairs[code]) segs.push([p[0], p[1], q[0], q[1]]);
    }
    return segs;
  }

  async function start(root: HTMLElement) {
    const $ = <T extends Element>(n: string) => root.querySelector<T>(`[data-ecl-${n}]`)!;
    const data: Data = await (await fetch(root.dataset.src!)).json();
    const { x0, y0, x1, y1 } = data.frame, S = x1 - x0;
    $<HTMLImageElement>('base').src = data.base;

    // the grid's places, once
    const lat = new Float64Array(G * G), lon = new Float64Array(G * G);
    for (let j = 0; j < G; j++) for (let i = 0; i < G; i++) {
      const [la, lo] = gridToLatLon(x0 + ((i + 0.5) / G) * S, y1 - ((j + 0.5) / G) * S); lat[j * G + i] = la; lon[j * G + i] = lo;
    }
    const P = places(lat, lon);
    const C = places(Float64Array.from(data.cities, (c) => c.lat), Float64Array.from(data.cities, (c) => c.lon));

    const cv = $<HTMLCanvasElement>('canvas'), cx = cv.getContext('2d')!;
    const off = document.createElement('canvas'); off.width = G; off.height = G;
    const ox = off.getContext('2d')!, img = ox.createImageData(G, G);
    const stage = $<HTMLElement>('stage');

    // the cities, with the coverage of the chosen eclipse
    const labels = $<HTMLElement>('labels');
    const tags = data.cities.map((c) => {
      const el = document.createElement('div'); el.className = 'ecl__label';
      el.style.left = `${c.x * 100}%`; el.style.top = `${c.y * 100}%`;
      el.innerHTML = '<b></b><span></span>'; el.querySelector('b')!.textContent = c.name;
      labels.append(el); return el.querySelector('span')!;
    });

    // which eclipses are shown
    const range = $<HTMLInputElement>('range'), select = $<HTMLSelectElement>('select');
    const typeBoxes = [...$<HTMLElement>('types').querySelectorAll<HTMLInputElement>('input[value]')], landBox = $<HTMLInputElement>('land');
    let list: Ecl[] = [];
    let cur: Ecl | null = null, field: Float32Array | null = null, win = { t0: 0, t1: 0 };
    const cache = new Map<number, { best: Float32Array; t0: number; t1: number }>();

    function filter(keep?: Ecl | null) {
      const on = new Set(typeBoxes.filter((b) => b.checked).map((b) => b.value));
      list = data.eclipses.filter((e) => on.has(e.type) && (!landBox.checked || e.land));
      select.replaceChildren();
      let group: HTMLOptGroupElement | null = null, gk = '';
      list.forEach((e, i) => {
        const k = Math.floor((e.year + 499) / 100), name = centuryName(k);
        if (name !== gk) { group = document.createElement('optgroup'); group.label = name; select.append(group); gk = name; }
        const o = document.createElement('option'); o.value = String(i); o.textContent = `${e.era}, ${e.day} ${MONTHS[e.month - 1]} · ${TYPES[e.type]}`;
        group!.append(o);
      });
      range.max = String(Math.max(0, list.length - 1));
      const i = keep ? list.indexOf(keep) : -1;
      show(i >= 0 ? i : Math.min(Number(range.value), list.length - 1));
    }
    function centuryName(k: number) {
      const n = k < 5 ? 5 - k : k - 4, suf = n % 100 >= 10 && n % 100 <= 20 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
      return `${n}${suf} century${k < 5 ? ' BC' : ''}`;
    }

    // drawing
    function size() {
      const r = stage.getBoundingClientRect(), dpr = Math.min(2, window.devicePixelRatio || 1);
      cv.width = Math.round(r.width * dpr); cv.height = Math.round(r.height * dpr);
    }
    function ring(r: [number, number][], W: number) {
      cx.moveTo(r[0][0] * W, r[0][1] * W); for (let k = 1; k < r.length; k++) cx.lineTo(r[k][0] * W, r[k][1] * W); cx.closePath();
    }
    function lineOf(l: [number, number][], W: number) {
      cx.moveTo(l[0][0] * W, l[0][1] * W); for (let k = 1; k < l.length; k++) cx.lineTo(l[k][0] * W, l[k][1] * W);
    }
    function paintField(v: Float32Array, power: number, scale: number) {
      const d = img.data;
      for (let k = 0; k < G * G; k++) { const o = k * 4; d[o] = 22; d[o + 1] = 20; d[o + 2] = 44; d[o + 3] = Math.round(255 * scale * v[k] ** power); }
      ox.putImageData(img, 0, 0);
      cx.imageSmoothingEnabled = true; cx.imageSmoothingQuality = 'high';
      // each grid value is a cell's centre, so pixel i of the small canvas covers cell i of the frame
      const W = cv.width; cx.drawImage(off, 0, 0, G, G, 0, 0, W, W);
    }
    /** Fill where a G x G field is above zero, as one smooth shape: each cell's part, its edge interpolated between the cell centres. */
    function fillAbove(v: Float32Array, W: number) {
      const c = W / G; cx.beginPath();
      for (let j = 0; j < G - 1; j++) for (let i = 0; i < G - 1; i++) {
        const q = [v[j * G + i], v[j * G + i + 1], v[(j + 1) * G + i + 1], v[(j + 1) * G + i]];
        if (q[0] <= 0 && q[1] <= 0 && q[2] <= 0 && q[3] <= 0) continue;
        const pos = [[i, j], [i + 1, j], [i + 1, j + 1], [i, j + 1]].map(([a, b]) => [(a + 0.5) * c, (b + 0.5) * c]);
        const pts: number[][] = [];
        for (let k = 0; k < 4; k++) {
          const n = (k + 1) % 4;
          if (q[k] > 0) pts.push(pos[k]);
          if (q[k] > 0 !== q[n] > 0) { const f = q[k] / (q[k] - q[n]); pts.push([pos[k][0] + f * (pos[n][0] - pos[k][0]), pos[k][1] + f * (pos[n][1] - pos[k][1])]); }
        }
        cx.moveTo(pts[0][0], pts[0][1]); for (let k = 1; k < pts.length; k++) cx.lineTo(pts[k][0], pts[k][1]); cx.closePath();
      }
      cx.fill();
    }
    function draw(shadow?: { now: Float32Array; inside: Float32Array }) {
      const W = cv.width, px = W / 600;
      cx.clearRect(0, 0, W, W);
      const idx = list.indexOf(cur!);
      // the eclipses before this one, faintly: the map darkens as the centuries pass
      cx.fillStyle = `rgba(${SHADE}, 0.02)`;                       // about twenty overlap at an average place: a third of the way to dark
      for (let i = 0; i < idx; i++) { cx.beginPath(); for (const r of list[i].path) ring(r, W); cx.fill(); }
      if (!cur || (!shadow && !field)) return;
      if (shadow) paintField(shadow.now, 2.5, 0.75);                // the moving shadow: gentler, so the partial phase shows as it sweeps
      else paintField(field!, 6, 0.7);                                // daylight hardly fades until the Sun is mostly covered
      // contours of the largest coverage, every 10%
      if (!shadow) {
        cx.lineWidth = 1.1 * px; cx.strokeStyle = `rgba(${SHADE}, 0.55)`;
        cx.font = `italic ${Math.round(13 * px)}px 'Times New Roman', serif`; cx.textAlign = 'center'; cx.textBaseline = 'middle';
        const marks: [number, number, string][] = [];
        for (let lv = 10; lv <= 90; lv += 10) {
          const segs = contour(field!, lv / 100);
          if (!segs.length) continue;
          cx.beginPath(); for (const s of segs) { cx.moveTo(s[0] * W, s[1] * W); cx.lineTo(s[2] * W, s[3] * W); } cx.stroke();
          // a label where the line crosses the map's western edge, else nearest the middle
          let bestS = segs[0], bd = Infinity;
          for (const s of segs) {
            const mx = (s[0] + s[2]) / 2, my = (s[1] + s[3]) / 2;
            const dd = my > 0.06 && my < 0.94 ? Math.abs(mx - 0.08) : 9 + Math.hypot(mx - 0.5, my - 0.5);
            if (dd < bd) { bd = dd; bestS = s; }
          }
          marks.push([((bestS[0] + bestS[2]) / 2) * W, ((bestS[1] + bestS[3]) / 2) * W, `${lv}%`]);
        }
        cx.lineWidth = 3 * px; cx.strokeStyle = 'rgba(247, 244, 236, 0.95)'; cx.fillStyle = '#23232a';
        for (const [x, y, s] of marks) { cx.strokeText(s, x, y); cx.fillText(s, x, y); }
      }
      // the path, and its centre line
      cx.fillStyle = `rgba(${SHADE}, ${shadow ? 0.18 : 0.82})`; cx.strokeStyle = cur.type === 'A' ? 'rgba(214, 128, 30, 0.95)' : `rgba(${SHADE}, 0.9)`; cx.lineWidth = 1.2 * px;
      cx.beginPath(); for (const r of cur.path) ring(r, W); cx.fill(); cx.stroke();
      cx.strokeStyle = 'rgba(247, 244, 236, 0.9)'; cx.lineWidth = 1.3 * px;
      cx.beginPath(); for (const l of cur.centre) lineOf(l, W); cx.stroke();
      if (shadow) {                                                  // the umbra or antumbra now
        cx.fillStyle = `rgba(${SHADE}, ${cur.type === 'A' ? 0.72 : 0.95})`;   // an annular's antumbra leaves a ring of Sun: a little lighter
        fillAbove(shadow.inside, W);
      }
    }

    // the chosen eclipse
    const title = $<HTMLElement>('title'), sub = $<HTMLElement>('sub');
    function describe(i: number) {
      const e = cur!, dur = e.dur.match(/(\d+)m(\d+)s/);
      title.textContent = `${e.era}, ${e.day} ${MONTHS[e.month - 1]}: ${TYPES[e.type].toLowerCase()} eclipse`;
      const note = NOTES[e.year] ?? '';
      sub.textContent = `${i + 1} of ${list.length} shown`
        + (dur ? ` \u00b7 ${e.type === 'A' ? 'annularity' : 'totality'} up to ${Number(dur[1])} min ${Number(dur[2])} s, at the eclipse\u2019s greatest` : '')
        + (e.land ? '' : ' \u00b7 over the sea only') + (note ? ` \u00b7 ${note}` : '');
    }
    // the times an eclipse's shadow is over the map, on their own: the timelapse needs only these, not the full coverage
    const wins = new Map<number, { t0: number; t1: number }>();
    function windowOf(e: Ecl) {
      let w = wins.get(e.id);
      if (w) return w;
      const v = new Float32Array(P.n); let t0 = Infinity, t1 = -Infinity;
      for (let t = e.el.tmin; t <= e.el.tmax + 1e-9; t += 5 / 60) {
        coverAt(e.el, P, t, v);
        if (v.some((x) => x > 0)) { t0 = Math.min(t0, t); t1 = Math.max(t1, t); }
      }
      w = isFinite(t0) ? { t0: Math.max(e.el.tmin, t0 - 5 / 60), t1: Math.min(e.el.tmax, t1 + 5 / 60) } : { t0: e.el.tmin, t1: e.el.tmin };
      wins.set(e.id, w); return w;
    }
    /** An eclipse chosen by the timelapse: only what its passing shadow needs, not the full coverage. */
    function lite(i: number) {
      i = Math.max(0, Math.min(list.length - 1, i));
      range.value = String(i); select.value = String(i);
      cur = list[i]; win = windowOf(cur); field = cache.get(cur.id)?.best ?? null;
      describe(i);
    }
    function show(i: number) {
      stopPass();
      if (!list.length) { cur = null; field = null; title.textContent = 'No eclipse with these choices'; sub.textContent = ''; draw(); return; }
      i = Math.max(0, Math.min(list.length - 1, i));
      range.value = String(i); select.value = String(i);
      cur = list[i];
      let c = cache.get(cur.id);
      if (!c) { c = coverMax(cur.el, P); cache.set(cur.id, c); }
      field = c.best; win = { t0: c.t0, t1: c.t1 }; wins.set(cur.id, win);
      const cityMax = coverMax(cur.el, C).best;
      tags.forEach((t, k) => { t.textContent = pct(cityMax[k]); });
      describe(i);
      draw();
    }

    // the timelapse: every eclipse's shadow crossing the map in turn, in order of date, each leaving its path behind faintly
    const play = $<HTMLButtonElement>('play');
    const EACH = 1.6;                                                // seconds for each eclipse to cross
    let timer = 0;
    function stopPlay() { if (timer) { cancelAnimationFrame(timer); timer = 0; play.innerHTML = '&#9654; Play'; } }
    play.addEventListener('click', () => {
      if (timer) { stopPlay(); show(Number(range.value)); return; }
      stopPass();
      let i = Number(range.value) >= list.length - 1 ? 0 : Number(range.value), f = 0, last = performance.now();
      lite(i);
      play.innerHTML = '&#10074;&#10074; Pause';
      const step = (ts: number) => {
        f += Math.max(0, ts - last) / 1000 / EACH; last = ts;
        if (f >= 1) {
          if (i >= list.length - 1) { timer = 0; play.innerHTML = '&#9654; Play'; show(i); return; }
          lite(++i); f = 0;
        }
        passAt(Math.min(1, f));
        timer = requestAnimationFrame(step);
      };
      timer = requestAnimationFrame(step);
    });

    // watch the chosen eclipse's shadow cross the map
    const pass = $<HTMLButtonElement>('pass'), clock = $<HTMLElement>('clock');
    let raf = 0;
    function stopPass() { if (raf) { cancelAnimationFrame(raf); raf = 0; } clock.hidden = true; pass.textContent = 'Watch it pass'; }
    const now = new Float32Array(P.n), inside = new Float32Array(P.n), cnow = new Float32Array(C.n);
    // the umbra crosses the map in minutes, the whole eclipse takes hours: the pass slows down sixfold while the umbra is over the map
    const SLOW = 6, umbras = new Map<number, [number, number] | null>();
    function umbraWin(): [number, number] | null {
      if (!cur) return null;
      if (umbras.has(cur.id)) return umbras.get(cur.id)!;
      let u0 = Infinity, u1 = -Infinity;
      for (let t = win.t0; t <= win.t1 + 1e-9; t += 1 / 60) {
        coverAt(cur.el, P, t, now, inside);
        if (inside.some((v) => v > 0)) { u0 = Math.min(u0, t); u1 = Math.max(u1, t); }
      }
      const w: [number, number] | null = isFinite(u0) ? [Math.max(win.t0, u0 - 3 / 60), Math.min(win.t1, u1 + 3 / 60)] : null;
      umbras.set(cur.id, w); return w;
    }
    /** The pass's length in slowed hours, and the eclipse's time at a fraction f of it. */
    function passLength() { const u = umbraWin(); return u ? win.t1 - win.t0 + (SLOW - 1) * (u[1] - u[0]) : win.t1 - win.t0; }
    function timeAt(f: number) {
      const u = umbraWin(), p = f * passLength();
      if (!u) return win.t0 + p;
      const a = u[0] - win.t0, b = SLOW * (u[1] - u[0]);
      return p < a ? win.t0 + p : p < a + b ? u[0] + (p - a) / SLOW : u[1] + (p - a - b);
    }
    /** The chosen eclipse's shadow at a fraction f of the pass. */
    function passAt(f: number) {
      if (!cur) return;
      const el = cur.el, t = timeAt(f);
      clock.hidden = false;
      coverAt(el, P, t, now, inside);
      draw({ now, inside });
      coverAt(el, C, t, cnow);                                       // the cities, at this moment
      tags.forEach((g, k) => { g.textContent = pct(cnow[k]); });
      let ut = el.t0 + t - el.dt / 3600; ut = ((ut % 24) + 24) % 24;
      const hh = Math.floor(ut), mm = Math.floor((ut - hh) * 60);
      clock.textContent = `${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')} UT`;
    }
    pass.addEventListener('click', () => {
      if (raf) { stopPass(); draw(); return; }
      if (!cur) return;
      stopPlay();
      const secs = Math.min(16, Math.max(7, passLength() * 3)), t_start = performance.now();
      pass.textContent = 'Stop';
      const frame = (ts: number) => {
        const f = Math.min(1, (ts - t_start) / (secs * 1000));
        passAt(f);
        if (f < 1) raf = requestAnimationFrame(frame);
        else { raf = 0; pass.textContent = 'Watch it pass'; window.setTimeout(() => { if (!raf) { clock.hidden = true; show(Number(range.value)); } }, 1500); }
      };
      raf = requestAnimationFrame(frame);
    });

    range.addEventListener('input', () => { stopPlay(); show(Number(range.value)); });
    select.addEventListener('change', () => { stopPlay(); show(Number(select.value)); });
    for (const b of [...typeBoxes, landBox]) b.addEventListener('change', () => { stopPlay(); filter(cur); });
    new ResizeObserver(() => { size(); if (!raf) draw(); }).observe(stage);
    size();
    filter();
    // open on the last total over Greek land
    const last = list.findIndex((e) => e.year === 2006); if (last >= 0) show(last);
    // for the demo recorder: set any step or moment of the pass directly, frame by frame
    (window as any).__ecl = { show, lite, passAt, count: () => list.length, index: (year: number) => list.findIndex((e) => e.year === year) };
  }
</script>
