# Copy to .env on the server:  cp .env.example .env
#
# Leave SITE_ADDRESS unset (or as :80) for local HTTP testing.
# Set it to your domain in production and Caddy will obtain a TLS certificate
# automatically on first start. DNS must already point at the server, and
# ports 80 and 443 must be reachable, or issuance will fail.

SITE_ADDRESS=example.com
ACME_EMAIL=you@example.com
